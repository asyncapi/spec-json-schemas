{
  "target": "http://localhost:8000/draft-07/schemas/v2.6.0/servers/server.json",
  "tests": [
    {
      "description": "valid: 0.2.0 example #1",
      "valid": true,
      "data": {
        "url": "broker.mycompany.com:5672",
        "protocol": "googlepubsub",
        "bindings": {
          "googlepubsub": {
            "bindingVersion": "0.2.0"
          }
        }
      }
    },
    {
      "description": "invalid: 0.2.0 unknown property",
      "valid": false,
      "data": {
        "url": "broker.mycompany.com:5672",
        "protocol": "googlepubsub",
        "bindings": {
          "googlepubsub": {
            "topic": "messages",
            "bindingVersion": "0.2.0"
          }
        }
      }
    },
    {
      "description": "valid: 0.1.0 example #1",
      "valid": true,
      "data": {
        "url": "broker.mycompany.com:5672",
        "protocol": "googlepubsub",
        "bindings": {
          "googlepubsub": {
            "bindingVersion": "0.1.0"
          }
        }
      }
    },
    {
      "description": "invalid: 0.1.0 unknown property",
      "valid": false,
      "data": {
        "url": "broker.mycompany.com:5672",
        "protocol": "googlepubsub",
        "bindings": {
          "googlepubsub": {
            "topic": "messages",
            "bindingVersion": "0.1.0"
          }
        }
      }
    },
    {
      "description": "valid: example without bindingVersion (latest 0.2.0 is used)",
      "valid": true,
      "data": {
        "url": "broker.mycompany.com:5672",
        "protocol": "googlepubsub",
        "bindings": {
          "googlepubsub": {}
        }
      }
    },
    {
      "description": "valid: reference",
      "valid": true,
      "data": {
        "url": "broker.mycompany.com:5672",
        "protocol": "googlepubsub",
        "bindings": {
          "googlepubsub": {
            "$ref": "#/components/serverBindings/my-googlepubsub"
          }
        }
      }
    },
    {
      "description": "invalid: reference with extra property",
      "valid": false,
      "data": {
        "url": "broker.mycompany.com:5672",
        "protocol": "googlepubsub",
        "bindings": {
          "googlepubsub": {
            "$ref": "#/components/serverBindings/my-googlepubsub",
            "bindingVersion": "0.2.0"
          }
        }
      }
    },
    {
      "description": "invalid: unknown bindingVersion 9.9.9",
      "valid": false,
      "data": {
        "url": "broker.mycompany.com:5672",
        "protocol": "googlepubsub",
        "bindings": {
          "googlepubsub": {
            "bindingVersion": "9.9.9"
          }
        }
      }
    },
    {
      "description": "invalid: bindingVersion is a number",
      "valid": false,
      "data": {
        "url": "broker.mycompany.com:5672",
        "protocol": "googlepubsub",
        "bindings": {
          "googlepubsub": {
            "bindingVersion": 1
          }
        }
      }
    },
    {
      "description": "invalid: binding is a string",
      "valid": false,
      "data": {
        "url": "broker.mycompany.com:5672",
        "protocol": "googlepubsub",
        "bindings": {
          "googlepubsub": "googlepubsub"
        }
      }
    },
    {
      "description": "invalid: binding is null",
      "valid": false,
      "data": {
        "url": "broker.mycompany.com:5672",
        "protocol": "googlepubsub",
        "bindings": {
          "googlepubsub": null
        }
      }
    }
  ]
}
