{
  "target": "http://localhost:8000/draft-07/schemas/v2.6.0/channels/channelItem.json",
  "tests": [
    {
      "description": "valid: 0.1.0 example #1",
      "valid": true,
      "data": {
        "bindings": {
          "pulsar": {
            "bindingVersion": "0.1.0",
            "compaction": 1000,
            "deduplication": true,
            "geo-replication": [
              "us-west",
              "us-east"
            ],
            "namespace": "ns1",
            "persistence": "persistent",
            "retention": {
              "size": 1000,
              "time": 15
            },
            "ttl": 360
          }
        }
      }
    },
    {
      "description": "valid: 0.1.0 example #2",
      "valid": true,
      "data": {
        "bindings": {
          "pulsar": {
            "bindingVersion": "0.1.0",
            "compaction": 1000,
            "deduplication": true,
            "geo-replication": [
              "us-west",
              "us-east"
            ],
            "namespace": "ns1",
            "persistence": "non-persistent",
            "retention": {
              "size": 1000,
              "time": 15
            },
            "ttl": 360
          }
        }
      }
    },
    {
      "description": "invalid: 0.1.0 missing namespace",
      "valid": false,
      "data": {
        "bindings": {
          "pulsar": {
            "persistence": "persistent",
            "bindingVersion": "0.1.0"
          }
        }
      }
    },
    {
      "description": "valid: example without bindingVersion (latest 0.1.0 is used)",
      "valid": true,
      "data": {
        "bindings": {
          "pulsar": {
            "compaction": 1000,
            "deduplication": true,
            "geo-replication": [
              "us-west",
              "us-east"
            ],
            "namespace": "ns1",
            "persistence": "persistent",
            "retention": {
              "size": 1000,
              "time": 15
            },
            "ttl": 360
          }
        }
      }
    },
    {
      "description": "valid: reference",
      "valid": true,
      "data": {
        "bindings": {
          "pulsar": {
            "$ref": "#/components/channelBindings/my-pulsar"
          }
        }
      }
    },
    {
      "description": "invalid: reference with extra property",
      "valid": false,
      "data": {
        "bindings": {
          "pulsar": {
            "$ref": "#/components/channelBindings/my-pulsar",
            "bindingVersion": "0.1.0"
          }
        }
      }
    },
    {
      "description": "invalid: unknown bindingVersion 9.9.9",
      "valid": false,
      "data": {
        "bindings": {
          "pulsar": {
            "bindingVersion": "9.9.9"
          }
        }
      }
    },
    {
      "description": "invalid: bindingVersion is a number",
      "valid": false,
      "data": {
        "bindings": {
          "pulsar": {
            "bindingVersion": 1
          }
        }
      }
    },
    {
      "description": "invalid: binding is a string",
      "valid": false,
      "data": {
        "bindings": {
          "pulsar": "pulsar"
        }
      }
    },
    {
      "description": "invalid: binding is null",
      "valid": false,
      "data": {
        "bindings": {
          "pulsar": null
        }
      }
    },
    {
      "description": "valid: folder name apache-pulsar is accepted unvalidated (open map, the key is pulsar)",
      "valid": true,
      "data": {
        "bindings": {
          "apache-pulsar": {
            "bindingVersion": "9.9.9"
          }
        }
      }
    }
  ]
}
