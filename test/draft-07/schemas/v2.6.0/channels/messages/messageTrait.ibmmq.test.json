            "bindingVersion": "0.1.0"
          }
        }
      }
    },
    {
      "description": "valid: 0.1.0 example #3",
      "valid": true,
      "data": {
        "name": "UserSignedUp",
        "bindings": {
          "ibmmq": {
            "type": "binary",
