      "data": {
        "name": "UserSignedUp",
        "bindings": {
          "ibmmq": {
            "bindingVersion": "0.1.0"
          }
        }
      }
    },
    {
      "description": "valid: example without bindingVersion (latest 0.1.0 is used)",
      "valid": true,
      "data": {
        "name": "UserSignedUp",
        "bindings": {
          "ibmmq": {
            "type": "string",
            "description": "String message",
            "expiry": 10
          }
        }
      }
    },
    {
      "description": "valid: reference",
      "valid": true,
      "data": {
        "name": "UserSignedUp",
        "bindings": {
          "ibmmq": {
            "$ref": "#/components/messageBindings/my-ibmmq"
          }
        }
      }
    },
    {
      "description": "invalid: reference with extra property",
      "valid": false,
      "data": {
        "name": "UserSignedUp",
        "bindings": {
          "ibmmq": {
            "$ref": "#/components/messageBindings/my-ibmmq",
            "bindingVersion": "0.1.0"
          }
        }
      }
    },
    {
      "description": "invalid: unknown bindingVersion 9.9.9",
      "valid": false,
      "data": {
        "name": "UserSignedUp",
        "bindings": {
          "ibmmq": {
            "bindingVersion": "9.9.9"
          }
        }
      }
    },
    {
      "description": "invalid: bindingVersion is a number",
      "valid": false,
      "data": {
        "name": "UserSignedUp",
        "bindings": {
          "ibmmq": {
            "bindingVersion": 1
          }
        }
      }
    },
    {
      "description": "invalid: binding is a string",
      "valid": false,
      "data": {
        "name": "UserSignedUp",
        "bindings": {
          "ibmmq": "ibmmq"
        }
      }
    },
    {
      "description": "invalid: binding is null",
      "valid": false,
      "data": {
        "name": "UserSignedUp",
        "bindings": {
          "ibmmq": null
        }
      }
