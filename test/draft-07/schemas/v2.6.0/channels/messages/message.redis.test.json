{
  "target": "http://localhost:8000/draft-07/schemas/v2.6.0/channels/messages/message.json",
  "tests": [
    {
      "description": "valid: 0.1.0 example #1",
      "valid": true,
      "data": {
        "payload": {
          "type": "string"
        },
        "bindings": {
          "redis": {
            "bindingVersion": "0.1.0"
          }
        }
      }
    },
    {
      "description": "invalid: 0.1.0 unknown property",
      "valid": false,
      "data": {
        "payload": {
          "type": "string"
        },
        "bindings": {
          "redis": {
            "stream": "orders",
            "bindingVersion": "0.1.0"
          }
        }
      }
    },
    {
      "description": "valid: example without bindingVersion (latest 0.1.0 is used)",
      "valid": true,
      "data": {
        "payload": {
          "type": "string"
        },
        "bindings": {
          "redis": {}
        }
      }
    },
    {
      "description": "valid: reference",
      "valid": true,
      "data": {
        "payload": {
          "type": "string"
        },
        "bindings": {
          "redis": {
            "$ref": "#/components/messageBindings/my-redis"
          }
        }
      }
    },
    {
      "description": "invalid: reference with extra property",
      "valid": false,
      "data": {
        "payload": {
          "type": "string"
        },
        "bindings": {
          "redis": {
            "$ref": "#/components/messageBindings/my-redis",
            "bindingVersion": "0.1.0"
          }
        }
      }
    },
    {
      "description": "invalid: unknown bindingVersion 9.9.9",
      "valid": false,
      "data": {
        "payload": {
          "type": "string"
        },
        "bindings": {
          "redis": {
            "bindingVersion": "9.9.9"
          }
        }
      }
    },
    {
      "description": "invalid: bindingVersion is a number",
      "valid": false,
      "data": {
        "payload": {
          "type": "string"
        },
        "bindings": {
          "redis": {
            "bindingVersion": 1
          }
        }
      }
    },
    {
      "description": "invalid: binding is a string",
      "valid": false,
      "data": {
        "payload": {
          "type": "string"
        },
        "bindings": {
          "redis": "redis"
        }
      }
    },
    {
      "description": "invalid: binding is null",
      "valid": false,
      "data": {
        "payload": {
          "type": "string"
        },
        "bindings": {
          "redis": null
        }
      }
    }
  ]
}
