{
  "target": "http://localhost:8000/draft-07/schemas/v2.0.0/asyncapi.json",
  "tests": [
    {
      "description": "valid: example #1",
      "valid": true,
      "data": {
        "asyncapi": "2.0.0",
        "info": {
          "title": "MQTT 5.0 example",
          "version": "1.0.0"
        },
        "channels": {
          "user/{userId}/sendMessage": {
            "description": "This channel is used to exchange messages about users signing up",
            "subscribe": {
              "operationId": "sendMessage",
              "summary": "Send message",
              "description": "Send message to remote server",
              "message": {
                "$ref": "#/components/schemas/sendMessage"
              }
            },
            "parameters": {
              "userId": {
                "description": "Id of the user",
                "schema": {
                  "type": "string"
                },
                "location": "$message.payload#/user/id"
              }
            }
          }
        }
      }
    },
    {
      "description": "valid: minimal (asyncapi, info and channels)",
      "valid": true,
      "data": {
        "asyncapi": "2.0.0",
        "info": {
          "title": "Account Service",
          "version": "1.0.0"
        },
        "channels": {}
      }
    },
    {
