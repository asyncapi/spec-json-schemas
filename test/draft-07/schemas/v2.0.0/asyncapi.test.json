      "data": {
        "asyncapi": "2.0.0",
        "info": {
          "title": "Account Service",
          "version": "1.0.0"
        },
        "channels": {
          "users": {
            "publish": {
              "operationId": "sendUser",
              "message": {
                "payload": {
                  "type": "string"
                }
              }
            }
          }
        },
        "servers": {
          "prod": {
            "url": "broker.mycompany.com:5672",
            "protocol": "amqp"
          }
        },
        "components": {
          "messages": {
            "a": {
              "payload": {
                "type": "string"
              }
            }
          }
        }
      }
    },
