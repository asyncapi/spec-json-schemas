{
  "target": "http://localhost:8000/draft-07/schemas/v2.0.0/channels/channelItem.json",
  "tests": [
    {
      "description": "valid: 0.2.0 example #1",
      "valid": true,
      "data": {
        "bindings": {
          "sns": {
            "name": "my-sns-topic",
            "bindingVersion": "0.2.0"
          }
        }
      }
    },
    {
      "description": "valid: 0.2.0 example #2",
      "valid": true,
      "data": {
        "bindings": {
          "sns": {
            "name": "my-sns-topic",
            "policy": {
              "statements": [
                {
                  "action": "SNS:Publish",
                  "effect": "Allow",
                  "principal": "*",
                  "condition": {
                    "StringEquals": {
                      "aws:SourceAccount": "123456789012"
                    }
                  }
                }
              ]
            },
            "bindingVersion": "0.2.0"
          }
        }
      }
    },
    {
      "description": "invalid: 0.2.0 missing name",
      "valid": false,
      "data": {
        "bindings": {
          "sns": {
            "bindingVersion": "0.2.0"
          }
        }
      }
    },
    {
      "description": "valid: 0.1.0 example #1",
      "valid": true,
      "data": {
        "bindings": {
          "sns": {
            "name": "my-sns-topic",
            "bindingVersion": "0.1.0"
          }
        }
      }
    },
    {
      "description": "valid: 0.1.0 example #2",
      "valid": true,
      "data": {
        "bindings": {
          "sns": {
            "name": "my-sns-topic",
            "policy": {
              "statements": [
                {
                  "action": "SNS:Publish",
                  "effect": "Allow",
                  "principal": "*"
                }
              ]
            },
            "bindingVersion": "0.1.0"
          }
        }
      }
    },
    {
      "description": "valid: 0.1.0 example #3",
      "valid": true,
      "data": {
        "bindings": {
          "sns": {
            "name": "my-sns-topic",
            "policy": {
              "statements": [
                {
                  "action": [
                    "SNS:Publish"
                  ],
                  "effect": "Deny",
                  "principal": [
                    "*"
                  ]
                }
              ]
            },
            "tags": {
              "version": "3.31.0",
              "env": "prod"
            },
            "bindingVersion": "0.1.0"
          }
        }
      }
    },
    {
      "description": "valid: 0.1.0 example #4",
      "valid": true,
      "data": {
        "bindings": {
          "sns": {
            "name": "my-sns-topic",
            "ordering": {
              "type": "standard",
              "contentBasedDeduplication": true
            },
            "tags": {
              "version": "3.31.0",
              "env": "prod"
            },
            "bindingVersion": "0.1.0"
          }
        }
      }
    },
    {
      "description": "valid: 0.1.0 example #5",
      "valid": true,
      "data": {
        "bindings": {
          "sns": {
            "name": "my-sns-topic",
            "ordering": {
              "type": "FIFO",
              "contentBasedDeduplication": false
            },
            "tags": {
              "version": "3.31.0",
              "env": "prod"
            },
            "bindingVersion": "0.1.0"
          }
        }
      }
    },
    {
      "description": "invalid: 0.1.0 missing name",
      "valid": false,
      "data": {
        "bindings": {
          "sns": {
            "bindingVersion": "0.1.0"
          }
        }
      }
