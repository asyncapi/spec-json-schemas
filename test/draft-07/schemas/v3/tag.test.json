{
  "target": "http://localhost:8000/draft-07/schemas/v3/tag.json",
  "tests": [
    {
      "description": "valid: example #1",
      "valid": true,
      "data": {
        "name": "city"
      }
    },
    {
      "description": "valid: example #2",
      "valid": true,
      "data": {
        "name": "city",
        "description": "City forecast for e.g. Yerevan"
      }
    },
    {
      "description": "valid: example #3",
      "valid": true,
      "data": {
        "name": "city",
        "externalDocs": {
          "$ref": "https://api.weather-forecast.am/docs#tags-district"
        }
      }
    },
    {
      "description": "valid: example #4",
      "valid": true,
      "data": {
        "name": "city",
        "externalDocs": {
          "url": "https://api.weather-forecast.am/docs",
          "description": "Required information to integrate with API"
        }
      }
    },
    {
      "description": "valid: empty name is accepted (no minLength)",
      "valid": true,
      "data": {
        "name": ""
      }
    },
    {
      "description": "valid: with x- extension",
      "valid": true,
      "data": {
        "name": "city",
        "x-order": 1
      }
    },
    {
      "description": "invalid: missing name",
      "valid": false,
      "data": {
        "description": "City forecast for e.g. Yerevan"
      }
    },
    {
      "description": "invalid: empty object",
      "valid": false,
      "data": {}
    },
    {
      "description": "invalid: name is not a string",
      "valid": false,
      "data": {
        "name": 1
      }
    },
    {
      "description": "invalid: description is not a string",
      "valid": false,
      "data": {
        "name": "city",
        "description": [ "City forecast" ]
      }
    },
    {
      "description": "invalid: externalDocs without url",
      "valid": false,
      "data": {
        "name": "city",
        "externalDocs": {
          "description": "docs"
        }
      }
    },
    {
      "description": "invalid: externalDocs with $ref and url",
      "valid": false,
      "data": {
        "name": "city",
        "externalDocs": {
          "$ref": "#/components/externalDocs/docs",
          "url": "https://api.weather-forecast.am/docs"
        }
      }
    },
    {
      "description": "invalid: externalDocs is a string",
      "valid": false,
      "data": {
        "name": "city",
        "externalDocs": "https://api.weather-forecast.am/docs"
      }
    },
    {
      "description": "invalid: tag itself as a reference ($ref is an unknown property)",
      "valid": false,
      "data": {
        "$ref": "#/components/tags/city"
      }
    },
    {
      "description": "invalid: unknown property",
      "valid": false,
      "data": {
        "name": "city",
        "foo": "bar"
      }
    },
    {
      "description": "invalid: not an object",
      "valid": false,
      "data": "city"
    }
  ]
}
