{
  "target": "http://localhost:8000/draft-07/schemas/v3/channels/channelAddressParameters.json",
  "tests": [
    {
      "description": "valid: example #1",
      "valid": true,
      "data": {
        "timezone": {
          "$ref": "#/parameters/time-zone"
        }
      }
    },
    {
      "description": "valid: example #2",
      "valid": true,
      "data": {
        "user-id": {
          "description": "Id of the user",
          "default": "0e822ca6-5311-4d4c-b409-993a1820e689",
          "enum": [
            "0e822ca6-5311-4d4c-b409-993a1820e689",
            "381f5ddc-75c6-4c21-9ec1-3919ed345be9",
            "70559d88-31a5-4ef2-8c34-7fbd04057ed5",
            "c6dc0047-a90d-4efa-95e3-a272282934e0"
          ],
          "location": "$message.payload#/user/id"
        }
      }
    },
    {
      "description": "valid: example #3",
      "valid": true,
      "data": {
        "accessToken": {
          "description": "User AccessToken",
          "examples": [
            "Bearer eyJhbGciOiJIUzI1Ni..."
          ],
          "location": "$message.header#/authorization"
        }
      }
    },
    {
      "description": "valid: empty map",
      "valid": true,
      "data": {}
    },
    {
      "description": "valid: mixed reference and parameter",
      "valid": true,
      "data": {
        "userId": {
          "$ref": "#/components/parameters/userId"
        },
        "region": {
          "enum": [
            "eu",
            "us"
          ]
        }
      }
    },
    {
      "description": "valid: any parameter name is accepted (no key pattern)",
      "valid": true,
      "data": {
        "{userId}": {},
        "user id": {}
      }
    },
    {
      "description": "invalid: reference with sibling description",
      "valid": false,
      "data": {
        "userId": {
          "$ref": "#/components/parameters/userId",
          "description": "Id"
        }
      }
    },
    {
      "description": "invalid: reference is not a string",
      "valid": false,
      "data": {
        "userId": {
          "$ref": 1
        }
      }
    },
    {
      "description": "invalid: parameter with invalid location",
      "valid": false,
      "data": {
        "userId": {
          "location": "$message.body#/id"
        }
      }
    },
    {
      "description": "invalid: parameter with unknown property",
      "valid": false,
      "data": {
        "userId": {
          "schema": {
            "type": "string"
          }
        }
      }
    },
    {
      "description": "invalid: not an object",
      "valid": false,
      "data": [
        {
          "userId": {}
        }
      ]
    }
  ]
}
