{
  "target": "http://localhost:8000/draft-07/schemas/v3/operations/operationReplyAddressOrReference.json",
  "tests": [
    {
      "description": "valid: example #1",
      "valid": true,
      "data": {
        "location": "$message.header#/X-REPLY-TO"
      }
    },
    {
      "description": "valid: example #2",
      "valid": true,
      "data": {
        "$ref": "#/replies/send-notification-reply-address"
      }
    },
    {
      "description": "valid: reference to components",
      "valid": true,
      "data": {
        "$ref": "#/components/replyAddresses/reply"
      }
    },
    {
      "description": "invalid: reference with sibling location",
      "valid": false,
      "data": {
        "location": "$message.header#/replyTo",
        "$ref": "#/components/replyAddresses/reply"
      }
    },
    {
      "description": "invalid: reference is not a string",
      "valid": false,
      "data": {
        "$ref": 1
      }
    },
    {
      "description": "invalid: address without location",
      "valid": false,
      "data": {
        "description": "Reply here"
      }
    },
    {
      "description": "invalid: empty object",
      "valid": false,
      "data": {}
    },
    {
      "description": "invalid: not an object",
      "valid": false,
      "data": "$message.header#/replyTo"
    }
  ]
}
