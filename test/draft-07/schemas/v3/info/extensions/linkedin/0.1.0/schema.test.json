    {
      "description": "invalid: country subdomain",
      "valid": false,
      "data": "https://am.linkedin.com/in/asyncapi"
    },
    {
      "description": "invalid: missing scheme",
      "valid": false,
      "data": "www.linkedin.com/company/asyncapi/"
    },
    {
      "description": "invalid: other scheme",
      "valid": false,
      "data": "ftp://www.linkedin.com/company/asyncapi/"
    },
    {
      "description": "invalid: upper case scheme",
      "valid": false,
      "data": "HTTPS://www.linkedin.com/company/asyncapi/"
    },
    {
      "description": "invalid: other site",
      "valid": false,
      "data": "https://x.com/AsyncAPISpec"
    },
    {
      "description": "invalid: username only",
      "valid": false,
      "data": "asyncapi"
    },
    {
      "description": "invalid: empty string",
      "valid": false,
      "data": ""
    },
    {
      "description": "invalid: not a string",
      "valid": false,
      "data": 1
    }
  ]
}
