{
  "target": "http://localhost:8000/draft-07/schemas/v3/info/extensions/linkedin/0.1.0/schema.json",
  "tests": [
    {
      "description": "valid: example #1",
      "valid": true,
      "data": "https://www.linkedin.com/company/asyncapi/"
    },
    {
      "description": "valid: example #2",
      "valid": true,
      "data": "https://www.linkedin.com/in/sambhavgupta0705/"
    },
    {
      "description": "valid: http without www",
      "valid": true,
      "data": "http://linkedin.com/company/asyncapi"
    },
    {
      "description": "valid: bare domain",
      "valid": true,
      "data": "https://linkedin.com"
    },
    {
      "description": "valid: other domain starting with linkedin.com is accepted (pattern is not anchored to the host)",
      "valid": true,
      "data": "https://linkedin.com.evil.example/in/asyncapi"
