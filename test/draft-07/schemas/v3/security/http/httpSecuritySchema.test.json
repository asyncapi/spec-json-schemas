{
  "target": "http://localhost:8000/draft-07/schemas/v3/security/http/httpSecuritySchema.json",
  "tests": [
    {
      "description": "valid: example #1",
      "valid": true,
      "data": {
        "type": "httpApiKey",
        "description": "HTTP - API Key",
        "name": "api_key",
        "in": "header"
      }
    },
    {
      "description": "valid: example #2",
      "valid": true,
      "data": {
        "type": "http",
        "description": "HTTP - Basic",
        "scheme": "basic"
      }
    },
    {
      "description": "valid: example #3",
      "valid": true,
      "data": {
        "type": "http",
        "description": "HTTP - Bearer",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    {
      "description": "valid: non-bearer scheme",
      "valid": true,
      "data": {
        "type": "http",
        "scheme": "digest"
      }
    },
    {
      "description": "valid: bearer without bearerFormat",
      "valid": true,
      "data": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    {
      "description": "valid: httpApiKey in cookie",
      "valid": true,
      "data": {
        "type": "httpApiKey",
        "name": "api_key",
        "in": "cookie"
      }
    },
    {
      "description": "invalid: basic with bearerFormat",
      "valid": false,
      "data": {
        "type": "http",
        "scheme": "basic",
        "bearerFormat": "JWT"
      }
    },
    {
      "description": "invalid: http without scheme",
      "valid": false,
      "data": {
        "type": "http"
      }
    },
    {
      "description": "invalid: httpApiKey without name",
      "valid": false,
      "data": {
        "type": "httpApiKey",
        "in": "header"
      }
    },
    {
      "description": "invalid: httpApiKey in user",
      "valid": false,
      "data": {
        "type": "httpApiKey",
        "name": "api_key",
        "in": "user"
      }
    },
    {
      "description": "invalid: other security type",
      "valid": false,
      "data": {
        "type": "X509"
      }
    },
    {
      "description": "invalid: empty object",
      "valid": false,
      "data": {}
    },
    {
      "description": "invalid: not an object",
      "valid": false,
      "data": "http"
    }
  ]
}
