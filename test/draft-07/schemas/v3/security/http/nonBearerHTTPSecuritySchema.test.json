{
  "target": "http://localhost:8000/draft-07/schemas/v3/security/http/nonBearerHTTPSecuritySchema.json",
  "tests": [
    {
      "description": "valid: example #1",
      "valid": true,
      "data": {
        "type": "http",
        "description": "HTTP - Basic",
        "scheme": "basic"
      }
    },
    {
      "description": "valid: minimal",
      "valid": true,
      "data": {
        "type": "http",
        "scheme": "basic"
      }
    },
    {
      "description": "valid: with description",
      "valid": true,
      "data": {
        "type": "http",
        "scheme": "basic",
        "description": "Production auth"
      }
    },
    {
      "description": "valid: with x- extension",
      "valid": true,
      "data": {
        "type": "http",
        "scheme": "basic",
        "x-vault-path": "secret/broker"
      }
    },
    {
      "description": "valid: digest scheme",
      "valid": true,
      "data": {
        "type": "http",
        "scheme": "digest"
      }
    },
    {
      "description": "valid: Bearer in other case is accepted as non-bearer (scheme is case-insensitive in RFC 7235)",
      "valid": true,
      "data": {
        "type": "http",
        "scheme": "Bearer"
      }
    },
    {
      "description": "valid: any scheme string is accepted (no IANA registry check)",
      "valid": true,
      "data": {
        "type": "http",
        "scheme": "my-scheme"
      }
    },
    {
      "description": "invalid: missing type",
      "valid": false,
      "data": {
        "scheme": "basic"
      }
    },
    {
      "description": "invalid: missing scheme",
      "valid": false,
      "data": {
        "type": "http"
      }
    },
    {
      "description": "invalid: wrong type",
      "valid": false,
      "data": {
        "type": "unknownType",
        "scheme": "basic"
      }
    },
    {
      "description": "invalid: type in other case",
      "valid": false,
      "data": {
        "type": "HTTP",
        "scheme": "basic"
      }
    },
    {
      "description": "invalid: description is not a string",
      "valid": false,
      "data": {
        "type": "http",
        "scheme": "basic",
        "description": 1
      }
    },
    {
      "description": "invalid: $ref is not allowed",
      "valid": false,
      "data": {
        "type": "http",
        "scheme": "basic",
        "$ref": "#/components/securitySchemes/auth"
      }
    },
    {
      "description": "invalid: unknown property",
      "valid": false,
      "data": {
        "type": "http",
        "scheme": "basic",
        "flows": {}
      }
    },
    {
      "description": "invalid: scheme bearer",
      "valid": false,
      "data": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    {
      "description": "invalid: bearerFormat is not allowed",
      "valid": false,
      "data": {
        "type": "http",
        "scheme": "basic",
        "bearerFormat": "JWT"
      }
    },
    {
      "description": "invalid: scheme is not a string",
      "valid": false,
      "data": {
        "type": "http",
        "scheme": 1
      }
    },
    {
      "description": "invalid: not an object",
      "valid": false,
      "data": "http"
    }
  ]
}
