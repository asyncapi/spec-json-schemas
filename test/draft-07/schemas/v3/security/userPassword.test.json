{
  "target": "http://localhost:8000/draft-07/schemas/v3/security/userPassword.json",
  "tests": [
    {
      "description": "valid: example #1",
      "valid": true,
      "data": {
        "type": "userPassword"
      }
    },
    {
      "description": "valid: example #2",
      "valid": true,
      "data": {
        "type": "userPassword",
        "description": "Security process that verifies a user's identity using a unique username and a secret password, involving registration, secure storage via hashing, and login verification"
      }
    },
    {
      "description": "valid: minimal",
      "valid": true,
      "data": {
        "type": "userPassword"
      }
    },
    {
      "description": "valid: with description",
      "valid": true,
      "data": {
        "type": "userPassword",
        "description": "Production auth"
      }
    },
    {
      "description": "valid: with x- extension",
      "valid": true,
      "data": {
        "type": "userPassword",
        "x-vault-path": "secret/broker"
      }
    },
    {
      "description": "invalid: missing type",
      "valid": false,
      "data": {}
    },
    {
      "description": "invalid: wrong type",
      "valid": false,
      "data": {
        "type": "unknownType"
      }
    },
    {
      "description": "invalid: type in other case",
      "valid": false,
      "data": {
        "type": "USERpASSWORD"
      }
    },
    {
      "description": "invalid: description is not a string",
      "valid": false,
      "data": {
        "type": "userPassword",
        "description": 1
      }
    },
    {
      "description": "invalid: $ref is not allowed",
      "valid": false,
      "data": {
        "type": "userPassword",
        "$ref": "#/components/securitySchemes/auth"
      }
    },
    {
      "description": "invalid: unknown property",
      "valid": false,
      "data": {
        "type": "userPassword",
        "scheme": "basic"
      }
    },
    {
      "description": "invalid: not an object",
      "valid": false,
      "data": "userPassword"
    }
  ]
}
