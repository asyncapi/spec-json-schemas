    {
      "description": "valid: false schema",
      "valid": true,
      "data": false
    },
    {
      "description": "valid: nested boolean schemas",
      "valid": true,
      "data": {
        "properties": {
          "a": true,
          "b": false
        },
        "items": true
      }
    },
    {
      "description": "valid: discriminator",
      "valid": true,
      "data": {
        "type": "object",
        "discriminator": "petType"
      }
    },
    {
      "description": "valid: externalDocs",
      "valid": true,
      "data": {
        "externalDocs": {
          "url": "https://docs.lo"
        }
      }
    },
    {
      "description": "valid: externalDocs reference",
      "valid": true,
      "data": {
        "externalDocs": {
          "$ref": "#/components/externalDocs/a"
        }
      }
    },
    {
      "description": "valid: deprecated",
      "valid": true,
      "data": {
        "deprecated": true
      }
    },
    {
      "description": "valid: reference",
      "valid": true,
      "data": {
        "$ref": "#/components/schemas/user"
      }
    },
    {
      "description": "valid: tuple items",
      "valid": true,
      "data": {
        "items": [
          {
            "type": "string"
          },
          {
            "type": "integer"
          }
        ]
      }
    },
    {
      "description": "valid: if/then/else",
      "valid": true,
      "data": {
        "if": {
          "required": [
            "a"
          ]
        },
        "then": {
          "required": [
            "b"
          ]
        },
        "else": {
          "required": [
            "c"
          ]
        }
      }
    },
    {
      "description": "valid: unknown keyword is accepted",
      "valid": true,
      "data": {
        "nullable": true
      }
    },
    {
      "description": "invalid: unknown type",
      "valid": false,
      "data": {
        "type": "map"
      }
    },
    {
