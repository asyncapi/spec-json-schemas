      "valid": false,
      "data": {
        "type": [
          "string",
          "map"
        ]
      }
    },
    {
      "description": "invalid: discriminator is an object (OpenAPI style)",
      "valid": false,
      "data": {
        "discriminator": {
          "propertyName": "petType"
        }
      }
    },
    {
      "description": "invalid: externalDocs without url",
      "valid": false,
      "data": {
        "externalDocs": {
          "description": "d"
        }
      }
    },
    {
      "description": "invalid: deprecated is a string",
