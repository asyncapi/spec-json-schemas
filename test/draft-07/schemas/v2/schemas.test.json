{
  "target": "http://localhost:8000/draft-07/schemas/v2/schemas.json",
  "tests": [
    {
      "description": "valid: example #1",
      "valid": true,
      "data": {
        "a": {},
        "b": {
          "title": "Example Object",
          "type": "object",
          "properties": {
            "string": {
              "type": "string",
              "default": ""
            },
            "boolean": {
              "type": "boolean"
            }
          }
        },
        "c": {
          "title": "Example Object",
          "discriminator": "objectType"
        }
      }
    },
    {
      "description": "valid: empty map",
      "valid": true,
      "data": {}
    },
    {
      "description": "valid: any key is accepted",
      "valid": true,
      "data": {
        "a b": {}
      }
    },
    {
      "description": "invalid: boolean schema",
      "valid": false,
      "data": {
        "a": true
      }
    },
    {
      "description": "invalid: invalid schema",
      "valid": false,
      "data": {
        "a": {
          "type": "map"
        }
      }
    },
    {
      "description": "invalid: schema is a string",
      "valid": false,
      "data": {
        "a": "string"
      }
    },
    {
      "description": "invalid: not an object",
      "valid": false,
      "data": [
        {}
      ]
    }
  ]
}
