{
  "target": "http://localhost:8000/draft-07/schemas/v2/info/contact.json",
  "tests": [
    {
      "description": "valid: example #1",
      "valid": true,
      "data": {
        "name": "Weather Forecast"
      }
    },
    {
      "description": "valid: example #2",
      "valid": true,
      "data": {
        "email": "feedback@weather-forecast.am"
      }
    },
    {
      "description": "valid: example #3",
      "valid": true,
      "data": {
        "url": "https://weather-forecast.am"
      }
    },
    {
      "description": "valid: example #4",
      "valid": true,
      "data": {
        "name": "Weather Forecast",
        "email": "feedback@weather-forecast.am",
        "url": "https://weather-forecast.am"
      }
    },
    {
      "description": "valid: empty object (no required fields)",
      "valid": true,
      "data": {}
    },
    {
      "description": "valid: with x- extension",
      "valid": true,
      "data": {
        "name": "a",
        "x-phone": "1"
      }
    },
    {
      "description": "invalid: email without @",
      "valid": false,
      "data": {
        "email": "feedback.weather-forecast.am"
      }
    },
    {
      "description": "invalid: email is not a string",
      "valid": false,
      "data": {
        "email": 1
      }
    },
    {
      "description": "invalid: url is relative",
      "valid": false,
      "data": {
        "url": "/contact"
      }
    },
    {
      "description": "invalid: name is not a string",
      "valid": false,
      "data": {
        "name": [
          1
        ]
      }
    },
    {
      "description": "invalid: unknown property",
      "valid": false,
      "data": {
        "phone": "1"
      }
    },
    {
      "description": "invalid: not an object",
      "valid": false,
      "data": "a"
    }
  ]
}
