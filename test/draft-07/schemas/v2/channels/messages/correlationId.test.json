{
  "target": "http://localhost:8000/draft-07/schemas/v2/channels/messages/correlationId.json",
  "tests": [
    {
      "description": "valid: example #1",
      "valid": true,
      "data": {
        "description": "Incoming message correlation-id",
        "location": "$message.payload#/correlation-id"
      }
    },
    {
      "description": "valid: example #2",
      "valid": true,
      "data": {
        "description": "Incoming message correlation-id",
        "location": "$message.header#/correlation-id",
        "x-format": "uuid"
      }
    },
    {
      "description": "valid: payload root",
      "valid": true,
      "data": {
        "location": "$message.payload#"
      }
    },
    {
      "description": "valid: trailing text after # is accepted (pattern is not anchored at the end)",
      "valid": true,
      "data": {
        "location": "$message.payload#id"
      }
    },
    {
      "description": "valid: with x- extension",
      "valid": true,
      "data": {
        "location": "$message.header#/correlation-id",
        "x-format": "uuid"
      }
    },
    {
      "description": "invalid: missing location",
      "valid": false,
      "data": {
        "description": "id"
      }
    },
    {
      "description": "invalid: location without #",
      "valid": false,
      "data": {
        "location": "$message.header/id"
      }
    },
    {
      "description": "invalid: location with unknown source",
      "valid": false,
      "data": {
        "location": "$message.body#/id"
      }
    },
    {
      "description": "invalid: location is not a string",
      "valid": false,
      "data": {
        "location": 1
      }
    },
    {
      "description": "invalid: $ref is not allowed",
      "valid": false,
      "data": {
        "location": "$message.header#/correlation-id",
        "$ref": "#/components/correlationIds/a"
      }
    },
    {
      "description": "invalid: unknown property",
      "valid": false,
      "data": {
        "location": "$message.header#/correlation-id",
        "format": "uuid"
      }
    },
    {
      "description": "invalid: not an object",
      "valid": false,
      "data": "$message.header#/id"
    }
  ]
}
