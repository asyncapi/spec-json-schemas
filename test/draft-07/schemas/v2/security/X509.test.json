{
  "target": "http://localhost:8000/draft-07/schemas/v2/security/X509.json",
  "tests": [
    {
      "description": "valid: example #1",
      "valid": true,
      "data": {
        "type": "X509"
      }
    },
    {
      "description": "valid: example #2",
      "valid": true,
      "data": {
        "type": "X509",
        "description": "Structured digital document format defined by RFC 5280 that securely binds a public key to an entity's identity using a trusted digital signature"
      }
    },
    {
      "description": "valid: minimal",
      "valid": true,
      "data": {
        "type": "X509"
      }
    },
    {
      "description": "valid: with description",
      "valid": true,
      "data": {
        "type": "X509",
        "description": "Production auth"
      }
    },
    {
      "description": "valid: with x- extension",
      "valid": true,
      "data": {
        "type": "X509",
        "x-vault-path": "secret/broker"
      }
    },
    {
      "description": "invalid: missing type",
      "valid": false,
      "data": {}
    },
    {
      "description": "invalid: wrong type",
      "valid": false,
      "data": {
        "type": "unknownType"
      }
    },
    {
      "description": "invalid: type in other case",
      "valid": false,
      "data": {
        "type": "x509"
      }
    },
    {
      "description": "invalid: description is not a string",
      "valid": false,
      "data": {
        "type": "X509",
        "description": 1
      }
    },
    {
      "description": "invalid: $ref is not allowed",
      "valid": false,
      "data": {
        "type": "X509",
        "$ref": "#/components/securitySchemes/auth"
      }
    },
    {
      "description": "invalid: unknown property",
      "valid": false,
      "data": {
        "type": "X509",
        "scheme": "basic"
      }
    },
    {
      "description": "invalid: not an object",
      "valid": false,
      "data": "X509"
    }
  ]
}
