{
  "target": "http://localhost:8000/draft-07/schemas/v2/security/openIdConnect.json",
  "tests": [
    {
      "description": "valid: example #1",
      "valid": true,
      "data": {
        "type": "openIdConnect",
        "openIdConnectUrl": "https://server.com/.well-known/openid-configuration"
      }
    },
    {
      "description": "valid: example #2",
      "valid": true,
      "data": {
        "type": "openIdConnect",
        "description": "Simple identity authentication layer built on top of the OAuth 2.0 protocol, consisting of the OpenID Provider, ID Token, and Relying Party",
        "openIdConnectUrl": "https://server.com/.well-known/openid-configuration"
      }
    },
    {
      "description": "valid: minimal",
      "valid": true,
      "data": {
        "type": "openIdConnect",
        "openIdConnectUrl": "https://server.com/.well-known/openid-configuration"
      }
    },
    {
      "description": "valid: with description",
      "valid": true,
      "data": {
        "type": "openIdConnect",
        "openIdConnectUrl": "https://server.com/.well-known/openid-configuration",
        "description": "Production auth"
      }
    },
    {
      "description": "valid: with x- extension",
      "valid": true,
      "data": {
        "type": "openIdConnect",
        "openIdConnectUrl": "https://server.com/.well-known/openid-configuration",
        "x-vault-path": "secret/broker"
      }
    },
    {
      "description": "invalid: scopes is not allowed (added in v3)",
      "valid": false,
      "data": {
        "type": "openIdConnect",
        "openIdConnectUrl": "https://server.com/.well-known/openid-configuration",
        "scopes": []
      }
    },
    {
      "description": "valid: openIdConnectUrl without .well-known path is accepted",
      "valid": true,
      "data": {
        "type": "openIdConnect",
        "openIdConnectUrl": "https://server.com/oidc"
      }
    },
    {
      "description": "invalid: missing type",
      "valid": false,
      "data": {
        "openIdConnectUrl": "https://server.com/.well-known/openid-configuration"
      }
    },
    {
      "description": "invalid: missing openIdConnectUrl",
      "valid": false,
      "data": {
        "type": "openIdConnect"
      }
    },
    {
      "description": "invalid: wrong type",
      "valid": false,
      "data": {
        "type": "unknownType",
        "openIdConnectUrl": "https://server.com/.well-known/openid-configuration"
      }
    },
    {
      "description": "invalid: type in other case",
      "valid": false,
      "data": {
        "type": "OPENiDcONNECT",
        "openIdConnectUrl": "https://server.com/.well-known/openid-configuration"
      }
    },
    {
      "description": "invalid: description is not a string",
      "valid": false,
      "data": {
        "type": "openIdConnect",
        "openIdConnectUrl": "https://server.com/.well-known/openid-configuration",
        "description": 1
      }
    },
    {
      "description": "invalid: $ref is not allowed",
      "valid": false,
      "data": {
        "type": "openIdConnect",
        "openIdConnectUrl": "https://server.com/.well-known/openid-configuration",
        "$ref": "#/components/securitySchemes/auth"
      }
    },
    {
      "description": "invalid: unknown property",
      "valid": false,
      "data": {
        "type": "openIdConnect",
        "openIdConnectUrl": "https://server.com/.well-known/openid-configuration",
        "scheme": "basic"
      }
    },
    {
      "description": "invalid: openIdConnectUrl is relative",
      "valid": false,
      "data": {
        "type": "openIdConnect",
        "openIdConnectUrl": "/.well-known/openid-configuration"
      }
    },
    {
      "description": "invalid: openIdConnectUrl is not a string",
      "valid": false,
      "data": {
        "type": "openIdConnect",
        "openIdConnectUrl": 1
      }
    },
    {
      "description": "invalid: not an object",
      "valid": false,
      "data": "openIdConnect"
    }
  ]
}
