{
  "target": "http://localhost:8000/draft-07/schemas/v2.1.0/servers/server.json",
  "tests": [
    {
      "description": "valid: example #1",
      "valid": true,
      "data": {
        "url": "development.gigantic-server.com",
        "protocol": "kafka"
      }
    },
    {
      "description": "valid: example #2",
      "valid": true,
      "data": {
        "url": "development.gigantic-server.com",
        "protocol": "kafka",
        "description": "Kafka development server",
        "protocolVersion": "4.3"
      }
    },
    {
      "description": "valid: example #3",
      "valid": true,
      "data": {
        "url": "{username}.gigantic-server.com:{port}",
        "protocol": "kafka",
        "variables": {
          "username": {
            "description": "This value is assigned by the service provider, in this example `gigantic-server.com`",
            "default": "production"
          },
          "port": {
            "enum": [
              "8883",
              "14567"
            ],
            "default": "8883"
          }
        }
      }
    },
    {
      "description": "valid: example #4",
      "valid": true,
      "data": {
        "url": "development.gigantic-server.com",
        "protocol": "kafka",
        "security": [
          {
            "type": "userPassword",
            "description": "Sent inside the initial CONNECT message"
          }
        ]
      }
    },
    {
      "description": "valid: example #5",
      "valid": true,
      "data": {
        "url": "development.gigantic-server.com",
        "protocol": "kafka",
        "bindings": {}
      }
    },
    {
      "description": "valid: minimal (url and protocol)",
      "valid": true,
      "data": {
        "url": "broker.mycompany.com:5672",
        "protocol": "amqp"
      }
    },
    {
      "description": "valid: url with variables",
      "valid": true,
      "data": {
        "url": "{env}.mycompany.com:{port}",
        "protocol": "amqp"
      }
    },
    {
      "description": "valid: any protocol string is accepted",
      "valid": true,
      "data": {
        "url": "broker.mycompany.com:5672",
        "protocol": "my-protocol"
      }
    },
    {
      "description": "valid: variables",
      "valid": true,
      "data": {
        "url": "broker.mycompany.com:5672",
        "protocol": "amqp",
        "variables": {
          "port": {
            "default": "5672",
            "enum": [
              "5672",
              "5673"
            ]
          }
        }
      }
    },
    {
      "description": "invalid: missing url",
      "valid": false,
      "data": {
        "protocol": "amqp"
      }
    },
    {
      "description": "invalid: missing protocol",
      "valid": false,
      "data": {
        "url": "broker.mycompany.com:5672"
      }
    },
    {
      "description": "invalid: empty object",
      "valid": false,
      "data": {}
    },
    {
      "description": "invalid: host is not allowed (v3 field, use url)",
      "valid": false,
      "data": {
        "protocol": "amqp",
        "host": "broker.mycompany.com"
      }
    },
    {
      "description": "invalid: pathname is not allowed (v3 field)",
      "valid": false,
      "data": {
        "url": "broker.mycompany.com:5672",
        "protocol": "amqp",
        "pathname": "/v1"
      }
    },
    {
      "description": "invalid: url is not a string",
      "valid": false,
      "data": {
        "url": 1,
        "protocol": "amqp"
      }
    },
    {
      "description": "invalid: description is not a string",
      "valid": false,
      "data": {
        "url": "broker.mycompany.com:5672",
        "protocol": "amqp",
        "description": 1
      }
    },
    {
      "description": "invalid: protocol is not a string",
      "valid": false,
      "data": {
        "url": "broker.mycompany.com:5672",
        "protocol": 1
      }
    },
    {
      "description": "invalid: protocolVersion is not a string",
      "valid": false,
      "data": {
        "url": "broker.mycompany.com:5672",
        "protocol": "amqp",
        "protocolVersion": 1
      }
    },
    {
      "description": "invalid: variable with numeric default",
      "valid": false,
      "data": {
        "url": "broker.mycompany.com:5672",
        "protocol": "amqp",
        "variables": {
          "port": {
            "default": 5672
          }
        }
      }
    },
    {
      "description": "invalid: variables is an array",
      "valid": false,
      "data": {
        "url": "broker.mycompany.com:5672",
        "protocol": "amqp",
        "variables": [
          {
            "default": "5672"
          }
        ]
      }
    },
    {
      "description": "invalid: variables reference is not available in 2.1.0 (added in 2.5.0)",
      "valid": false,
      "data": {
        "url": "broker.mycompany.com:5672",
        "protocol": "amqp",
        "variables": {
          "port": {
            "$ref": "#/components/serverVariables/port"
          }
        }
      }
    },
    {
      "description": "valid: security with inline scheme",
      "valid": true,
      "data": {
        "url": "broker.mycompany.com:5672",
        "protocol": "amqp",
        "security": [
          {
            "type": "X509"
          },
          {
            "type": "userPassword"
          }
        ]
      }
    },
    {
      "description": "valid: empty security",
      "valid": true,
      "data": {
        "url": "broker.mycompany.com:5672",
        "protocol": "amqp",
        "security": []
      }
    },
    {
      "description": "invalid: security as requirement map (spec: Security Requirement Object)",
      "valid": false,
      "data": {
        "url": "broker.mycompany.com:5672",
        "protocol": "amqp",
        "security": [
          {
            "x509": []
          }
        ]
      }
    },
    {
      "description": "invalid: security with reference (no reference branch)",
      "valid": false,
      "data": {
        "url": "broker.mycompany.com:5672",
        "protocol": "amqp",
        "security": [
          {
            "$ref": "#/components/securitySchemes/x509"
          }
        ]
      }
    },
    {
      "description": "invalid: security with unknown scheme type",
      "valid": false,
      "data": {
        "url": "broker.mycompany.com:5672",
        "protocol": "amqp",
        "security": [
          {
            "type": "kerberos"
          }
        ]
      }
    },
    {
      "description": "invalid: security is an object",
      "valid": false,
      "data": {
        "url": "broker.mycompany.com:5672",
        "protocol": "amqp",
        "security": {
          "type": "X509"
        }
      }
    },
    {
      "description": "invalid: tags is not available in 2.1.0 (added in 2.5.0)",
      "valid": false,
      "data": {
        "url": "broker.mycompany.com:5672",
        "protocol": "amqp",
        "tags": [
          {
            "name": "env:prod"
          }
        ]
      }
    },
    {
      "description": "valid: empty bindings",
      "valid": true,
      "data": {
        "url": "broker.mycompany.com:5672",
        "protocol": "amqp",
        "bindings": {}
      }
    },
    {
      "description": "valid: binding reference per protocol",
      "valid": true,
      "data": {
        "url": "broker.mycompany.com:5672",
        "protocol": "amqp",
        "bindings": {
          "amqp": {
            "$ref": "#/components/bindings/a"
          }
        }
      }
    },
    {
      "description": "invalid: known protocol with unknown bindingVersion",
      "valid": false,
      "data": {
        "url": "broker.mycompany.com:5672",
        "protocol": "amqp",
        "bindings": {
          "amqp": {
            "bindingVersion": "9.9.9"
          }
        }
      }
    },
    {
      "description": "valid: unknown protocol is accepted unvalidated (map has additionalProperties: true)",
      "valid": true,
      "data": {
        "url": "broker.mycompany.com:5672",
        "protocol": "amqp",
        "bindings": {
          "unknown": 1
        }
      }
    },
    {
      "description": "valid: ros2 is accepted unvalidated (not in the v2 map)",
      "valid": true,
      "data": {
        "url": "broker.mycompany.com:5672",
        "protocol": "amqp",
        "bindings": {
          "ros2": {
            "bindingVersion": "9.9.9"
          }
        }
      }
    },
    {
      "description": "invalid: bindings is an array",
      "valid": false,
      "data": {
        "url": "broker.mycompany.com:5672",
        "protocol": "amqp",
        "bindings": []
      }
    },
    {
      "description": "valid: googlepubsub is accepted unvalidated in 2.1.0 (added to the map in 2.6.0)",
      "valid": true,
      "data": {
        "url": "broker.mycompany.com:5672",
        "protocol": "amqp",
        "bindings": {
          "googlepubsub": {
            "bindingVersion": "9.9.9"
          }
        }
      }
    },
    {
      "description": "valid: x- extension in bindings",
      "valid": true,
      "data": {
        "url": "broker.mycompany.com:5672",
        "protocol": "amqp",
        "bindings": {
          "x-custom": 1
        }
      }
    },
    {
      "description": "valid: with x- extension",
      "valid": true,
      "data": {
        "url": "broker.mycompany.com:5672",
        "protocol": "amqp",
        "x-owner": "team"
      }
    },
    {
      "description": "invalid: x- without name",
      "valid": false,
      "data": {
        "url": "broker.mycompany.com:5672",
        "protocol": "amqp",
        "x-": "team"
      }
    },
    {
      "description": "invalid: unknown property",
      "valid": false,
      "data": {
        "url": "broker.mycompany.com:5672",
        "protocol": "amqp",
        "host": "x"
      }
    },
    {
      "description": "invalid: not an object",
      "valid": false,
      "data": "x"
    },
    {
      "description": "invalid: array",
      "valid": false,
      "data": [
        {
          "url": "broker.mycompany.com:5672",
          "protocol": "amqp"
        }
      ]
    },
    {
      "description": "invalid: null",
      "valid": false,
      "data": null
    }
  ]
}
