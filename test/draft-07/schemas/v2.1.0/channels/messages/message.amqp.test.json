        },
        "bindings": {
          "amqp": {
            "contentEncoding": "gzip",
            "bindingVersion": "0.2.0",
            "messageType": "user.signup"
          }
        }
      }
    },
    {
      "description": "invalid: 0.2.0 contentEncoding is not a string",
