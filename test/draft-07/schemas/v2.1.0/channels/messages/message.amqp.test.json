      "valid": true,
      "data": {
        "payload": {
          "type": "string"
        },
        "bindings": {
          "amqp": {
            "$ref": "#/components/messageBindings/my-amqp"
          }
        }
      }
    },
    {
      "description": "invalid: reference with extra property",
      "valid": false,
      "data": {
        "payload": {
