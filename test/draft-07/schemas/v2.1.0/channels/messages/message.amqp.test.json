{
  "target": "http://localhost:8000/draft-07/schemas/v2.1.0/channels/messages/message.json",
  "tests": [
    {
      "description": "valid: 0.3.0 example #1",
      "valid": true,
      "data": {
        "payload": {
          "type": "string"
        },
        "bindings": {
          "amqp": {
            "contentEncoding": "gzip",
            "bindingVersion": "0.3.0",
            "messageType": "user.signup"
          }
        }
      }
    },
    {
      "description": "invalid: 0.3.0 contentEncoding is not a string",
      "valid": false,
      "data": {
        "payload": {
          "type": "string"
        },
        "bindings": {
          "amqp": {
            "contentEncoding": 1,
            "bindingVersion": "0.3.0"
          }
        }
      }
    },
    {
