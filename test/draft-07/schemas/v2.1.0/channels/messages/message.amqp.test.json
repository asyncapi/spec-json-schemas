    {
      "description": "valid: example without bindingVersion (latest 0.3.0 is used)",
      "valid": true,
      "data": {
        "payload": {
          "type": "string"
        },
        "bindings": {
          "amqp": {
            "contentEncoding": "gzip",
            "messageType": "user.signup"
          }
