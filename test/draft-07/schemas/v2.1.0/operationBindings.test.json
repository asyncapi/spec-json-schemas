    {
      "description": "valid: example #2",
      "valid": true,
      "data": {
        "sns": {
          "consumers": [
            {
              "endpoint": {
                "name": "someQueue"
              },
              "protocol": "sqs",
              "rawMessageDelivery": false
            }
          ],
          "topic": {
            "name": "someTopic"
          },
          "bindingVersion": "0.2.0"
        },
        "sqs": {
          "queues": [
            {
              "name": "myQueue",
              "policy": {
                "statements": [
                  {
                    "action": [
                      "sqs:SendMessage",
                      "sqs:ReceiveMessage"
                    ],
                    "effect": "Deny",
                    "principal": "arn:aws:iam::123456789012:user/dec.kolakowski",
                    "condition": {
                      "ArnEquals": {
                        "aws:SourceArn": "arn:aws:sns:us-east-1:123456789012:MyTopic"
                      }
                    }
                  }
                ]
              },
              "redrivePolicy": {
                "deadLetterQueue": {
                  "name": "myQueue_error"
                },
                "maxReceiveCount": 15
              }
            }
          ],
          "bindingVersion": "0.3.0"
        },
        "amqp": {
          "ack": false,
          "bcc": [
            "external.audit"
          ],
          "cc": [
            "user.logs"
          ],
          "deliveryMode": 2,
          "expiration": 100000,
          "mandatory": false,
          "priority": 10,
          "timestamp": true,
          "userId": "guest",
          "bindingVersion": "0.3.0"
        },
        "amqp1": {
          "bindingVersion": "0.1.0"
        },
        "anypointmq": {
          "bindingVersion": "0.0.1"
        },
        "kafka": {
          "bindingVersion": "0.5.0",
          "clientId": {
            "type": "string",
            "enum": [
              "myClientId"
            ]
          },
          "groupId": {
            "type": "string",
            "enum": [
              "myGroupId"
            ]
          }
        },
        "http": {
          "bindingVersion": "0.3.0",
          "method": "GET",
          "query": {
            "type": "object",
            "required": [
              "companyId"
            ],
            "properties": {
              "companyId": {
                "description": "The Id of the company.",
                "type": "number",
                "minimum": 1
              }
            },
            "additionalProperties": false
          }
        },
        "ibmmq": {
          "bindingVersion": "0.1.0"
        },
        "jms": {
          "bindingVersion": "0.0.1"
        },
        "mqtt": {
          "bindingVersion": "0.2.0",
          "messageExpiryInterval": 60,
          "qos": 2,
          "retain": true
        },
        "mqtt5": {
          "bindingVersion": "0.2.0"
        },
        "nats": {
          "bindingVersion": "0.1.0",
          "queue": "MyCustomQueue"
        },
        "redis": {
          "bindingVersion": "0.1.0"
        },
        "solace": {
          "bindingVersion": "0.4.0",
          "destinations": [
            {
              "destinationType": "queue",
              "queue": {
                "accessType": "nonexclusive",
                "name": "sampleQueue",
                "topicSubscriptions": [
                  "samples/*"
                ]
              }
            },
            {
              "destinationType": "queue",
              "queue": {
                "accessType": "exclusive",
                "name": "sampleQueue",
                "topicSubscriptions": [
                  "samples/*"
                ],
                "maxMsgSpoolUsage": "4",
                "maxTtl": "1"
              }
            },
            {
              "destinationType": "topic",
              "topicSubscriptions": [
                "samples/*"
              ]
            }
          ],
          "dmqEligible": true,
          "priority": 20,
          "timeToLive": 10
        },
        "stomp": {
          "bindingVersion": "0.1.0"
        },
        "ws": {
          "bindingVersion": "0.1.0"
        }
      }
    },
