{
  "target": "http://localhost:8000/draft-07/schemas/v2.4.0/channels/messages/messageTrait.json",
  "tests": [
    {
      "description": "valid: 0.1.0 example #1",
      "valid": true,
      "data": {
        "name": "UserSignedUp",
        "bindings": {
          "stomp": {
            "bindingVersion": "0.1.0"
          }
        }
      }
    },
    {
      "description": "invalid: 0.1.0 unknown property",
      "valid": false,
      "data": {
        "name": "UserSignedUp",
        "bindings": {
          "stomp": {
            "destination": "/queue/orders",
            "bindingVersion": "0.1.0"
          }
        }
      }
    },
    {
      "description": "valid: example without bindingVersion (latest 0.1.0 is used)",
      "valid": true,
      "data": {
        "name": "UserSignedUp",
        "bindings": {
          "stomp": {}
        }
      }
    },
    {
      "description": "valid: reference",
      "valid": true,
      "data": {
        "name": "UserSignedUp",
        "bindings": {
          "stomp": {
            "$ref": "#/components/messageBindings/my-stomp"
          }
        }
      }
    },
    {
      "description": "invalid: reference with extra property",
      "valid": false,
      "data": {
        "name": "UserSignedUp",
        "bindings": {
          "stomp": {
            "$ref": "#/components/messageBindings/my-stomp",
            "bindingVersion": "0.1.0"
          }
        }
      }
    },
    {
      "description": "invalid: unknown bindingVersion 9.9.9",
      "valid": false,
      "data": {
        "name": "UserSignedUp",
        "bindings": {
          "stomp": {
            "bindingVersion": "9.9.9"
          }
        }
      }
    },
    {
      "description": "invalid: bindingVersion is a number",
      "valid": false,
      "data": {
        "name": "UserSignedUp",
        "bindings": {
          "stomp": {
            "bindingVersion": 1
          }
        }
      }
    },
    {
      "description": "invalid: binding is a string",
      "valid": false,
      "data": {
        "name": "UserSignedUp",
        "bindings": {
          "stomp": "stomp"
        }
      }
    },
    {
      "description": "invalid: binding is null",
      "valid": false,
      "data": {
        "name": "UserSignedUp",
        "bindings": {
          "stomp": null
        }
      }
    }
  ]
}
