    },
    {
      "description": "invalid: messageId is not a string",
      "valid": false,
      "data": {
        "payload": {
          "type": "string"
        },
        "messageId": 1
      }
    },
    {
      "description": "valid: tags",
      "valid": true,
      "data": {
        "payload": {
          "type": "string"
        },
        "tags": [
          {
            "name": "a"
          },
          {
            "name": "b"
          }
        ]
      }
    },
    {
      "description": "invalid: duplicated tags",
      "valid": false,
      "data": {
        "payload": {
          "type": "string"
        },
        "tags": [
          {
            "name": "a"
          },
          {
            "name": "a"
          }
        ]
      }
    },
    {
      "description": "invalid: tag without name",
      "valid": false,
      "data": {
        "payload": {
          "type": "string"
        },
        "tags": [
          {
            "description": "a"
          }
        ]
      }
    },
    {
      "description": "invalid: tag reference (added in v3)",
      "valid": false,
      "data": {
        "payload": {
          "type": "string"
        },
        "tags": [
          {
            "$ref": "#/components/tags/a"
          }
        ]
      }
    },
    {
      "description": "valid: externalDocs",
      "valid": true,
      "data": {
        "payload": {
          "type": "string"
        },
        "externalDocs": {
          "url": "https://docs.lo"
        }
      }
    },
    {
      "description": "invalid: externalDocs without url",
      "valid": false,
      "data": {
        "payload": {
          "type": "string"
        },
        "externalDocs": {
          "description": "d"
        }
      }
    },
    {
      "description": "invalid: externalDocs reference (added in v3)",
      "valid": false,
      "data": {
        "payload": {
          "type": "string"
        },
        "externalDocs": {
          "$ref": "#/components/externalDocs/a"
        }
      }
    },
    {
      "description": "valid: empty bindings",
      "valid": true,
      "data": {
        "payload": {
          "type": "string"
        },
        "bindings": {}
      }
    },
    {
      "description": "valid: binding reference per protocol",
      "valid": true,
      "data": {
        "payload": {
          "type": "string"
        },
        "bindings": {
          "kafka": {
            "$ref": "#/components/bindings/a"
          }
        }
      }
    },
    {
      "description": "invalid: known protocol with unknown bindingVersion",
      "valid": false,
      "data": {
        "payload": {
          "type": "string"
        },
        "bindings": {
          "kafka": {
            "bindingVersion": "9.9.9"
          }
        }
      }
    },
    {
      "description": "valid: unknown protocol is accepted unvalidated (map has additionalProperties: true)",
      "valid": true,
      "data": {
        "payload": {
          "type": "string"
        },
        "bindings": {
          "unknown": 1
        }
      }
    },
    {
      "description": "valid: ros2 is accepted unvalidated (not in the v2 map)",
      "valid": true,
      "data": {
        "payload": {
          "type": "string"
        },
        "bindings": {
          "ros2": {
            "bindingVersion": "9.9.9"
          }
        }
      }
    },
    {
      "description": "invalid: bindings is an array",
      "valid": false,
      "data": {
        "payload": {
          "type": "string"
        },
        "bindings": []
      }
    },
    {
      "description": "valid: googlepubsub is accepted unvalidated in 2.4.0 (added to the map in 2.6.0)",
      "valid": true,
      "data": {
        "payload": {
          "type": "string"
        },
        "bindings": {
          "googlepubsub": {
            "bindingVersion": "9.9.9"
          }
        }
      }
    },
    {
      "description": "valid: x- extension in bindings",
      "valid": true,
      "data": {
        "payload": {
          "type": "string"
        },
        "bindings": {
          "x-custom": 1
        }
      }
    },
    {
      "description": "valid: with x- extension",
      "valid": true,
      "data": {
        "payload": {
          "type": "string"
        },
        "x-owner": "team"
      }
    },
    {
      "description": "invalid: x- without name",
      "valid": false,
      "data": {
        "payload": {
          "type": "string"
        },
        "x-": "team"
      }
    },
    {
      "description": "invalid: unknown property",
      "valid": false,
      "data": {
        "payload": {
          "type": "string"
        },
        "action": "x"
