{
  "target": "http://localhost:8000/draft-07/schemas/v2.4.0/servers/server.json",
  "tests": [
    {
      "description": "valid: 0.1.0 example #1",
      "valid": true,
      "data": {
        "url": "broker.mycompany.com:5672",
        "protocol": "ibmmq",
        "bindings": {
          "ibmmq": {
            "bindingVersion": "0.1.0",
            "cipherSpec": "ANY_TLS12_OR_HIGHER",
            "groupId": "PRODCLSTR1"
          }
        }
      }
    },
    {
      "description": "valid: 0.1.0 example #2",
      "valid": true,
      "data": {
        "url": "broker.mycompany.com:5672",
        "protocol": "ibmmq",
        "bindings": {
          "ibmmq": {
            "bindingVersion": "0.1.0",
            "groupId": "PRODCLSTR1",
            "ccdtQueueManagerName": "*",
            "heartBeatInterval": 1000,
            "multiEndpointServer": false
          }
        }
      }
    },
    {
      "description": "invalid: 0.1.0 groupId is not a string",
      "valid": false,
      "data": {
        "url": "broker.mycompany.com:5672",
        "protocol": "ibmmq",
        "bindings": {
          "ibmmq": {
            "groupId": 1,
            "bindingVersion": "0.1.0"
          }
        }
      }
    },
    {
      "description": "valid: example without bindingVersion (latest 0.1.0 is used)",
      "valid": true,
      "data": {
        "url": "broker.mycompany.com:5672",
        "protocol": "ibmmq",
        "bindings": {
          "ibmmq": {
            "cipherSpec": "ANY_TLS12_OR_HIGHER",
            "groupId": "PRODCLSTR1"
          }
        }
      }
    },
    {
      "description": "valid: reference",
      "valid": true,
      "data": {
        "url": "broker.mycompany.com:5672",
        "protocol": "ibmmq",
        "bindings": {
          "ibmmq": {
            "$ref": "#/components/serverBindings/my-ibmmq"
          }
        }
      }
    },
    {
      "description": "invalid: reference with extra property",
      "valid": false,
      "data": {
        "url": "broker.mycompany.com:5672",
        "protocol": "ibmmq",
        "bindings": {
          "ibmmq": {
            "$ref": "#/components/serverBindings/my-ibmmq",
            "bindingVersion": "0.1.0"
          }
        }
      }
    },
    {
      "description": "invalid: unknown bindingVersion 9.9.9",
      "valid": false,
      "data": {
        "url": "broker.mycompany.com:5672",
        "protocol": "ibmmq",
        "bindings": {
          "ibmmq": {
            "bindingVersion": "9.9.9"
          }
        }
      }
    },
    {
      "description": "invalid: bindingVersion is a number",
      "valid": false,
      "data": {
        "url": "broker.mycompany.com:5672",
        "protocol": "ibmmq",
        "bindings": {
          "ibmmq": {
            "bindingVersion": 1
          }
        }
      }
    },
    {
      "description": "invalid: binding is a string",
      "valid": false,
      "data": {
        "url": "broker.mycompany.com:5672",
        "protocol": "ibmmq",
        "bindings": {
          "ibmmq": "ibmmq"
        }
      }
    },
    {
      "description": "invalid: binding is null",
      "valid": false,
      "data": {
        "url": "broker.mycompany.com:5672",
        "protocol": "ibmmq",
        "bindings": {
          "ibmmq": null
        }
      }
    }
  ]
}
