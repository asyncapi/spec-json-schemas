{
  "target": "http://localhost:8000/draft-07/schemas/v3.1.0/operations/operation.json",
  "tests": [
    {
      "description": "valid: 0.1.0 example #1",
      "valid": true,
      "data": {
        "action": "send",
        "channel": {
          "$ref": "#/channels/users"
        },
        "bindings": {
          "ros2": {
            "node": "/turtlesim",
            "qosPolicies": {
              "deadline": -1,
              "durability": "volatile",
              "history": "unknown",
              "leaseDuration": -1,
              "lifespan": -1,
              "liveliness": "automatic",
              "reliability": "reliable"
            },
            "role": "subscriber",
            "bindingVersion": "0.1.0"
          }
        }
      }
    },
    {
      "description": "invalid: 0.1.0 missing node",
      "valid": false,
      "data": {
        "action": "send",
        "channel": {
          "$ref": "#/channels/users"
        },
        "bindings": {
          "ros2": {
            "role": "subscriber",
            "bindingVersion": "0.1.0"
          }
        }
      }
    },
    {
      "description": "valid: example without bindingVersion (latest 0.1.0 is used)",
      "valid": true,
      "data": {
        "action": "send",
        "channel": {
          "$ref": "#/channels/users"
        },
        "bindings": {
          "ros2": {
            "node": "/turtlesim",
            "qosPolicies": {
              "deadline": -1,
              "durability": "volatile",
              "history": "unknown",
              "leaseDuration": -1,
              "lifespan": -1,
              "liveliness": "automatic",
              "reliability": "reliable"
            },
            "role": "subscriber"
          }
        }
      }
    },
    {
      "description": "valid: reference",
      "valid": true,
      "data": {
        "action": "send",
        "channel": {
          "$ref": "#/channels/users"
        },
        "bindings": {
          "ros2": {
            "$ref": "#/components/operationBindings/my-ros2"
          }
        }
      }
    },
    {
      "description": "invalid: reference with extra property",
      "valid": false,
      "data": {
        "action": "send",
        "channel": {
          "$ref": "#/channels/users"
        },
        "bindings": {
          "ros2": {
            "$ref": "#/components/operationBindings/my-ros2",
            "bindingVersion": "0.1.0"
          }
        }
      }
    },
    {
      "description": "invalid: unknown bindingVersion 9.9.9",
      "valid": false,
      "data": {
        "action": "send",
        "channel": {
          "$ref": "#/channels/users"
        },
        "bindings": {
          "ros2": {
            "bindingVersion": "9.9.9"
          }
        }
      }
    },
    {
      "description": "invalid: bindingVersion is a number",
      "valid": false,
      "data": {
        "action": "send",
        "channel": {
          "$ref": "#/channels/users"
        },
        "bindings": {
          "ros2": {
            "bindingVersion": 1
          }
        }
      }
    },
    {
      "description": "invalid: binding is a string",
      "valid": false,
      "data": {
        "action": "send",
        "channel": {
          "$ref": "#/channels/users"
        },
        "bindings": {
          "ros2": "ros2"
        }
      }
    },
    {
      "description": "invalid: binding is null",
      "valid": false,
      "data": {
        "action": "send",
        "channel": {
          "$ref": "#/channels/users"
        },
        "bindings": {
          "ros2": null
        }
      }
    }
  ]
}
