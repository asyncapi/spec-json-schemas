      "description": "valid: example #1",
      "valid": true,
      "data": {
        "action": "send",
        "channel": {
          "$ref": "#/channels/user-events.v1"
        },
        "reply": {
          "channel": {
            "$ref": "#/channels/user-events-replies.v1"
          }
        },
        "security": [
          {
            "type": "openIdConnect",
            "openIdConnectUrl": "https://server.com/.well-known/openid-configuration"
          },
          {
            "$ref": "#/security/oauth2"
          }
        ],
        "externalDocs": {
          "$ref": "#/documents/user-events.v1"
        }
      }
    },
