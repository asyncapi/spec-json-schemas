{
  "target": "http://localhost:8000/draft-07/schemas/v3.1.0/servers/server.json",
  "tests": [
    {
      "description": "valid: example #1",
      "valid": true,
      "data": {
        "x-microcks-enabled": true,
        "title": "Secured MQTT broker",
        "summary": "MQTT 5.0 broker",
        "description": "Staging secured MQTT 5.0 broker",
        "host": "{username}.gigantic-server.com:{port}/{basePath}",
        "protocol": "secure-mqtt",
        "protocolVersion": "5",
        "pathname": "/messages",
        "variables": {
          "username": {
            "description": "This value is assigned by the service provider, in this example `gigantic-server.com`",
            "default": "production"
          },
          "port": {
            "enum": [
              "8883",
              "14567"
            ],
            "default": "8883"
          },
          "basePath": {
            "$ref": "#/components/serverVariables/basePath"
          }
        },
        "security": [
          {
            "type": "userPassword",
            "description": "Sent inside the initial CONNECT message"
          },
          {
            "$ref": "#/components/security/x.509"
          }
        ],
        "tags": [
          {
            "name": "env:staging",
            "description": "This environment is a replica of the production environment"
          },
          {
            "$ref": "#/tags/secured"
          }
        ],
        "externalDocs": {
          "description": "Reade step by step guide to integrate with Gigantic server",
          "url": "https://gigantic-server.com/docs/integrations"
        }
      }
    },
    {
      "description": "valid: minimal (host and protocol)",
      "valid": true,
      "data": {
        "host": "rabbitmq.in.mycompany.com:5672",
        "protocol": "amqp"
      }
    },
    {
      "description": "valid: host with variables",
      "valid": true,
      "data": {
        "host": "{env}.mycompany.com:{port}",
        "protocol": "amqp"
      }
    },
    {
      "description": "valid: any protocol string is accepted (no enum)",
      "valid": true,
      "data": {
        "host": "rabbitmq.in.mycompany.com:5672",
        "protocol": "my-protocol"
      }
    },
    {
      "description": "valid: full server",
      "valid": true,
      "data": {
        "host": "rabbitmq.in.mycompany.com:5672",
        "protocol": "amqp",
        "pathname": "/vhost",
        "title": "Broker",
        "summary": "s",
        "description": "d",
        "protocolVersion": "0.9.1",
        "variables": {
          "port": {
            "default": "5672"
          }
        },
        "security": [
          {
            "type": "userPassword"
          }
        ],
        "tags": [
          {
            "name": "env:prod"
          }
        ],
        "externalDocs": {
          "url": "https://docs.lo"
        },
        "bindings": {
          "amqp": {
            "bindingVersion": "0.3.0"
          }
        }
      }
    },
    {
      "description": "valid: host with scheme is accepted (not checked)",
      "valid": true,
      "data": {
        "host": "amqp://rabbitmq.in.mycompany.com",
        "protocol": "amqp"
      }
    },
    {
      "description": "valid: pathname without leading slash is accepted (no pattern)",
