{
  "target": "http://localhost:8000/draft-07/schemas/v3.1.0/channels/channel.json",
  "tests": [
    {
      "description": "valid: 0.0.1 example #1",
      "valid": true,
      "data": {
        "address": "users.{userId}",
        "bindings": {
          "anypointmq": {
            "bindingVersion": "0.0.1",
            "destination": "user-signup-exchg",
            "destinationType": "exchange"
          }
        }
      }
    },
    {
      "description": "valid: 0.0.1 example #2",
      "valid": true,
      "data": {
        "address": "users.{userId}",
        "bindings": {
          "anypointmq": {
            "bindingVersion": "0.0.1",
            "destination": "user-signup-queue",
            "destinationType": "queue"
          }
        }
      }
    },
    {
      "description": "valid: 0.0.1 example #3",
      "valid": true,
      "data": {
        "address": "users.{userId}",
        "bindings": {
          "anypointmq": {
            "bindingVersion": "0.0.1",
            "destination": "user-signup-fifo-queue",
            "destinationType": "fifo-queue"
          }
        }
      }
    },
    {
      "description": "invalid: 0.0.1 destination is not a string",
      "valid": false,
      "data": {
        "address": "users.{userId}",
        "bindings": {
          "anypointmq": {
            "destination": 1,
            "bindingVersion": "0.0.1"
          }
        }
      }
    },
    {
      "description": "valid: example without bindingVersion (latest 0.0.1 is used)",
      "valid": true,
      "data": {
        "address": "users.{userId}",
        "bindings": {
          "anypointmq": {
            "destination": "user-signup-exchg",
            "destinationType": "exchange"
          }
        }
      }
    },
    {
      "description": "valid: reference",
      "valid": true,
      "data": {
        "address": "users.{userId}",
        "bindings": {
          "anypointmq": {
            "$ref": "#/components/channelBindings/my-anypointmq"
          }
        }
      }
    },
    {
      "description": "invalid: reference with extra property",
      "valid": false,
      "data": {
        "address": "users.{userId}",
        "bindings": {
          "anypointmq": {
            "$ref": "#/components/channelBindings/my-anypointmq",
            "bindingVersion": "0.0.1"
          }
        }
      }
    },
    {
      "description": "invalid: unknown bindingVersion 9.9.9",
      "valid": false,
      "data": {
        "address": "users.{userId}",
        "bindings": {
          "anypointmq": {
            "bindingVersion": "9.9.9"
          }
        }
      }
    },
    {
      "description": "invalid: bindingVersion is a number",
      "valid": false,
      "data": {
        "address": "users.{userId}",
        "bindings": {
          "anypointmq": {
            "bindingVersion": 1
          }
        }
      }
    },
    {
      "description": "invalid: binding is a string",
      "valid": false,
      "data": {
        "address": "users.{userId}",
        "bindings": {
          "anypointmq": "anypointmq"
        }
      }
    },
    {
      "description": "invalid: binding is null",
      "valid": false,
      "data": {
        "address": "users.{userId}",
        "bindings": {
          "anypointmq": null
        }
      }
    }
  ]
}
