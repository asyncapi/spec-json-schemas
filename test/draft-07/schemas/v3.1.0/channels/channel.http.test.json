{
  "target": "http://localhost:8000/draft-07/schemas/v3.1.0/channels/channel.json",
  "tests": [
    {
      "description": "valid: 0.3.0 example #1",
      "valid": true,
      "data": {
        "address": "users.{userId}",
        "bindings": {
          "http": {
            "bindingVersion": "0.3.0"
          }
        }
      }
    },
    {
      "description": "invalid: 0.3.0 unknown property",
      "valid": false,
      "data": {
        "address": "users.{userId}",
        "bindings": {
          "http": {
            "method": "GET",
            "bindingVersion": "0.3.0"
          }
        }
      }
    },
    {
      "description": "valid: 0.2.0 example #1",
      "valid": true,
      "data": {
        "address": "users.{userId}",
        "bindings": {
          "http": {
            "bindingVersion": "0.2.0"
          }
        }
      }
    },
    {
      "description": "invalid: 0.2.0 unknown property",
      "valid": false,
      "data": {
        "address": "users.{userId}",
        "bindings": {
          "http": {
            "method": "GET",
            "bindingVersion": "0.2.0"
          }
        }
      }
    },
    {
      "description": "valid: 0.1.0 example #1",
      "valid": true,
      "data": {
        "address": "users.{userId}",
        "bindings": {
          "http": {
            "bindingVersion": "0.1.0"
          }
        }
      }
    },
    {
      "description": "invalid: 0.1.0 unknown property",
      "valid": false,
      "data": {
        "address": "users.{userId}",
        "bindings": {
          "http": {
            "method": "GET",
            "bindingVersion": "0.1.0"
          }
        }
      }
    },
    {
      "description": "valid: example without bindingVersion (latest 0.3.0 is used)",
      "valid": true,
      "data": {
        "address": "users.{userId}",
        "bindings": {
          "http": {}
        }
      }
    },
    {
      "description": "valid: reference",
      "valid": true,
      "data": {
        "address": "users.{userId}",
        "bindings": {
          "http": {
            "$ref": "#/components/channelBindings/my-http"
          }
        }
      }
    },
    {
      "description": "invalid: reference with extra property",
      "valid": false,
      "data": {
        "address": "users.{userId}",
        "bindings": {
          "http": {
            "$ref": "#/components/channelBindings/my-http",
            "bindingVersion": "0.3.0"
          }
        }
      }
    },
    {
      "description": "invalid: unknown bindingVersion 9.9.9",
      "valid": false,
      "data": {
        "address": "users.{userId}",
        "bindings": {
          "http": {
            "bindingVersion": "9.9.9"
          }
        }
      }
    },
    {
      "description": "invalid: bindingVersion is a number",
      "valid": false,
      "data": {
        "address": "users.{userId}",
        "bindings": {
          "http": {
            "bindingVersion": 1
          }
        }
      }
    },
    {
      "description": "invalid: binding is a string",
      "valid": false,
      "data": {
        "address": "users.{userId}",
        "bindings": {
          "http": "http"
        }
      }
    },
    {
      "description": "invalid: binding is null",
      "valid": false,
      "data": {
        "address": "users.{userId}",
        "bindings": {
          "http": null
        }
      }
    }
  ]
}
