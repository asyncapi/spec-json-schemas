{
  "target": "http://localhost:8000/draft-07/schemas/v3.1.0/channels/channel.json",
  "tests": [
    {
      "description": "valid: 0.5.0 example #1",
      "valid": true,
      "data": {
        "address": "users.{userId}",
        "bindings": {
          "kafka": {
            "bindingVersion": "0.5.0",
            "partitions": 20,
            "replicas": 3,
            "topic": "my-specific-topic"
          }
        }
      }
    },
    {
      "description": "valid: 0.5.0 example #2",
      "valid": true,
      "data": {
        "address": "users.{userId}",
        "bindings": {
          "kafka": {
            "bindingVersion": "0.5.0",
            "partitions": 20,
            "replicas": 3,
            "topic": "my-specific-topic",
            "topicConfiguration": {
              "cleanup.policy": [
                "compact",
                "delete"
              ],
              "delete.retention.ms": 1000,
              "max.message.bytes": 2000,
              "retention.bytes": 10,
              "retention.ms": 2000,
              "confluent.key.schema.validation": true,
              "confluent.key.subject.name.strategy": "schema",
              "confluent.value.schema.validation": true,
              "confluent.value.subject.name.strategy": "schema"
            }
          }
        }
      }
    },
    {
      "description": "invalid: 0.5.0 topic is not a string",
      "valid": false,
      "data": {
        "address": "users.{userId}",
        "bindings": {
          "kafka": {
            "topic": 1,
            "bindingVersion": "0.5.0"
          }
        }
      }
    },
    {
      "description": "valid: 0.4.0 example #1",
      "valid": true,
      "data": {
        "address": "users.{userId}",
