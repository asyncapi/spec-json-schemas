          "kafka": {
            "bindingVersion": "0.4.0",
            "partitions": 20,
            "replicas": 3,
            "topic": "my-specific-topic"
          }
        }
      }
    },
    {
      "description": "valid: 0.4.0 example #2",
      "valid": true,
      "data": {
        "address": "users.{userId}",
