          "kafka": {
            "bindingVersion": "0.4.0",
            "partitions": 20,
            "replicas": 3,
            "topic": "my-specific-topic",
            "topicConfiguration": {
              "cleanup.policy": [
                "compact",
                "delete"
              ],
              "delete.retention.ms": 1000,
              "max.message.bytes": 2000,
              "retention.bytes": 10,
              "retention.ms": 2000
            }
          }
        }
      }
    },
    {
      "description": "invalid: 0.4.0 topic is not a string",
      "valid": false,
      "data": {
        "address": "users.{userId}",
        "bindings": {
          "kafka": {
            "topic": 1,
            "bindingVersion": "0.4.0"
          }
        }
      }
    },
    {
      "description": "valid: 0.3.0 example #1",
      "valid": true,
      "data": {
        "address": "users.{userId}",
        "bindings": {
          "kafka": {
            "bindingVersion": "0.3.0",
            "partitions": 20,
            "replicas": 3,
            "topic": "my-specific-topic"
          }
        }
      }
    },
    {
      "description": "invalid: 0.3.0 topic is not a string",
      "valid": false,
      "data": {
        "address": "users.{userId}",
        "bindings": {
          "kafka": {
            "topic": 1,
            "bindingVersion": "0.3.0"
          }
        }
      }
    },
    {
      "description": "valid: 0.1.0 example #1",
      "valid": true,
      "data": {
        "address": "users.{userId}",
        "bindings": {
          "kafka": {
            "bindingVersion": "0.1.0"
          }
        }
      }
    },
    {
      "description": "invalid: 0.1.0 topic is not defined in 0.1.0",
      "valid": false,
      "data": {
        "address": "users.{userId}",
        "bindings": {
          "kafka": {
            "topic": "my-topic",
            "bindingVersion": "0.1.0"
          }
        }
      }
    },
    {
      "description": "valid: example without bindingVersion (latest 0.5.0 is used)",
      "valid": true,
      "data": {
        "address": "users.{userId}",
        "bindings": {
          "kafka": {
            "partitions": 20,
            "replicas": 3,
            "topic": "my-specific-topic"
          }
        }
      }
    },
    {
      "description": "valid: reference",
      "valid": true,
      "data": {
        "address": "users.{userId}",
        "bindings": {
          "kafka": {
            "$ref": "#/components/channelBindings/my-kafka"
          }
        }
      }
    },
    {
      "description": "invalid: reference with extra property",
      "valid": false,
      "data": {
        "address": "users.{userId}",
        "bindings": {
          "kafka": {
            "$ref": "#/components/channelBindings/my-kafka",
            "bindingVersion": "0.5.0"
          }
        }
      }
    },
    {
      "description": "invalid: unknown bindingVersion 9.9.9",
      "valid": false,
      "data": {
        "address": "users.{userId}",
        "bindings": {
          "kafka": {
            "bindingVersion": "9.9.9"
          }
        }
      }
    },
    {
      "description": "invalid: bindingVersion is a number",
      "valid": false,
      "data": {
        "address": "users.{userId}",
        "bindings": {
          "kafka": {
            "bindingVersion": 1
          }
        }
      }
    },
    {
      "description": "invalid: binding is a string",
      "valid": false,
      "data": {
        "address": "users.{userId}",
        "bindings": {
          "kafka": "kafka"
        }
      }
    },
    {
      "description": "invalid: binding is null",
      "valid": false,
      "data": {
        "address": "users.{userId}",
        "bindings": {
          "kafka": null
        }
      }
    },
    {
      "description": "invalid: folder name apache-kafka is not a binding key (use kafka)",
      "valid": false,
      "data": {
        "address": "users.{userId}",
        "bindings": {
          "apache-kafka": {}
        }
      }
    }
  ]
