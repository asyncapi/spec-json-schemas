{
  "target": "http://localhost:8000/draft-07/schemas/v3.1.0/channels/messages/channelMessage.json",
  "tests": [
    {
      "description": "valid: 0.1.0 example #1",
      "valid": true,
      "data": {
        "payload": {
          "type": "string"
        },
        "bindings": {
          "pulsar": {
            "bindingVersion": "0.1.0"
          }
        }
      }
    },
    {
      "description": "invalid: 0.1.0 unknown property",
      "valid": false,
      "data": {
        "payload": {
          "type": "string"
        },
        "bindings": {
          "pulsar": {
            "namespace": "ns1",
            "bindingVersion": "0.1.0"
          }
        }
      }
    },
    {
      "description": "valid: example without bindingVersion (latest 0.1.0 is used)",
      "valid": true,
      "data": {
        "payload": {
          "type": "string"
        },
        "bindings": {
          "pulsar": {}
        }
      }
    },
    {
      "description": "valid: reference",
      "valid": true,
      "data": {
        "payload": {
          "type": "string"
        },
        "bindings": {
          "pulsar": {
            "$ref": "#/components/messageBindings/my-pulsar"
          }
        }
      }
    },
    {
      "description": "invalid: reference with extra property",
      "valid": false,
      "data": {
        "payload": {
          "type": "string"
        },
        "bindings": {
          "pulsar": {
            "$ref": "#/components/messageBindings/my-pulsar",
            "bindingVersion": "0.1.0"
          }
        }
      }
    },
    {
      "description": "invalid: unknown bindingVersion 9.9.9",
      "valid": false,
      "data": {
        "payload": {
          "type": "string"
        },
        "bindings": {
          "pulsar": {
            "bindingVersion": "9.9.9"
          }
        }
      }
    },
    {
      "description": "invalid: bindingVersion is a number",
      "valid": false,
      "data": {
        "payload": {
          "type": "string"
        },
        "bindings": {
          "pulsar": {
            "bindingVersion": 1
          }
        }
      }
    },
    {
      "description": "invalid: binding is a string",
      "valid": false,
      "data": {
        "payload": {
          "type": "string"
        },
        "bindings": {
          "pulsar": "pulsar"
        }
      }
    },
    {
      "description": "invalid: binding is null",
      "valid": false,
      "data": {
        "payload": {
          "type": "string"
        },
        "bindings": {
          "pulsar": null
        }
      }
    },
    {
      "description": "invalid: folder name apache-pulsar is not a binding key (use pulsar)",
      "valid": false,
      "data": {
        "payload": {
          "type": "string"
        },
        "bindings": {
          "apache-pulsar": {}
        }
      }
    }
  ]
}
