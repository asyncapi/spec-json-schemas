{
  "target": "http://localhost:8000/draft-07/schemas/v3.1.0/channels/messages/channelMessage.json",
  "tests": [
    {
      "description": "valid: 0.2.0 example #1",
      "valid": true,
      "data": {
        "payload": {
          "type": "string"
        },
        "bindings": {
          "mqtt": {
            "bindingVersion": "0.2.0"
          }
        }
      }
    },
    {
      "description": "valid: 0.2.0 example #2",
      "valid": true,
      "data": {
        "payload": {
          "type": "string"
        },
        "bindings": {
          "mqtt": {
            "bindingVersion": "0.2.0",
            "contentType": "application/json",
            "correlationData": {
              "type": "string",
              "format": "uuid"
            },
            "responseTopic": "application/responses"
          }
        }
      }
    },
    {
      "description": "valid: 0.2.0 example #3",
      "valid": true,
      "data": {
        "payload": {
          "type": "string"
        },
        "bindings": {
          "mqtt": {
            "bindingVersion": "0.2.0",
            "contentType": "application/json",
            "correlationData": {
              "type": "string",
              "format": "uuid"
            },
            "responseTopic": {
              "type": "object",
              "name": "application/responses"
            }
          }
        }
      }
    },
    {
      "description": "valid: 0.2.0 example #4",
      "valid": true,
      "data": {
        "payload": {
          "type": "string"
        },
        "bindings": {
          "mqtt": {
            "bindingVersion": "0.2.0",
            "contentType": "application/json",
            "correlationData": {
              "$ref": "#/correlationData"
            },
            "responseTopic": {
              "$ref": "#/responseTopic"
            }
          }
        }
      }
    },
    {
      "description": "invalid: 0.2.0 contentType is not a string",
      "valid": false,
      "data": {
        "payload": {
          "type": "string"
        },
        "bindings": {
          "mqtt": {
            "contentType": 1,
            "bindingVersion": "0.2.0"
          }
        }
      }
    },
    {
      "description": "valid: 0.1.0 example #1",
      "valid": true,
      "data": {
        "payload": {
          "type": "string"
        },
        "bindings": {
          "mqtt": {
            "bindingVersion": "0.1.0"
          }
        }
      }
    },
    {
      "description": "invalid: 0.1.0 unknown property",
      "valid": false,
      "data": {
        "payload": {
          "type": "string"
        },
        "bindings": {
          "mqtt": {
            "qos": 1,
            "bindingVersion": "0.1.0"
          }
        }
      }
    },
    {
      "description": "valid: example without bindingVersion (latest 0.2.0 is used)",
      "valid": true,
      "data": {
        "payload": {
          "type": "string"
        },
        "bindings": {
          "mqtt": {}
        }
      }
    },
    {
      "description": "valid: reference",
      "valid": true,
      "data": {
        "payload": {
          "type": "string"
        },
        "bindings": {
          "mqtt": {
            "$ref": "#/components/messageBindings/my-mqtt"
          }
        }
      }
    },
    {
      "description": "invalid: reference with extra property",
      "valid": false,
      "data": {
        "payload": {
          "type": "string"
        },
        "bindings": {
          "mqtt": {
            "$ref": "#/components/messageBindings/my-mqtt",
            "bindingVersion": "0.2.0"
          }
        }
      }
    },
    {
      "description": "invalid: unknown bindingVersion 9.9.9",
      "valid": false,
      "data": {
        "payload": {
          "type": "string"
        },
        "bindings": {
          "mqtt": {
            "bindingVersion": "9.9.9"
          }
        }
      }
    },
    {
      "description": "invalid: bindingVersion is a number",
      "valid": false,
      "data": {
        "payload": {
          "type": "string"
        },
        "bindings": {
          "mqtt": {
            "bindingVersion": 1
          }
        }
      }
    },
    {
      "description": "invalid: binding is a string",
      "valid": false,
      "data": {
        "payload": {
          "type": "string"
        },
        "bindings": {
          "mqtt": "mqtt"
        }
      }
    },
    {
      "description": "invalid: binding is null",
      "valid": false,
      "data": {
        "payload": {
          "type": "string"
        },
        "bindings": {
          "mqtt": null
        }
      }
    }
  ]
}
