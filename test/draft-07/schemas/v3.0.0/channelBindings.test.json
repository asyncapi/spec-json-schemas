    {
      "description": "valid: example #2",
      "valid": true,
      "data": {
        "sns": {
          "name": "my-sns-topic",
          "policy": {
            "statements": [
              {
                "action": "SNS:Publish",
                "effect": "Allow",
                "principal": "*",
                "condition": {
                  "StringEquals": {
                    "aws:SourceAccount": "123456789012"
                  }
                }
              }
            ]
          }
        },
        "sqs": {
          "queue": {
            "fifoQueue": true,
            "name": "my-sqs-queue"
          },
          "deadLetterQueue": {
            "fifoQueue": true,
            "name": "my-sqs-queue.dlq"
          },
          "bindingVersion": "0.3.0"
        },
        "amqp": {
          "bindingVersion": "0.3.0",
          "exchange": {
            "type": "fanout",
            "autoDelete": false,
            "durable": true,
            "name": "myExchange",
            "vhost": "/"
          },
          "is": "routingKey"
        },
        "amqp1": {
          "bindingVersion": "0.1.0"
        },
        "anypointmq": {
          "bindingVersion": "0.0.1",
          "destination": "user-signup-fifo-queue",
          "destinationType": "fifo-queue"
        },
        "kafka": {
          "bindingVersion": "0.5.0",
          "partitions": 20,
          "replicas": 3,
          "topic": "my-specific-topic",
          "topicConfiguration": {
            "cleanup.policy": [
              "compact",
              "delete"
            ],
            "delete.retention.ms": 1000,
            "max.message.bytes": 2000,
            "retention.bytes": 10,
            "retention.ms": 2000,
            "confluent.key.schema.validation": true,
            "confluent.key.subject.name.strategy": "schema",
            "confluent.value.schema.validation": true,
            "confluent.value.subject.name.strategy": "schema"
          }
        },
        "pulsar": {
          "bindingVersion": "0.1.0",
          "compaction": 1000,
          "deduplication": true,
          "geo-replication": [
            "us-west",
            "us-east"
          ],
          "namespace": "ns1",
          "persistence": "persistent",
          "retention": {
            "size": 1000,
            "time": 15
          },
          "ttl": 360
        },
        "googlepubsub": {
          "labels": {
            "label1": "value1",
            "label2": "value2"
          },
          "messageRetentionDuration": "86400s",
          "messageStoragePolicy": {
            "allowedPersistenceRegions": [
              "us-central1",
              "us-east1"
            ]
          },
          "schemaSettings": {
            "encoding": "json",
            "name": "projects/your-project-id/schemas/your-schema",
            "firstRevisionId": "1",
            "lastRevisionId": "2"
          },
          "bindingVersion": "0.2.0"
        },
        "http": {
          "bindingVersion": "0.3.0"
        },
        "ibmmq": {
          "bindingVersion": "0.1.0",
          "destinationType": "topic",
          "topic": {
            "durablePermitted": true,
            "lastMsgRetained": false,
            "objectName": "myTopicName",
            "string": "key"
          }
        },
        "jms": {
          "bindingVersion": "0.0.1",
          "destination": "user-signed-up",
          "destinationType": "queue"
        },
        "mercure": {
          "bindingVersion": "0.1.0"
        },
        "mqtt": {
          "bindingVersion": "0.2.0"
        },
        "mqtt5": {
          "bindingVersion": "0.2.0"
        },
        "nats": {
          "bindingVersion": "0.1.0"
        },
        "redis": {
          "bindingVersion": "0.1.0"
        },
        "solace": {
          "bindingVersion": "0.4.0"
        },
        "stomp": {
          "bindingVersion": "0.1.0"
        },
        "ws": {
          "bindingVersion": "0.1.0",
          "headers": {
            "session-id": {
              "type": "string",
              "format": "uuid"
            }
          },
          "method": "GET"
        }
      }
    },
