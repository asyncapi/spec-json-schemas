{
  "target": "http://localhost:8000/draft-07/schemas/v3.0.0/servers/server.json",
  "tests": [
    {
      "description": "valid: 0.1.0 example #1",
      "valid": true,
      "data": {
        "host": "broker.mycompany.com:5672",
        "protocol": "pulsar",
        "bindings": {
          "pulsar": {
            "bindingVersion": "0.1.0",
            "tenant": "contoso"
          }
        }
      }
    },
    {
      "description": "invalid: 0.1.0 tenant is not a string",
      "valid": false,
      "data": {
        "host": "broker.mycompany.com:5672",
        "protocol": "pulsar",
        "bindings": {
          "pulsar": {
            "tenant": 1,
            "bindingVersion": "0.1.0"
          }
        }
      }
    },
    {
      "description": "valid: example without bindingVersion (latest 0.1.0 is used)",
      "valid": true,
      "data": {
        "host": "broker.mycompany.com:5672",
        "protocol": "pulsar",
        "bindings": {
          "pulsar": {
            "tenant": "contoso"
          }
        }
      }
    },
    {
      "description": "valid: reference",
      "valid": true,
      "data": {
        "host": "broker.mycompany.com:5672",
        "protocol": "pulsar",
        "bindings": {
          "pulsar": {
            "$ref": "#/components/serverBindings/my-pulsar"
          }
        }
      }
    },
    {
      "description": "invalid: reference with extra property",
      "valid": false,
      "data": {
        "host": "broker.mycompany.com:5672",
        "protocol": "pulsar",
        "bindings": {
          "pulsar": {
            "$ref": "#/components/serverBindings/my-pulsar",
            "bindingVersion": "0.1.0"
          }
        }
      }
    },
    {
      "description": "invalid: unknown bindingVersion 9.9.9",
      "valid": false,
      "data": {
        "host": "broker.mycompany.com:5672",
        "protocol": "pulsar",
        "bindings": {
          "pulsar": {
            "bindingVersion": "9.9.9"
          }
        }
      }
    },
    {
      "description": "invalid: bindingVersion is a number",
      "valid": false,
      "data": {
        "host": "broker.mycompany.com:5672",
        "protocol": "pulsar",
        "bindings": {
          "pulsar": {
            "bindingVersion": 1
          }
        }
      }
    },
    {
      "description": "invalid: binding is a string",
      "valid": false,
      "data": {
        "host": "broker.mycompany.com:5672",
        "protocol": "pulsar",
        "bindings": {
          "pulsar": "pulsar"
        }
      }
    },
    {
      "description": "invalid: binding is null",
      "valid": false,
      "data": {
        "host": "broker.mycompany.com:5672",
        "protocol": "pulsar",
        "bindings": {
          "pulsar": null
        }
      }
    },
    {
      "description": "invalid: folder name apache-pulsar is not a binding key (use pulsar)",
      "valid": false,
      "data": {
        "host": "broker.mycompany.com:5672",
        "protocol": "pulsar",
        "bindings": {
          "apache-pulsar": {}
        }
      }
    }
  ]
}
