{
  "target": "http://localhost:8000/draft-07/schemas/v3.0.0/operations/operationTrait.json",
  "tests": [
    {
      "description": "valid: 0.2.0 example #1",
      "valid": true,
      "data": {
        "title": "Send user",
        "bindings": {
          "mqtt": {
            "bindingVersion": "0.2.0",
            "messageExpiryInterval": 60,
            "qos": 2,
            "retain": true
          }
        }
      }
    },
    {
      "description": "valid: 0.2.0 example #2",
      "valid": true,
      "data": {
        "title": "Send user",
        "bindings": {
          "mqtt": {
            "bindingVersion": "0.2.0",
            "messageExpiryInterval": {
              "$ref": "#/messageExpiryInterval"
            },
            "qos": 2,
            "retain": true
          }
        }
      }
    },
    {
      "description": "valid: 0.2.0 example #3",
      "valid": true,
      "data": {
        "title": "Send user",
        "bindings": {
          "mqtt": {
            "bindingVersion": "0.2.0",
            "messageExpiryInterval": {
              "type": "integer",
              "minimum": 0
            },
            "qos": 2,
            "retain": true
          }
        }
      }
    },
    {
      "description": "invalid: 0.2.0 retain is not a boolean",
      "valid": false,
      "data": {
        "title": "Send user",
        "bindings": {
          "mqtt": {
            "retain": "true",
            "bindingVersion": "0.2.0"
          }
        }
      }
    },
    {
      "description": "valid: 0.1.0 example #1",
      "valid": true,
      "data": {
        "title": "Send user",
        "bindings": {
          "mqtt": {
            "bindingVersion": "0.1.0",
            "qos": 2,
            "retain": true
          }
        }
      }
    },
    {
      "description": "invalid: 0.1.0 retain is not a boolean",
      "valid": false,
      "data": {
        "title": "Send user",
        "bindings": {
          "mqtt": {
            "retain": "true",
            "bindingVersion": "0.1.0"
          }
        }
      }
    },
    {
      "description": "valid: example without bindingVersion (latest 0.2.0 is used)",
      "valid": true,
      "data": {
        "title": "Send user",
        "bindings": {
          "mqtt": {
            "messageExpiryInterval": 60,
            "qos": 2,
            "retain": true
          }
        }
      }
    },
    {
      "description": "valid: reference",
      "valid": true,
      "data": {
        "title": "Send user",
        "bindings": {
          "mqtt": {
            "$ref": "#/components/operationBindings/my-mqtt"
          }
        }
      }
    },
    {
      "description": "invalid: reference with extra property",
      "valid": false,
      "data": {
        "title": "Send user",
        "bindings": {
          "mqtt": {
            "$ref": "#/components/operationBindings/my-mqtt",
            "bindingVersion": "0.2.0"
          }
        }
      }
    },
    {
      "description": "invalid: unknown bindingVersion 9.9.9",
      "valid": false,
      "data": {
        "title": "Send user",
        "bindings": {
          "mqtt": {
            "bindingVersion": "9.9.9"
          }
        }
      }
    },
    {
      "description": "invalid: bindingVersion is a number",
      "valid": false,
      "data": {
        "title": "Send user",
        "bindings": {
          "mqtt": {
            "bindingVersion": 1
          }
        }
      }
    },
    {
      "description": "invalid: binding is a string",
      "valid": false,
      "data": {
        "title": "Send user",
        "bindings": {
          "mqtt": "mqtt"
        }
      }
    },
    {
      "description": "invalid: binding is null",
      "valid": false,
      "data": {
        "title": "Send user",
        "bindings": {
          "mqtt": null
        }
      }
    }
  ]
