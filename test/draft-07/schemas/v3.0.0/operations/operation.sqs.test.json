{
  "target": "http://localhost:8000/draft-07/schemas/v3.0.0/operations/operation.json",
  "tests": [
    {
      "description": "valid: 0.3.0 example #1",
      "valid": true,
      "data": {
        "action": "send",
        "channel": {
          "$ref": "#/channels/users"
        },
        "bindings": {
          "sqs": {
            "queues": [
              {
                "deduplicationScope": "messageGroup",
                "deliveryDelay": 10,
                "fifoQueue": true,
                "fifoThroughputLimit": "perMessageGroupId",
                "name": "myQueue",
                "policy": {
                  "statements": [
                    {
                      "action": [
                        "sqs:SendMessage",
                        "sqs:ReceiveMessage"
                      ],
                      "effect": "Deny",
                      "principal": "arn:aws:iam::123456789012:user/dec.kolakowski",
                      "condition": {
                        "ArnEquals": {
                          "aws:SourceArn": "arn:aws:sns:us-east-1:123456789012:myQueue"
                        }
                      }
                    }
                  ]
                },
                "redrivePolicy": {
                  "deadLetterQueue": {
                    "name": "myQueue_error"
                  },
                  "maxReceiveCount": 15
                }
              },
              {
                "deliveryDelay": 10,
                "name": "myQueue_error"
              }
            ],
            "bindingVersion": "0.3.0"
          }
        }
      }
    },
    {
      "description": "invalid: 0.3.0 missing queues",
      "valid": false,
      "data": {
        "action": "send",
        "channel": {
          "$ref": "#/channels/users"
        },
        "bindings": {
          "sqs": {
            "bindingVersion": "0.3.0"
          }
        }
      }
    },
