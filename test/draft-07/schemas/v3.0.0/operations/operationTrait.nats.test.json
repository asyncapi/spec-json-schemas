{
  "target": "http://localhost:8000/draft-07/schemas/v3.0.0/operations/operationTrait.json",
  "tests": [
    {
      "description": "valid: 0.1.0 example #1",
      "valid": true,
      "data": {
        "title": "Send user",
        "bindings": {
          "nats": {
            "bindingVersion": "0.1.0",
            "queue": "MyCustomQueue"
          }
        }
      }
    },
    {
      "description": "valid: 0.1.0 example #2",
      "valid": true,
      "data": {
        "title": "Send user",
        "bindings": {
          "nats": {
            "bindingVersion": "0.1.0",
            "x-nats-ext": "extension name",
            "queue": "MyCustomQueue"
          }
        }
      }
    },
    {
      "description": "invalid: 0.1.0 invalid queue",
      "valid": false,
      "data": {
        "title": "Send user",
        "bindings": {
          "nats": {
            "queue": 1,
            "bindingVersion": "0.1.0"
          }
        }
      }
    },
    {
      "description": "valid: example without bindingVersion (latest 0.1.0 is used)",
      "valid": true,
      "data": {
        "title": "Send user",
        "bindings": {
          "nats": {
            "queue": "MyCustomQueue"
          }
        }
      }
    },
    {
      "description": "valid: reference",
      "valid": true,
      "data": {
        "title": "Send user",
        "bindings": {
          "nats": {
            "$ref": "#/components/operationBindings/my-nats"
          }
        }
      }
    },
    {
      "description": "invalid: reference with extra property",
      "valid": false,
      "data": {
        "title": "Send user",
        "bindings": {
          "nats": {
            "$ref": "#/components/operationBindings/my-nats",
            "bindingVersion": "0.1.0"
          }
        }
      }
    },
    {
      "description": "invalid: unknown bindingVersion 9.9.9",
      "valid": false,
      "data": {
        "title": "Send user",
        "bindings": {
          "nats": {
            "bindingVersion": "9.9.9"
          }
        }
      }
    },
    {
      "description": "invalid: bindingVersion is a number",
      "valid": false,
      "data": {
        "title": "Send user",
        "bindings": {
          "nats": {
            "bindingVersion": 1
          }
        }
      }
    },
    {
      "description": "invalid: binding is a string",
      "valid": false,
      "data": {
        "title": "Send user",
        "bindings": {
          "nats": "nats"
        }
      }
    },
    {
      "description": "invalid: binding is null",
      "valid": false,
      "data": {
        "title": "Send user",
        "bindings": {
          "nats": null
        }
      }
    }
  ]
}
