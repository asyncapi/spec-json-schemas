      "valid": true,
      "data": {
        "title": "Send user",
        "bindings": {
          "jms": {}
        }
      }
    },
    {
      "description": "valid: reference",
      "valid": true,
      "data": {
        "title": "Send user",
        "bindings": {
          "jms": {
            "$ref": "#/components/operationBindings/my-jms"
          }
        }
      }
    },
    {
      "description": "invalid: reference with extra property",
      "valid": false,
      "data": {
        "title": "Send user",
        "bindings": {
          "jms": {
            "$ref": "#/components/operationBindings/my-jms",
            "bindingVersion": "0.0.1"
          }
        }
      }
    },
    {
      "description": "invalid: unknown bindingVersion 9.9.9",
      "valid": false,
      "data": {
        "title": "Send user",
        "bindings": {
          "jms": {
            "bindingVersion": "9.9.9"
          }
        }
      }
    },
    {
      "description": "invalid: bindingVersion is a number",
      "valid": false,
      "data": {
        "title": "Send user",
        "bindings": {
          "jms": {
            "bindingVersion": 1
          }
        }
      }
    },
    {
      "description": "invalid: binding is a string",
      "valid": false,
      "data": {
        "title": "Send user",
        "bindings": {
          "jms": "jms"
        }
      }
    },
    {
      "description": "invalid: binding is null",
      "valid": false,
      "data": {
        "title": "Send user",
        "bindings": {
          "jms": null
        }
      }
