{
  "target": "http://localhost:8000/draft-07/schemas/v3.0.0/channels/messages/channelMessages.json",
  "tests": [
    {
      "description": "valid: example #1",
      "valid": true,
      "data": {
        "message": {
          "$ref": "#/messages/application-metric.v2"
        }
      }
    },
    {
      "description": "valid: example #2",
      "valid": true,
      "data": {
        "message.v2": {
          "$ref": "#/messages/application-metric.v2"
        },
        "message.v1": {
          "contentType": "application/json",
          "name": "application-metric.v1",
          "title": "Application Metric record v1",
          "summary": "Use it to register single application metric",
          "description": "Represent registrable application metric e.g. number of incoming messages",
          "deprecated": true,
          "examples": [
            {
              "name": "Application metric example",
              "summary": "Message with Correlation ID header and application metric",
              "headers": {
                "correlation-id": "01ed08a1-8a7b-4882-85c5-c6e3815353d5"
              },
              "payload": {
                "metric": "messages.incoming:5921"
              }
            }
          ],
          "traits": [
            {
              "$ref": "#/application-metric.v3.trait"
            },
            {
              "contentType": "application/json",
              "name": "application-metric.v1",
              "title": "Application Metric record v1",
              "summary": "Use it to register single application metric",
              "description": "Represent registrable application metric e.g. number of incoming messages",
              "deprecated": true,
              "examples": [
                {
                  "name": "Application metric example",
                  "summary": "Message with Correlation ID header and application metric",
                  "headers": {
                    "correlation-id": "01ed08a1-8a7b-4882-85c5-c6e3815353d5"
                  },
                  "payload": {
                    "metric": "messages.incoming:5921"
                  }
                }
              ]
            }
          ]
        }
      }
    },
    {
      "description": "valid: empty map",
      "valid": true,
      "data": {}
    },
    {
      "description": "valid: reference",
      "valid": true,
      "data": {
        "a": {
          "$ref": "#/components/messages/a"
        }
      }
    },
    {
      "description": "valid: message",
      "valid": true,
      "data": {
        "a": {
          "payload": {
            "type": "string"
          }
        }
      }
    },
    {
      "description": "valid: any key is accepted (no key pattern)",
      "valid": true,
      "data": {
        "{a}": {
          "payload": {
            "type": "string"
          }
        },
        "a b": {
          "payload": {
            "type": "string"
          }
        }
      }
    },
    {
      "description": "invalid: reference with sibling",
      "valid": false,
      "data": {
        "a": {
          "payload": {
            "type": "string"
          },
          "$ref": "#/components/messages/a"
        }
      }
    },
    {
      "description": "invalid: reference is not a string",
      "valid": false,
      "data": {
        "a": {
          "$ref": 1
        }
      }
    },
    {
      "description": "invalid: invalid message",
      "valid": false,
      "data": {
        "a": {
          "payload": true
        }
      }
    },
    {
      "description": "invalid: value is a string",
      "valid": false,
      "data": {
        "a": "x"
      }
    },
    {
      "description": "invalid: not an object",
      "valid": false,
      "data": [
        {
          "payload": {
            "type": "string"
          }
        }
      ]
    }
  ]
}
