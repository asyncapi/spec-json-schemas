{
  "target": "http://localhost:8000/draft-07/schemas/v3.0.0/channels/messages/channelMessage.json",
  "tests": [
    {
      "description": "valid: 0.1.0 example #1",
      "valid": true,
      "data": {
        "payload": {
          "type": "string"
        },
        "bindings": {
          "amqp1": {
            "bindingVersion": "0.1.0"
          }
        }
      }
    },
    {
      "description": "invalid: 0.1.0 unknown property",
      "valid": false,
      "data": {
        "payload": {
          "type": "string"
        },
        "bindings": {
          "amqp1": {
            "address": "my-queue",
            "bindingVersion": "0.1.0"
          }
        }
      }
    },
    {
      "description": "valid: example without bindingVersion (latest 0.1.0 is used)",
      "valid": true,
      "data": {
        "payload": {
          "type": "string"
        },
        "bindings": {
          "amqp1": {}
        }
      }
    },
    {
      "description": "valid: reference",
      "valid": true,
      "data": {
        "payload": {
          "type": "string"
        },
        "bindings": {
          "amqp1": {
            "$ref": "#/components/messageBindings/my-amqp1"
          }
        }
      }
    },
    {
      "description": "invalid: reference with extra property",
      "valid": false,
      "data": {
        "payload": {
          "type": "string"
        },
        "bindings": {
          "amqp1": {
            "$ref": "#/components/messageBindings/my-amqp1",
            "bindingVersion": "0.1.0"
          }
        }
      }
    },
    {
      "description": "invalid: unknown bindingVersion 9.9.9",
      "valid": false,
      "data": {
        "payload": {
          "type": "string"
        },
        "bindings": {
          "amqp1": {
            "bindingVersion": "9.9.9"
          }
        }
      }
    },
    {
      "description": "invalid: bindingVersion is a number",
      "valid": false,
      "data": {
        "payload": {
          "type": "string"
        },
        "bindings": {
          "amqp1": {
            "bindingVersion": 1
          }
        }
      }
    },
    {
      "description": "invalid: binding is a string",
      "valid": false,
      "data": {
        "payload": {
          "type": "string"
        },
        "bindings": {
          "amqp1": "amqp1"
        }
      }
    },
    {
      "description": "invalid: binding is null",
      "valid": false,
      "data": {
        "payload": {
          "type": "string"
        },
        "bindings": {
          "amqp1": null
        }
      }
    }
  ]
}
