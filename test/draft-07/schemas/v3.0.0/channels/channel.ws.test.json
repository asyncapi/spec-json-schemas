{
  "target": "http://localhost:8000/draft-07/schemas/v3.0.0/channels/channel.json",
  "tests": [
    {
      "description": "valid: 0.1.0 example #1",
      "valid": true,
      "data": {
        "address": "users.{userId}",
        "bindings": {
          "ws": {
            "method": "POST",
            "bindingVersion": "0.1.0"
          }
        }
      }
    },
    {
      "description": "valid: 0.1.0 example #2",
      "valid": true,
      "data": {
        "address": "users.{userId}",
        "bindings": {
          "ws": {
            "method": "GET",
            "bindingVersion": "0.1.0"
          }
        }
      }
    },
    {
      "description": "valid: 0.1.0 example #3",
      "valid": true,
      "data": {
        "address": "users.{userId}",
        "bindings": {
          "ws": {
            "headers": {
              "session-id": {
                "type": "string",
                "format": "uuid"
              }
            },
            "method": "GET",
            "bindingVersion": "0.1.0"
          }
        }
      }
    },
    {
      "description": "valid: 0.1.0 example #4",
      "valid": true,
      "data": {
        "address": "users.{userId}",
        "bindings": {
          "ws": {
            "headers": {
              "$ref": "#/headers"
            },
            "method": "GET",
            "bindingVersion": "0.1.0"
          }
        }
      }
    },
    {
      "description": "valid: 0.1.0 example #5",
      "valid": true,
      "data": {
        "address": "users.{userId}",
        "bindings": {
          "ws": {
            "query": {
              "session-id": {
                "type": "string",
                "format": "uuid"
              }
            },
            "method": "GET",
            "bindingVersion": "0.1.0"
          }
        }
      }
    },
    {
      "description": "valid: 0.1.0 example #6",
      "valid": true,
      "data": {
        "address": "users.{userId}",
        "bindings": {
          "ws": {
            "query": {
              "$ref": "#/query"
            },
            "method": "GET",
            "bindingVersion": "0.1.0"
          }
        }
      }
    },
    {
      "description": "invalid: 0.1.0 invalid method",
      "valid": false,
      "data": {
        "address": "users.{userId}",
        "bindings": {
          "ws": {
            "method": "PUT",
            "bindingVersion": "0.1.0"
          }
        }
      }
    },
    {
      "description": "valid: example without bindingVersion (latest 0.1.0 is used)",
      "valid": true,
      "data": {
        "address": "users.{userId}",
        "bindings": {
          "ws": {
            "method": "POST"
          }
        }
      }
    },
    {
      "description": "valid: reference",
      "valid": true,
      "data": {
        "address": "users.{userId}",
        "bindings": {
          "ws": {
            "$ref": "#/components/channelBindings/my-ws"
          }
        }
      }
    },
    {
      "description": "invalid: reference with extra property",
      "valid": false,
      "data": {
        "address": "users.{userId}",
        "bindings": {
          "ws": {
            "$ref": "#/components/channelBindings/my-ws",
            "bindingVersion": "0.1.0"
          }
        }
      }
    },
    {
      "description": "invalid: unknown bindingVersion 9.9.9",
      "valid": false,
      "data": {
        "address": "users.{userId}",
        "bindings": {
          "ws": {
            "bindingVersion": "9.9.9"
          }
        }
      }
    },
    {
      "description": "invalid: bindingVersion is a number",
      "valid": false,
      "data": {
        "address": "users.{userId}",
        "bindings": {
          "ws": {
            "bindingVersion": 1
          }
        }
      }
    },
    {
      "description": "invalid: binding is a string",
      "valid": false,
      "data": {
        "address": "users.{userId}",
        "bindings": {
          "ws": "ws"
        }
      }
    },
    {
      "description": "invalid: binding is null",
      "valid": false,
      "data": {
        "address": "users.{userId}",
        "bindings": {
          "ws": null
        }
      }
    },
    {
      "description": "invalid: folder name websockets is not a binding key (use ws)",
      "valid": false,
      "data": {
        "address": "users.{userId}",
        "bindings": {
          "websockets": {}
        }
      }
    }
  ]
}
