{
  "target": "http://localhost:8000/draft-07/schemas/v2.2.0/channels/messages/messageTrait.json",
  "tests": [
    {
      "description": "valid: example #1",
      "valid": true,
      "data": {
        "summary": "Action to sign a user up.",
        "description": "A longer description",
        "schemaFormat": "application/vnd.apache.avro+json;version=1.9.0",
        "examples": [
          {
            "name": "SimpleSignup",
            "summary": "A simple UserSignup example message",
            "headers": {
              "correlationId": "my-correlation-id",
              "applicationInstanceId": "myInstanceId"
            },
            "payload": {
              "user": {
                "someUserKey": "someUserValue"
              },
              "signup": {
                "someSignupKey": "someSignupValue"
              }
            }
          }
        ]
      }
    },
    {
      "description": "valid: name only",
      "valid": true,
      "data": {
        "name": "UserSignedUp"
      }
    },
    {
      "description": "invalid: payload is not allowed",
      "valid": false,
      "data": {
        "name": "UserSignedUp",
        "payload": {
          "type": "string"
        }
      }
    },
    {
      "description": "invalid: traits is not allowed",
      "valid": false,
      "data": {
        "name": "UserSignedUp",
        "traits": []
      }
    },
    {
      "description": "invalid: $ref is not allowed",
      "valid": false,
      "data": {
        "name": "UserSignedUp",
        "$ref": "#/components/messageTraits/a"
      }
    },
    {
      "description": "valid: example without payload and headers is accepted (examples items are any object)",
      "valid": true,
      "data": {
        "name": "UserSignedUp",
        "examples": [
          {
            "name": "a"
          }
        ]
      }
    },
    {
      "description": "valid: example with unknown property is accepted (examples items are any object)",
      "valid": true,
      "data": {
        "name": "UserSignedUp",
        "examples": [
          {
            "value": 1
          }
        ]
      }
    },
    {
      "description": "valid: empty object (no required fields)",
      "valid": true,
      "data": {}
    },
    {
      "description": "valid: headers object schema",
      "valid": true,
      "data": {
        "name": "UserSignedUp",
        "headers": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            }
          }
        }
      }
    },
    {
      "description": "valid: headers without type",
      "valid": true,
      "data": {
        "name": "UserSignedUp",
        "headers": {
          "properties": {
            "id": {
              "type": "string"
            }
          }
        }
      }
    },
    {
      "description": "invalid: headers of type string",
      "valid": false,
      "data": {
        "name": "UserSignedUp",
        "headers": {
          "type": "string"
        }
      }
    },
    {
      "description": "invalid: headers is a boolean schema",
      "valid": false,
      "data": {
        "name": "UserSignedUp",
        "headers": true
      }
    },
    {
      "description": "valid: correlationId",
      "valid": true,
      "data": {
        "name": "UserSignedUp",
        "correlationId": {
          "location": "$message.header#/id"
        }
      }
    },
    {
      "description": "valid: correlationId reference",
      "valid": true,
      "data": {
        "name": "UserSignedUp",
        "correlationId": {
          "$ref": "#/components/correlationIds/id"
        }
      }
    },
    {
      "description": "invalid: correlationId without location",
      "valid": false,
      "data": {
        "name": "UserSignedUp",
        "correlationId": {
          "description": "id"
        }
      }
    },
    {
      "description": "valid: examples",
      "valid": true,
      "data": {
        "name": "UserSignedUp",
        "examples": [
          {
            "payload": "x"
          }
        ]
      }
    },
    {
      "description": "invalid: examples is an object",
      "valid": false,
      "data": {
        "name": "UserSignedUp",
        "examples": {
          "payload": "x"
        }
      }
    },
    {
      "description": "invalid: deprecated is a string",
      "valid": false,
      "data": {
        "name": "UserSignedUp",
        "deprecated": "true"
      }
    },
    {
      "description": "invalid: schemaFormat is not a string",
      "valid": false,
      "data": {
        "name": "UserSignedUp",
        "schemaFormat": 1
      }
    },
    {
      "description": "invalid: contentType is not a string",
      "valid": false,
      "data": {
        "name": "UserSignedUp",
        "contentType": 1
      }
    },
    {
      "description": "invalid: summary is not a string",
      "valid": false,
      "data": {
        "name": "UserSignedUp",
        "summary": 1
      }
    },
    {
      "description": "invalid: name is not a string",
      "valid": false,
      "data": {
        "name": 1
      }
    },
    {
      "description": "invalid: title is not a string",
      "valid": false,
      "data": {
        "name": "UserSignedUp",
        "title": 1
      }
    },
    {
      "description": "invalid: description is not a string",
      "valid": false,
      "data": {
        "name": "UserSignedUp",
        "description": 1
      }
    },
    {
      "description": "invalid: messageId is not available in 2.2.0 (added in 2.4.0)",
      "valid": false,
      "data": {
        "name": "UserSignedUp",
        "messageId": "userSignedUp"
      }
    },
    {
      "description": "valid: tags",
      "valid": true,
      "data": {
        "name": "UserSignedUp",
        "tags": [
          {
            "name": "a"
          },
          {
            "name": "b"
          }
        ]
      }
    },
    {
      "description": "invalid: duplicated tags",
      "valid": false,
      "data": {
        "name": "UserSignedUp",
        "tags": [
          {
            "name": "a"
          },
          {
            "name": "a"
          }
        ]
      }
    },
    {
      "description": "invalid: tag without name",
      "valid": false,
      "data": {
        "name": "UserSignedUp",
        "tags": [
          {
            "description": "a"
          }
        ]
      }
    },
    {
      "description": "invalid: tag reference (added in v3)",
      "valid": false,
      "data": {
        "name": "UserSignedUp",
        "tags": [
          {
            "$ref": "#/components/tags/a"
          }
        ]
      }
    },
    {
      "description": "valid: externalDocs",
      "valid": true,
      "data": {
        "name": "UserSignedUp",
        "externalDocs": {
          "url": "https://docs.lo"
        }
      }
    },
    {
      "description": "invalid: externalDocs without url",
      "valid": false,
      "data": {
        "name": "UserSignedUp",
        "externalDocs": {
          "description": "d"
        }
      }
    },
    {
      "description": "invalid: externalDocs reference (added in v3)",
      "valid": false,
      "data": {
        "name": "UserSignedUp",
        "externalDocs": {
          "$ref": "#/components/externalDocs/a"
        }
      }
    },
    {
      "description": "valid: empty bindings",
      "valid": true,
      "data": {
        "name": "UserSignedUp",
        "bindings": {}
      }
    },
    {
      "description": "valid: binding reference per protocol",
      "valid": true,
      "data": {
        "name": "UserSignedUp",
        "bindings": {
          "kafka": {
            "$ref": "#/components/bindings/a"
          }
        }
      }
    },
    {
      "description": "invalid: known protocol with unknown bindingVersion",
      "valid": false,
      "data": {
        "name": "UserSignedUp",
        "bindings": {
          "kafka": {
            "bindingVersion": "9.9.9"
          }
        }
      }
    },
    {
      "description": "valid: unknown protocol is accepted unvalidated (map has additionalProperties: true)",
      "valid": true,
      "data": {
        "name": "UserSignedUp",
        "bindings": {
          "unknown": 1
        }
      }
    },
    {
      "description": "valid: ros2 is accepted unvalidated (not in the v2 map)",
      "valid": true,
      "data": {
        "name": "UserSignedUp",
        "bindings": {
          "ros2": {
            "bindingVersion": "9.9.9"
          }
        }
      }
    },
    {
      "description": "invalid: bindings is an array",
      "valid": false,
      "data": {
        "name": "UserSignedUp",
        "bindings": []
      }
    },
    {
      "description": "valid: googlepubsub is accepted unvalidated in 2.2.0 (added to the map in 2.6.0)",
      "valid": true,
      "data": {
        "name": "UserSignedUp",
        "bindings": {
          "googlepubsub": {
            "bindingVersion": "9.9.9"
          }
        }
      }
    },
    {
      "description": "valid: x- extension in bindings",
      "valid": true,
      "data": {
        "name": "UserSignedUp",
        "bindings": {
          "x-custom": 1
        }
      }
    },
    {
      "description": "valid: with x- extension",
      "valid": true,
      "data": {
        "name": "UserSignedUp",
        "x-owner": "team"
      }
    },
    {
      "description": "invalid: x- without name",
      "valid": false,
      "data": {
        "name": "UserSignedUp",
        "x-": "team"
      }
    },
    {
      "description": "invalid: not an object",
      "valid": false,
      "data": "x"
    },
    {
      "description": "invalid: array",
      "valid": false,
      "data": [
        {
          "name": "UserSignedUp"
        }
      ]
    },
    {
      "description": "invalid: null",
      "valid": false,
      "data": null
    },
    {
      "description": "invalid: unknown property",
      "valid": false,
      "data": {
        "name": "UserSignedUp",
        "action": "x"
      }
    }
  ]
}
