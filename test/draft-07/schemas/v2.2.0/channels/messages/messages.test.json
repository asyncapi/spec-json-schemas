{
  "target": "http://localhost:8000/draft-07/schemas/v2.2.0/channels/messages/messages.json",
  "tests": [
    {
      "description": "valid: example #1",
      "valid": true,
      "data": {
        "userSignup": {
          "$ref": "#/components/messages/userSignup"
        }
      }
    },
    {
      "description": "valid: example #2",
      "valid": true,
      "data": {
        "userSignup": {
          "name": "UserSignup",
          "title": "User signup",
          "summary": "Action to sign a user up.",
          "description": "A longer description",
          "tags": [
            {
              "name": "user"
            },
            {
              "name": "signup"
            },
            {
              "name": "register"
            }
          ],
          "payload": {
            "$ref": "path/to/user-create.avsc#/UserCreate"
          }
        }
      }
    },
    {
      "description": "valid: empty map",
      "valid": true,
      "data": {}
    },
    {
      "description": "valid: message",
      "valid": true,
      "data": {
        "a": {
          "payload": {
            "type": "string"
          }
        }
      }
    },
    {
      "description": "valid: reference",
      "valid": true,
      "data": {
        "a": {
          "$ref": "#/components/messages/a"
        }
      }
    },
    {
      "description": "valid: any key is accepted (no key pattern)",
      "valid": true,
      "data": {
        "a b": {
          "payload": {
            "type": "string"
          }
        }
      }
    },
    {
      "description": "invalid: invalid message",
      "valid": false,
      "data": {
        "a": {
          "payload": true
        }
      }
    },
    {
      "description": "invalid: message is a string",
      "valid": false,
      "data": {
        "a": "x"
      }
    },
    {
      "description": "invalid: not an object",
      "valid": false,
      "data": [
        {
          "payload": {
            "type": "string"
          }
        }
      ]
    }
  ]
}
