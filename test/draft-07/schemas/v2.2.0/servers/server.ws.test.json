{
  "target": "http://localhost:8000/draft-07/schemas/v2.2.0/servers/server.json",
  "tests": [
    {
      "description": "valid: 0.1.0 example #1",
      "valid": true,
      "data": {
        "url": "broker.mycompany.com:5672",
        "protocol": "ws",
        "bindings": {
          "ws": {
            "bindingVersion": "0.1.0"
          }
        }
      }
    },
    {
      "description": "invalid: 0.1.0 unknown property",
      "valid": false,
      "data": {
        "url": "broker.mycompany.com:5672",
        "protocol": "ws",
        "bindings": {
          "ws": {
            "method": "GET",
            "bindingVersion": "0.1.0"
          }
        }
      }
    },
    {
      "description": "valid: example without bindingVersion (latest 0.1.0 is used)",
      "valid": true,
      "data": {
        "url": "broker.mycompany.com:5672",
        "protocol": "ws",
        "bindings": {
          "ws": {}
        }
      }
    },
    {
      "description": "valid: reference",
      "valid": true,
      "data": {
        "url": "broker.mycompany.com:5672",
        "protocol": "ws",
        "bindings": {
          "ws": {
            "$ref": "#/components/serverBindings/my-ws"
          }
        }
      }
    },
    {
      "description": "invalid: reference with extra property",
      "valid": false,
      "data": {
        "url": "broker.mycompany.com:5672",
        "protocol": "ws",
        "bindings": {
          "ws": {
            "$ref": "#/components/serverBindings/my-ws",
            "bindingVersion": "0.1.0"
          }
        }
      }
    },
    {
      "description": "invalid: unknown bindingVersion 9.9.9",
      "valid": false,
      "data": {
        "url": "broker.mycompany.com:5672",
        "protocol": "ws",
        "bindings": {
          "ws": {
            "bindingVersion": "9.9.9"
          }
        }
      }
    },
    {
      "description": "invalid: bindingVersion is a number",
      "valid": false,
      "data": {
        "url": "broker.mycompany.com:5672",
        "protocol": "ws",
        "bindings": {
          "ws": {
            "bindingVersion": 1
          }
        }
      }
    },
    {
      "description": "invalid: binding is a string",
      "valid": false,
      "data": {
        "url": "broker.mycompany.com:5672",
        "protocol": "ws",
        "bindings": {
          "ws": "ws"
        }
      }
    },
    {
      "description": "invalid: binding is null",
      "valid": false,
      "data": {
        "url": "broker.mycompany.com:5672",
        "protocol": "ws",
        "bindings": {
          "ws": null
        }
      }
    },
    {
      "description": "valid: folder name websockets is accepted unvalidated (open map, the key is ws)",
      "valid": true,
      "data": {
        "url": "broker.mycompany.com:5672",
        "protocol": "ws",
        "bindings": {
          "websockets": {
            "bindingVersion": "9.9.9"
          }
        }
      }
    }
  ]
}
