{
  "target": "http://localhost:8000/draft-07/schemas/v2.2.0/servers/server.json",
  "tests": [
    {
      "description": "valid: 0.2.0 example #1",
      "valid": true,
      "data": {
        "url": "broker.mycompany.com:5672",
        "protocol": "mqtt5",
        "bindings": {
          "mqtt5": {
            "bindingVersion": "0.2.0",
            "sessionExpiryInterval": 60
          }
        }
      }
    },
    {
      "description": "valid: 0.2.0 example #2",
      "valid": true,
      "data": {
        "url": "broker.mycompany.com:5672",
        "protocol": "mqtt5",
        "bindings": {
          "mqtt5": {
            "bindingVersion": "0.2.0",
            "sessionExpiryInterval": {
              "type": "integer",
              "minimum": 100
            }
          }
        }
      }
    },
    {
      "description": "valid: 0.2.0 example #3",
      "valid": true,
      "data": {
        "url": "broker.mycompany.com:5672",
        "protocol": "mqtt5",
        "bindings": {
          "mqtt5": {
            "bindingVersion": "0.2.0",
            "sessionExpiryInterval": {
              "$ref": "#/sessionExpiryInterval"
            }
          }
        }
      }
    },
    {
      "description": "invalid: 0.2.0 invalid sessionExpiryInterval",
      "valid": false,
      "data": {
        "url": "broker.mycompany.com:5672",
        "protocol": "mqtt5",
        "bindings": {
          "mqtt5": {
            "sessionExpiryInterval": -1,
            "bindingVersion": "0.2.0"
          }
        }
      }
    },
    {
      "description": "valid: 0.1.0 example #1",
      "valid": true,
      "data": {
        "url": "broker.mycompany.com:5672",
        "protocol": "mqtt5",
        "bindings": {
          "mqtt5": {
            "bindingVersion": "0.1.0"
          }
        }
      }
    },
    {
      "description": "invalid: 0.1.0 sessionExpiryInterval is only defined from 0.2.0",
      "valid": false,
      "data": {
        "url": "broker.mycompany.com:5672",
        "protocol": "mqtt5",
        "bindings": {
          "mqtt5": {
            "sessionExpiryInterval": 60,
            "bindingVersion": "0.1.0"
          }
        }
      }
    },
    {
      "description": "valid: example without bindingVersion (latest 0.2.0 is used)",
      "valid": true,
      "data": {
        "url": "broker.mycompany.com:5672",
        "protocol": "mqtt5",
        "bindings": {
          "mqtt5": {
            "sessionExpiryInterval": 60
          }
        }
      }
    },
    {
      "description": "valid: reference",
      "valid": true,
      "data": {
        "url": "broker.mycompany.com:5672",
        "protocol": "mqtt5",
        "bindings": {
          "mqtt5": {
            "$ref": "#/components/serverBindings/my-mqtt5"
          }
        }
      }
    },
    {
      "description": "invalid: reference with extra property",
      "valid": false,
      "data": {
        "url": "broker.mycompany.com:5672",
        "protocol": "mqtt5",
        "bindings": {
          "mqtt5": {
            "$ref": "#/components/serverBindings/my-mqtt5",
            "bindingVersion": "0.2.0"
          }
        }
      }
    },
    {
      "description": "invalid: unknown bindingVersion 9.9.9",
      "valid": false,
      "data": {
        "url": "broker.mycompany.com:5672",
        "protocol": "mqtt5",
        "bindings": {
          "mqtt5": {
            "bindingVersion": "9.9.9"
          }
        }
      }
    },
    {
      "description": "invalid: bindingVersion is a number",
      "valid": false,
      "data": {
        "url": "broker.mycompany.com:5672",
        "protocol": "mqtt5",
        "bindings": {
          "mqtt5": {
            "bindingVersion": 1
          }
        }
      }
    },
    {
      "description": "invalid: binding is a string",
      "valid": false,
      "data": {
        "url": "broker.mycompany.com:5672",
        "protocol": "mqtt5",
        "bindings": {
          "mqtt5": "mqtt5"
        }
      }
    },
    {
      "description": "invalid: binding is null",
      "valid": false,
      "data": {
        "url": "broker.mycompany.com:5672",
        "protocol": "mqtt5",
        "bindings": {
          "mqtt5": null
        }
      }
    }
  ]
}
