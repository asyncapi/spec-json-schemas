{
  "target": "http://localhost:8000/draft-07/schemas/v2.3.0/channels/messages/message.json",
  "tests": [
    {
      "description": "valid: 0.2.0 example #1",
      "valid": true,
      "data": {
        "payload": {
          "type": "string"
        },
        "bindings": {
          "sns": {
            "bindingVersion": "0.2.0"
          }
        }
      }
    },
    {
      "description": "valid: 0.2.0 example #2",
      "valid": true,
      "data": {
        "payload": {
          "type": "string"
        },
        "bindings": {
          "sns": {
            "bindingVersion": "0.2.0"
          }
        }
      }
    },
    {
      "description": "invalid: 0.2.0 unknown property",
      "valid": false,
      "data": {
        "payload": {
          "type": "string"
        },
        "bindings": {
          "sns": {
            "name": "my-sns-topic",
            "bindingVersion": "0.2.0"
          }
        }
      }
    },
    {
      "description": "valid: 0.1.0 example #1",
      "valid": true,
      "data": {
        "payload": {
          "type": "string"
        },
        "bindings": {
          "sns": {
            "bindingVersion": "0.1.0"
          }
        }
      }
    },
    {
      "description": "valid: 0.1.0 example #2",
      "valid": true,
      "data": {
        "payload": {
          "type": "string"
        },
        "bindings": {
          "sns": {
            "bindingVersion": "0.1.0"
          }
        }
      }
    },
    {
      "description": "invalid: 0.1.0 unknown property",
      "valid": false,
      "data": {
        "payload": {
          "type": "string"
        },
        "bindings": {
          "sns": {
            "name": "my-sns-topic",
            "bindingVersion": "0.1.0"
          }
        }
      }
    },
    {
      "description": "valid: example without bindingVersion (latest 0.2.0 is used)",
      "valid": true,
      "data": {
        "payload": {
          "type": "string"
        },
        "bindings": {
          "sns": {}
        }
      }
    },
    {
      "description": "valid: reference",
      "valid": true,
      "data": {
        "payload": {
          "type": "string"
        },
        "bindings": {
          "sns": {
            "$ref": "#/components/messageBindings/my-sns"
          }
        }
      }
    },
    {
      "description": "invalid: reference with extra property",
      "valid": false,
      "data": {
        "payload": {
          "type": "string"
        },
        "bindings": {
          "sns": {
            "$ref": "#/components/messageBindings/my-sns",
            "bindingVersion": "0.2.0"
          }
        }
      }
    },
    {
      "description": "invalid: unknown bindingVersion 9.9.9",
      "valid": false,
      "data": {
        "payload": {
          "type": "string"
        },
        "bindings": {
          "sns": {
            "bindingVersion": "9.9.9"
          }
        }
      }
    },
    {
      "description": "invalid: bindingVersion is a number",
      "valid": false,
      "data": {
        "payload": {
          "type": "string"
        },
        "bindings": {
          "sns": {
            "bindingVersion": 1
          }
        }
      }
    },
    {
      "description": "invalid: binding is a string",
      "valid": false,
      "data": {
        "payload": {
          "type": "string"
        },
        "bindings": {
          "sns": "sns"
        }
      }
    },
    {
      "description": "invalid: binding is null",
      "valid": false,
      "data": {
        "payload": {
          "type": "string"
        },
        "bindings": {
          "sns": null
        }
      }
    },
    {
      "description": "valid: folder name amazon-sns is accepted unvalidated (open map, the key is sns)",
      "valid": true,
      "data": {
        "payload": {
          "type": "string"
        },
        "bindings": {
          "amazon-sns": {
            "bindingVersion": "9.9.9"
          }
        }
      }
    }
  ]
}
