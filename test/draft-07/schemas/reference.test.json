    {
      "description": "invalid: space in reference",
      "valid": false,
      "data": {
        "$ref": "./my schemas/user.json"
      }
    },
    {
      "description": "invalid: unencoded curly braces",
      "valid": false,
      "data": {
        "$ref": "#/channels/users/{userId}"
      }
    },
    {
      "description": "invalid: windows path with backslashes",
      "valid": false,
      "data": {
        "$ref": "..\\schemas\\user.json"
      }
    },
    {
      "description": "invalid: $ref is a number",
      "valid": false,
      "data": {
        "$ref": 1
      }
    },
    {
      "description": "invalid: $ref is an object",
      "valid": false,
      "data": {
        "$ref": {
          "$ref": "#/a"
        }
      }
    },
    {
      "description": "invalid: $ref is null",
      "valid": false,
      "data": {
        "$ref": null
      }
    },
    {
      "description": "invalid: missing $ref",
      "valid": false,
      "data": {}
    },
    {
      "description": "invalid: extra property",
      "valid": false,
      "data": {
        "$ref": "#/a",
        "description": "user"
      }
    },
    {
      "description": "invalid: x- extension is not allowed",
      "valid": false,
      "data": {
        "$ref": "#/a",
        "x-owner": "team"
      }
    },
    {
      "description": "invalid: not an object",
      "valid": false,
      "data": "#/components/schemas/user"
    },
    {
      "description": "invalid: array",
      "valid": false,
      "data": [
        {
          "$ref": "#/a"
        }
      ]
    }
  ]
