{
  "target": "http://localhost:8000/draft-07/schemas/v2.5.0/channels/parameters.json",
  "tests": [
    {
      "description": "valid: example #1",
      "valid": true,
      "data": {
        "accessToken": {
          "$ref": "#/parameters/accessToken"
        }
      }
    },
    {
      "description": "valid: example #2",
      "valid": true,
      "data": {
        "userId": {
          "description": "Id of the user",
          "schema": {
            "type": "string"
          },
          "location": "$message.payload#/user/id"
        }
      }
    },
    {
      "description": "valid: empty map",
      "valid": true,
      "data": {}
    },
    {
      "description": "valid: parameter",
      "valid": true,
      "data": {
        "userId": {
          "schema": {
            "type": "string"
          }
        }
      }
    },
    {
      "description": "valid: reference",
      "valid": true,
      "data": {
        "userId": {
          "$ref": "#/components/parameters/userId"
        }
      }
    },
    {
      "description": "invalid: reference with sibling",
      "valid": false,
      "data": {
        "userId": {
          "$ref": "#/components/parameters/userId",
          "description": "x"
        }
      }
    },
    {
      "description": "invalid: parameter with invalid schema",
      "valid": false,
      "data": {
        "userId": {
          "schema": {
            "type": "map"
          }
        }
      }
    },
    {
      "description": "invalid: parameter with unknown property",
      "valid": false,
      "data": {
        "userId": {
          "enum": [
            "a"
          ]
        }
      }
    },
    {
      "description": "invalid: not an object",
      "valid": false,
      "data": [
        {
          "schema": {
            "type": "string"
          }
        }
      ]
    }
  ]
}
