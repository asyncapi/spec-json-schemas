{
  "target": "http://localhost:8000/draft-07/schemas/v2.5.0/channels/messages/message.json",
  "tests": [
    {
      "description": "valid: 0.3.0 example #1",
      "valid": true,
      "data": {
        "payload": {
          "type": "string"
        },
        "bindings": {
          "http": {
            "bindingVersion": "0.3.0",
            "headers": {
              "type": "object",
              "properties": {
                "Content-Type": {
                  "type": "string",
                  "enum": [
                    "application/json"
                  ]
                }
              }
            },
            "statusCode": 200
          }
        }
      }
    },
