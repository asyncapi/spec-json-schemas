      "description": "valid: 0.2.0 example #1",
      "valid": true,
      "data": {
        "operationId": "sendUser",
        "bindings": {
          "sns": {
            "consumers": [
              {
                "endpoint": {
                  "name": "someQueue"
                },
                "protocol": "sqs",
                "rawMessageDelivery": false
              }
            ],
            "topic": {
              "name": "someTopic"
            },
            "bindingVersion": "0.2.0"
          }
        }
      }
    },
    {
      "description": "valid: 0.2.0 example #2",
      "valid": true,
      "data": {
        "operationId": "sendUser",
        "bindings": {
          "sns": {
            "consumers": [
              {
                "deliveryPolicy": {
                  "backoffFunction": "linear",
                  "maxDelayTarget": 100,
                  "maxReceivesPerSecond": 2,
                  "minDelayTarget": 10,
                  "numMaxDelayRetries": 5,
                  "numMinDelayRetries": 3,
                  "numNoDelayRetries": 2,
                  "numRetries": 5
                },
                "endpoint": {
                  "name": "someQueue"
                },
                "filterPolicy": {
                  "customer_interests": [
                    "rugby",
                    "football",
                    "baseball"
                  ],
                  "event": {
                    "anything-but": "order_cancelled"
                  },
                  "event_name": "order_cancelled",
                  "store": [
                    "asyncapi_corp"
                  ]
                },
                "filterPolicyScope": "MessageAttributes",
                "protocol": "sqs",
                "rawMessageDelivery": false,
                "redrivePolicy": {
                  "deadLetterQueue": {
                    "arn": "arn:aws:SQS:eu-west-1:0000000:123456789"
                  },
                  "maxReceiveCount": 25
                }
              }
            ],
            "topic": {
              "name": "someTopic"
            },
            "bindingVersion": "0.2.0"
          }
        }
      }
    },
