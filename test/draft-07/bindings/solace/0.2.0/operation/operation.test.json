              "name": "sampleQueue",
              "topicSubscriptions": [
                "samples/*"
              ]
            }
          },
          {
            "destinationType": "topic",
            "topicSubscriptions": [
              "samples/*"
            ]
          }
        ]
      }
    },
    {
      "description": "valid: empty object",
      "valid": true,
      "data": {}
    },
    {
      "description": "valid: empty destinations",
      "valid": true,
      "data": {
        "destinations": []
      }
    },
    {
      "description": "valid: queue and topic destinations",
      "valid": true,
      "data": {
        "destinations": [
          {
            "destinationType": "queue",
            "queue": {
              "accessType": "nonexclusive",
              "name": "sampleQueue",
              "topicSubscriptions": [
                "samples/*"
              ]
            }
          },
          {
            "destinationType": "topic",
            "topicSubscriptions": [
              "samples/*"
            ]
          }
        ]
      }
    },
    {
      "description": "valid: with x- extension",
      "valid": true,
      "data": {
        "destinations": [
          {
            "destinationType": "topic",
            "topicSubscriptions": [
              "samples/*"
            ]
          }
        ],
        "x-owner": "team"
      }
    },
    {
      "description": "invalid: destinations is not an array",
      "valid": false,
      "data": {
        "destinations": {
          "destinationType": "queue",
          "queue": {
            "accessType": "nonexclusive",
            "name": "sampleQueue",
            "topicSubscriptions": [
              "samples/*"
            ]
          }
        }
      }
    },
    {
      "description": "invalid: invalid destination",
      "valid": false,
      "data": {
        "destinations": [
          {
            "destinationType": "stream"
          }
        ]
      }
    },
    {
      "description": "invalid: unsupported binding version",
      "valid": false,
      "data": {
        "bindingVersion": "0.5.0"
      }
    },
    {
