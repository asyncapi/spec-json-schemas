{
  "target": "http://localhost:8000/draft-07/bindings/http/0.3.0/message.json",
  "tests": [
    {
      "description": "valid: example #1",
      "valid": true,
      "data": {
        "bindingVersion": "0.3.0",
        "headers": {
          "type": "object",
          "properties": {
            "Content-Type": {
              "type": "string",
              "enum": [
                "application/json"
              ]
            }
          }
        },
        "statusCode": 200
      }
    },
    {
      "description": "valid: example #2",
      "valid": true,
      "data": {
        "bindingVersion": "0.3.0",
        "headers": {
          "$ref": "#/headers/json-content-type"
        },
        "statusCode": 200
      }
    },
    {
      "description": "valid: empty object",
      "valid": true,
      "data": {}
    },
    {
      "description": "valid: headers only",
      "valid": true,
      "data": {
        "headers": {
          "type": "object",
          "properties": {
            "Content-Type": {
              "type": "string",
              "enum": [
                "application/json"
              ]
            }
          }
        }
      }
    },
    {
      "description": "valid: with x- extension",
      "valid": true,
      "data": {
        "headers": {
          "type": "object",
          "properties": {
            "Content-Type": {
              "type": "string",
              "enum": [
                "application/json"
              ]
            }
          }
        },
        "x-owner": "team"
      }
    },
    {
      "description": "invalid: invalid headers",
      "valid": false,
      "data": {
        "headers": "Content-Type"
      }
    },
    {
      "description": "invalid: unsupported binding version",
      "valid": false,
      "data": {
        "bindingVersion": "0.4.0"
      }
    },
    {
      "description": "invalid: unknown property",
      "valid": false,
      "data": {
        "headers": {
          "type": "object",
          "properties": {
            "Content-Type": {
              "type": "string",
              "enum": [
                "application/json"
              ]
            }
          }
        },
        "method": "GET"
      }
    },
    {
      "description": "invalid: not an object",
      "valid": false,
      "data": "Content-Type"
    },
    {
      "description": "valid: statusCode",
      "valid": true,
      "data": {
        "statusCode": 404
      }
    },
    {
      "description": "invalid: statusCode is a string",
      "valid": false,
      "data": {
        "statusCode": "200"
      }
    }
  ]
}
