{
  "target": "http://localhost:8000/draft-07/bindings/http/operationBindingOrReference.json",
  "tests": [
    {
      "description": "valid: example #1",
      "valid": true,
      "data": {
        "$ref": "#/bindings/http/my-http-operation"
      }
    },
    {
      "description": "valid: example #2",
      "valid": true,
      "data": {
        "bindingVersion": "0.3.0",
        "method": "GET",
        "query": {
          "type": "object",
          "required": [
            "companyId"
          ],
          "properties": {
            "companyId": {
              "description": "The Id of the company.",
              "type": "number",
              "minimum": 1
            }
          },
          "additionalProperties": false
        }
      }
    },
    {
      "description": "valid: local reference",
      "valid": true,
      "data": {
        "$ref": "#/bindings/http/my-http-channel"
      }
    },
    {
      "description": "valid: external reference",
      "valid": true,
      "data": {
        "$ref": "https://example.com/bindings.json#/http"
      }
    },
    {
      "description": "valid: inline binding",
      "valid": true,
      "data": {
        "method": "GET"
      }
    },
    {
      "description": "invalid: reference with extra property",
      "valid": false,
      "data": {
        "$ref": "#/bindings/http/my-http-channel",
        "bindingVersion": "0.3.0"
      }
    },
    {
      "description": "invalid: reference is not a string",
      "valid": false,
      "data": {
        "$ref": 1
      }
    },
    {
      "description": "invalid: invalid inline binding",
      "valid": false,
      "data": {
        "type": "request",
        "method": "GET"
      }
    },
    {
      "description": "invalid: not an object",
      "valid": false,
      "data": "#/bindings/http/my-http-channel"
    }
  ]
}
