{
  "target": "http://localhost:8000/draft-07/bindings/apache-kafka/serverBinding.json",
  "tests": [
    {
      "description": "valid: example #1",
      "valid": true,
      "data": {
        "bindingVersion": "0.1.0"
      }
    },
    {
      "description": "valid: example #2",
      "valid": true,
      "data": {
        "bindingVersion": "0.3.0",
        "schemaRegistryUrl": "https://my-schema-registry.com",
        "schemaRegistryVendor": "confluent"
      }
    },
    {
      "description": "valid: example #3",
      "valid": true,
      "data": {
        "bindingVersion": "0.4.0",
        "schemaRegistryUrl": "https://my-schema-registry.com",
        "schemaRegistryVendor": "confluent"
      }
    },
    {
      "description": "valid: example #4",
      "valid": true,
      "data": {
        "bindingVersion": "0.5.0",
        "schemaRegistryUrl": "https://my-schema-registry.com",
        "schemaRegistryVendor": "confluent"
      }
    },
    {
      "description": "valid: empty object uses 0.5.0",
      "valid": true,
      "data": {}
    },
    {
      "description": "invalid: schemaRegistryUrl with 0.1.0",
      "valid": false,
      "data": {
        "bindingVersion": "0.1.0",
        "schemaRegistryUrl": "https://my-schema-registry.com"
      }
    },
    {
      "description": "valid: schemaRegistryUrl with 0.3.0",
      "valid": true,
      "data": {
        "bindingVersion": "0.3.0",
        "schemaRegistryUrl": "https://my-schema-registry.com"
      }
    },
    {
      "description": "valid: schemaRegistryUrl with 0.4.0",
      "valid": true,
      "data": {
        "bindingVersion": "0.4.0",
        "schemaRegistryUrl": "https://my-schema-registry.com"
      }
    },
    {
      "description": "valid: schemaRegistryUrl with 0.5.0",
      "valid": true,
      "data": {
        "bindingVersion": "0.5.0",
        "schemaRegistryUrl": "https://my-schema-registry.com"
      }
    },
    {
      "description": "invalid: unknown property without bindingVersion uses 0.5.0",
      "valid": false,
      "data": {
        "bootstrapServers": "localhost:9092"
      }
    },
    {
      "description": "valid: bindingVersion 0.2.0 matches no branch, so nothing is validated (0.2.0 is in the fallback enum)",
      "valid": true,
      "data": {
        "bindingVersion": "0.2.0",
        "bootstrapServers": 1
      }
    },
    {
      "description": "invalid: unknown bindingVersion falls back to 0.5.0 and fails its enum",
      "valid": false,
      "data": {
        "bindingVersion": "0.6.0"
      }
    },
    {
      "description": "invalid: not an object",
      "valid": false,
      "data": "latest"
    }
  ]
}
