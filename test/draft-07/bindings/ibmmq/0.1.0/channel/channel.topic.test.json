{
  "target": "http://localhost:8000/draft-07/bindings/ibmmq/0.1.0/channel.json#/properties/topic",
  "tests": [
    {
      "description": "valid: all properties",
      "valid": true,
      "data": {
        "objectName": "myTopicName",
        "string": "key",
        "durablePermitted": true,
        "lastMsgRetained": false
      }
    },
    {
      "description": "valid: empty object (no required properties)",
      "valid": true,
      "data": {}
    },
    {
      "description": "valid: objectName of 48 characters",
      "valid": true,
      "data": {
        "objectName": "TTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTT"
      }
    },
    {
      "description": "valid: string of 10240 characters",
      "valid": true,
      "data": {
        "string": ""
      }
    },
    {
      "description": "valid: unknown property is not validated (no additionalProperties)",
      "valid": true,
      "data": {
        "objectName": "myTopicName",
        "string": "key",
        "subscriptionName": "sub"
      }
    },
    {
      "description": "invalid: objectName longer than 48 characters",
      "valid": false,
      "data": {
        "objectName": "TTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTT"
      }
    },
    {
      "description": "invalid: string longer than 10240 characters",
      "valid": false,
      "data": {
        "string": ""
      }
    },
    {
      "description": "invalid: durablePermitted is not a boolean",
      "valid": false,
      "data": {
        "durablePermitted": "yes"
      }
    },
    {
      "description": "invalid: lastMsgRetained is not a boolean",
      "valid": false,
      "data": {
        "lastMsgRetained": 0
      }
    },
    {
      "description": "invalid: not an object",
      "valid": false,
      "data": "myTopicName"
    }
  ]
}
