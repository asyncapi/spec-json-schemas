{
  "target": "http://localhost:8000/draft-07/bindings/ibmmq/channelBindingOrReference.json",
  "tests": [
    {
      "description": "valid: example #1",
      "valid": true,
      "data": {
        "$ref": "#/bindings/ibmmq/my-ibmmq-queue"
      }
    },
    {
      "description": "valid: example #2",
      "valid": true,
      "data": {
        "bindingVersion": "0.1.0",
        "destinationType": "topic",
        "topic": {
          "durablePermitted": true,
          "lastMsgRetained": false,
          "objectName": "myTopicName",
          "string": "key"
        }
      }
    },
    {
      "description": "valid: local reference",
      "valid": true,
      "data": {
        "$ref": "#/bindings/ibmmq/my-ibmmq-channel"
      }
    },
    {
      "description": "valid: external reference",
      "valid": true,
      "data": {
        "$ref": "https://example.com/bindings.json#/ibmmq"
      }
    },
    {
      "description": "valid: inline binding",
      "valid": true,
      "data": {
        "destinationType": "queue",
        "queue": {
          "objectName": "myQueueName"
        }
      }
    },
    {
      "description": "invalid: reference with extra property",
      "valid": false,
      "data": {
        "$ref": "#/bindings/ibmmq/my-ibmmq-channel",
        "bindingVersion": "0.1.0"
      }
    },
    {
      "description": "invalid: reference is not a string",
      "valid": false,
      "data": {
        "$ref": 1
      }
    },
    {
      "description": "invalid: invalid inline binding",
      "valid": false,
      "data": {
        "destinationType": "queue"
      }
    },
    {
      "description": "invalid: not an object",
      "valid": false,
      "data": "#/bindings/ibmmq/my-ibmmq-channel"
    }
  ]
}
