{
  "target": "http://localhost:8000/draft-07/bindings/amazon-sqs/0.2.0/operation.json#/definitions/identifier",
  "tests": [
    {
      "description": "valid: empty object (no required properties)",
      "valid": true,
      "data": {}
    },
    {
      "description": "valid: arn",
      "valid": true,
      "data": {
        "arn": "arn:aws:sqs:eu-west-1:123456789012:myQueue"
      }
    },
    {
      "description": "valid: name",
      "valid": true,
      "data": {
        "name": "myQueue_error"
      }
    },
    {
      "description": "valid: arn and name",
      "valid": true,
      "data": {
        "arn": "arn:aws:sqs:eu-west-1:123456789012:myQueue",
        "name": "myQueue_error"
      }
    },
    {
      "description": "valid: with x- extension",
      "valid": true,
      "data": {
        "name": "myQueue_error",
        "x-region": "eu-west-1"
      }
    },
    {
      "description": "valid: unknown property is not validated (no additionalProperties)",
      "valid": true,
      "data": {
        "url": "https://sqs.eu-west-1.amazonaws.com/123456789012/myQueue"
      }
    },
    {
      "description": "invalid: arn is not a string",
      "valid": false,
      "data": {
        "arn": 1
      }
    },
    {
      "description": "invalid: name is not a string",
      "valid": false,
      "data": {
        "name": 1
      }
    },
    {
      "description": "invalid: not an object",
      "valid": false,
      "data": "arn:aws:sqs:eu-west-1:123456789012:myQueue"
    }
  ]
