{
  "target": "http://localhost:8000/draft-07/bindings/amazon-sqs/0.2.0/channel.json#/definitions/queue",
  "tests": [
    {
      "description": "valid: required properties only",
      "valid": true,
      "data": {
        "name": "myQueue",
        "fifoQueue": false
      }
    },
    {
      "description": "valid: all properties",
      "valid": true,
      "data": {
        "name": "myQueue",
        "fifoQueue": true,
        "deduplicationScope": "messageGroup",
        "deliveryDelay": 10,
        "fifoThroughputLimit": "perMessageGroupId",
        "messageRetentionPeriod": 86400,
        "policy": {
          "statements": [
            {
              "action": "sqs:SendMessage",
              "effect": "Allow",
              "principal": "*"
            }
          ]
        },
        "receiveMessageWaitTime": 0,
        "redrivePolicy": {
          "deadLetterQueue": {
            "arn": "arn:aws:sqs:eu-west-1:123456789012:myQueue"
          },
          "maxReceiveCount": 15
        },
        "tags": {
          "owner": "AsyncAPI.NET"
        },
        "visibilityTimeout": 60
      }
    },
    {
      "description": "valid: with x- extension",
      "valid": true,
      "data": {
        "name": "myQueue",
        "fifoQueue": false,
        "x-owner": "team"
      }
    },
    {
      "description": "valid: unknown property is not validated (no additionalProperties)",
      "valid": true,
      "data": {
        "name": "myQueue",
        "fifoQueue": false,
        "kmsMasterKeyId": "alias/aws/sqs"
      }
    },
    {
      "description": "valid: tag values are not validated",
      "valid": true,
      "data": {
        "name": "myQueue",
        "fifoQueue": false,
        "tags": {
          "replicas": 3
        }
      }
    },
    {
      "description": "invalid: missing name",
      "valid": false,
      "data": {
        "fifoQueue": false
      }
    },
    {
      "description": "invalid: name is not a string",
      "valid": false,
      "data": {
        "name": 1,
        "fifoQueue": false
      }
    },
    {
      "description": "invalid: fifoQueue is not a boolean",
      "valid": false,
      "data": {
        "name": "myQueue",
        "fifoQueue": "true"
      }
    },
    {
      "description": "valid: deliveryDelay minimum 0",
      "valid": true,
      "data": {
        "name": "myQueue",
        "fifoQueue": false,
        "deliveryDelay": 0
      }
    },
    {
      "description": "valid: deliveryDelay maximum 900",
      "valid": true,
      "data": {
        "name": "myQueue",
        "fifoQueue": false,
        "deliveryDelay": 900
      }
    },
    {
      "description": "invalid: deliveryDelay below minimum",
      "valid": false,
      "data": {
        "name": "myQueue",
        "fifoQueue": false,
        "deliveryDelay": -1
      }
    },
    {
      "description": "invalid: deliveryDelay above maximum",
      "valid": false,
      "data": {
        "name": "myQueue",
        "fifoQueue": false,
        "deliveryDelay": 901
      }
    },
    {
      "description": "invalid: deliveryDelay is a decimal number",
      "valid": false,
      "data": {
        "name": "myQueue",
        "fifoQueue": false,
        "deliveryDelay": 0.5
      }
    },
    {
      "description": "invalid: deliveryDelay is a string",
      "valid": false,
      "data": {
        "name": "myQueue",
        "fifoQueue": false,
        "deliveryDelay": "0"
      }
    },
    {
      "description": "valid: messageRetentionPeriod minimum 60",
      "valid": true,
      "data": {
        "name": "myQueue",
        "fifoQueue": false,
        "messageRetentionPeriod": 60
      }
    },
    {
      "description": "valid: messageRetentionPeriod maximum 1209600",
      "valid": true,
      "data": {
        "name": "myQueue",
        "fifoQueue": false,
        "messageRetentionPeriod": 1209600
      }
    },
    {
      "description": "invalid: messageRetentionPeriod below minimum",
      "valid": false,
      "data": {
        "name": "myQueue",
        "fifoQueue": false,
        "messageRetentionPeriod": 59
      }
    },
    {
      "description": "invalid: messageRetentionPeriod above maximum",
      "valid": false,
      "data": {
        "name": "myQueue",
        "fifoQueue": false,
        "messageRetentionPeriod": 1209601
      }
    },
    {
      "description": "invalid: messageRetentionPeriod is a decimal number",
      "valid": false,
      "data": {
        "name": "myQueue",
        "fifoQueue": false,
        "messageRetentionPeriod": 60.5
      }
    },
    {
      "description": "invalid: messageRetentionPeriod is a string",
      "valid": false,
      "data": {
        "name": "myQueue",
        "fifoQueue": false,
        "messageRetentionPeriod": "60"
      }
    },
    {
      "description": "valid: visibilityTimeout minimum 0",
      "valid": true,
      "data": {
        "name": "myQueue",
        "fifoQueue": false,
        "visibilityTimeout": 0
      }
    },
    {
      "description": "valid: visibilityTimeout maximum 43200",
      "valid": true,
      "data": {
        "name": "myQueue",
        "fifoQueue": false,
        "visibilityTimeout": 43200
      }
    },
    {
      "description": "invalid: visibilityTimeout below minimum",
      "valid": false,
      "data": {
        "name": "myQueue",
        "fifoQueue": false,
        "visibilityTimeout": -1
      }
    },
    {
      "description": "invalid: visibilityTimeout above maximum",
      "valid": false,
      "data": {
        "name": "myQueue",
        "fifoQueue": false,
        "visibilityTimeout": 43201
      }
    },
    {
      "description": "invalid: visibilityTimeout is a decimal number",
      "valid": false,
      "data": {
        "name": "myQueue",
        "fifoQueue": false,
        "visibilityTimeout": 0.5
      }
    },
    {
      "description": "invalid: visibilityTimeout is a string",
      "valid": false,
      "data": {
        "name": "myQueue",
        "fifoQueue": false,
        "visibilityTimeout": "0"
      }
    },
    {
      "description": "valid: receiveMessageWaitTime has no bounds",
      "valid": true,
      "data": {
        "name": "myQueue",
        "fifoQueue": false,
        "receiveMessageWaitTime": 100000
      }
    },
    {
      "description": "invalid: receiveMessageWaitTime is a decimal number",
      "valid": false,
      "data": {
        "name": "myQueue",
        "fifoQueue": false,
        "receiveMessageWaitTime": 1.5
      }
    },
    {
      "description": "invalid: tags is not an object",
      "valid": false,
      "data": {
        "name": "myQueue",
        "fifoQueue": false,
        "tags": [
          "owner"
        ]
      }
    },
    {
      "description": "invalid: invalid policy",
      "valid": false,
      "data": {
        "name": "myQueue",
        "fifoQueue": false,
        "policy": {}
      }
    },
    {
      "description": "invalid: invalid redrivePolicy",
      "valid": false,
      "data": {
        "name": "myQueue",
        "fifoQueue": false,
        "redrivePolicy": {
          "maxReceiveCount": 15
        }
      }
    },
    {
      "description": "invalid: not an object",
      "valid": false,
      "data": "myQueue"
    },
    {
      "description": "invalid: missing fifoQueue",
      "valid": false,
      "data": {
        "name": "myQueue"
      }
    }
  ]
}
