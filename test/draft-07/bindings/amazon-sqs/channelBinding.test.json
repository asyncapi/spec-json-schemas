{
  "target": "http://localhost:8000/draft-07/bindings/amazon-sqs/channelBinding.json",
  "tests": [
    {
      "description": "valid: example #1",
      "valid": true,
      "data": {
        "bindingVersion": "0.1.0"
      }
    },
    {
      "description": "valid: example #2",
      "valid": true,
      "data": {
        "queue": {
          "fifoQueue": true,
          "name": "my-sqs-queue"
        },
        "bindingVersion": "0.2.0"
      }
    },
    {
      "description": "valid: example #3",
      "valid": true,
      "data": {
        "queue": {
          "fifoQueue": true,
          "name": "my-sqs-queue"
        },
        "deadLetterQueue": {
          "fifoQueue": true,
          "name": "my-sqs-queue.dlq"
        },
        "bindingVersion": "0.3.0"
      }
    },
    {
      "description": "valid: example #4",
      "valid": true,
      "data": {
        "queue": {
          "fifoQueue": true,
          "name": "my-sqs-queue"
        },
        "deadLetterQueue": {
          "fifoQueue": true,
          "name": "my-sqs-queue.dlq"
        },
        "bindingVersion": "latest"
      }
    },
    {
      "description": "valid: 0.1.0 empty binding",
      "valid": true,
      "data": {
        "bindingVersion": "0.1.0"
      }
    },
    {
      "description": "invalid: 0.1.0 does not define queue",
      "valid": false,
      "data": {
        "bindingVersion": "0.1.0",
        "queue": {
          "name": "myQueue",
          "fifoQueue": false
        }
      }
    },
    {
      "description": "invalid: without bindingVersion uses 0.3.0 which requires queue",
      "valid": false,
      "data": {}
    },
    {
      "description": "valid: without bindingVersion uses 0.3.0",
      "valid": true,
      "data": {
        "queue": {
          "name": "myQueue",
          "fifoQueue": false,
          "policy": {
            "statements": [
              {
                "action": "sqs:SendMessage",
                "effect": "Allow",
                "principal": {
                  "AWS": "arn:aws:iam::123456789012:user/dec.kolakowski"
                }
              }
            ]
          }
        }
      }
    },
    {
      "description": "valid: latest uses 0.3.0",
      "valid": true,
      "data": {
        "queue": {
          "name": "myQueue",
          "fifoQueue": false,
          "policy": {
            "statements": [
              {
                "action": "sqs:SendMessage",
                "effect": "Allow",
                "principal": {
                  "AWS": "arn:aws:iam::123456789012:user/dec.kolakowski"
                }
              }
            ]
          }
        },
        "bindingVersion": "latest"
      }
    },
    {
      "description": "valid: 0.3.0 principal object with 0.3.0",
      "valid": true,
      "data": {
        "queue": {
          "name": "myQueue",
          "fifoQueue": false,
          "policy": {
            "statements": [
              {
                "action": "sqs:SendMessage",
                "effect": "Allow",
                "principal": {
                  "AWS": "arn:aws:iam::123456789012:user/dec.kolakowski"
                }
              }
            ]
          }
        },
        "bindingVersion": "0.3.0"
      }
    },
    {
      "description": "invalid: 0.3.0 principal object with 0.2.0",
      "valid": false,
      "data": {
        "queue": {
          "name": "myQueue",
          "fifoQueue": false,
          "policy": {
            "statements": [
              {
                "action": "sqs:SendMessage",
                "effect": "Allow",
                "principal": {
                  "AWS": "arn:aws:iam::123456789012:user/dec.kolakowski"
                }
              }
            ]
          }
        },
        "bindingVersion": "0.2.0"
      }
    },
    {
      "description": "valid: 0.2.0 principal array with 0.2.0",
      "valid": true,
      "data": {
        "queue": {
          "name": "myQueue",
          "fifoQueue": false,
          "policy": {
            "statements": [
              {
                "action": "sqs:SendMessage",
                "effect": "Allow",
                "principal": [
                  "*"
                ]
              }
            ]
          }
        },
        "bindingVersion": "0.2.0"
      }
    },
    {
      "description": "invalid: 0.2.0 principal array with 0.3.0",
      "valid": false,
      "data": {
        "queue": {
          "name": "myQueue",
          "fifoQueue": false,
          "policy": {
            "statements": [
              {
                "action": "sqs:SendMessage",
                "effect": "Allow",
                "principal": [
                  "*"
                ]
              }
            ]
          }
        },
        "bindingVersion": "0.3.0"
      }
    },
    {
      "description": "invalid: unknown bindingVersion falls back to 0.3.0 and fails its enum",
      "valid": false,
      "data": {
        "queue": {
          "name": "myQueue",
          "fifoQueue": false
        },
        "bindingVersion": "0.4.0"
      }
    },
    {
      "description": "invalid: not an object",
      "valid": false,
      "data": "myQueue"
    }
  ]
}
