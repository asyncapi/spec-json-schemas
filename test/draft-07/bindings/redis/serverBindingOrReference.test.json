{
  "target": "http://localhost:8000/draft-07/bindings/redis/serverBindingOrReference.json",
  "tests": [
    {
      "description": "valid: example #1",
      "valid": true,
      "data": {
        "$ref": "#/bindings/redis/my-redis-server"
      }
    },
    {
      "description": "valid: example #2",
      "valid": true,
      "data": {
        "bindingVersion": "0.1.0"
      }
    },
    {
      "description": "valid: local reference",
      "valid": true,
      "data": {
        "$ref": "#/components/channelBindings/my-redis-channel"
      }
    },
    {
      "description": "valid: external reference",
      "valid": true,
      "data": {
        "$ref": "https://example.com/bindings.json#/redis"
      }
    },
    {
      "description": "valid: inline empty binding",
      "valid": true,
      "data": {}
    },
    {
      "description": "invalid: reference with extra property",
      "valid": false,
      "data": {
        "$ref": "#/components/channelBindings/my-redis-channel",
        "bindingVersion": "0.1.0"
      }
    },
    {
      "description": "invalid: reference is not a string",
      "valid": false,
      "data": {
        "$ref": 1
      }
    },
    {
      "description": "invalid: invalid inline binding",
      "valid": false,
      "data": {
        "bindingVersion": "0.2.0"
      }
    },
    {
      "description": "invalid: not an object",
      "valid": false,
      "data": "#/components/channelBindings/my-redis-channel"
    }
  ]
}
