{
  "target": "http://localhost:8000/draft-07/bindings/nats/messageBindingOrReference.json",
  "tests": [
    {
      "description": "valid: example #1",
      "valid": true,
      "data": {
        "$ref": "#/bindings/nats/my-nats-queue"
      }
    },
    {
      "description": "valid: example #2",
      "valid": true,
      "data": {
        "bindingVersion": "0.1.0"
      }
    },
    {
      "description": "valid: local reference",
      "valid": true,
      "data": {
        "$ref": "#/bindings/nats/my-nats-channel"
      }
    },
    {
      "description": "valid: external reference",
      "valid": true,
      "data": {
        "$ref": "https://example.com/bindings.json#/nats"
      }
    },
    {
      "description": "valid: inline binding",
      "valid": true,
      "data": {}
    },
    {
      "description": "invalid: reference with extra property",
      "valid": false,
      "data": {
        "$ref": "#/bindings/nats/my-nats-channel",
        "bindingVersion": "0.1.0"
      }
    },
    {
      "description": "invalid: reference is not a string",
      "valid": false,
      "data": {
        "$ref": 1
      }
    },
    {
      "description": "invalid: invalid inline binding",
      "valid": false,
      "data": {
        "queue": "MyCustomQueue"
      }
    },
    {
      "description": "invalid: not an object",
      "valid": false,
      "data": "#/bindings/nats/my-nats-channel"
    }
  ]
}
