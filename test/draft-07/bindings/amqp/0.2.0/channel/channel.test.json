      "valid": false,
      "data": {
        "exchange": {
          "name": "myExchange",
          "type": "topic",
          "durable": true,
          "autoDelete": false
        },
        "bindingVersion": "0.4.0"
      }
    },
    {
      "description": "invalid: invalid exchange",
      "valid": false,
      "data": {
        "exchange": {
          "type": "unknown"
        }
      }
    },
    {
      "description": "invalid: invalid queue",
      "valid": false,
      "data": {
        "queue": {
          "durable": "true"
        }
      }
    },
    {
      "description": "invalid: unknown property",
      "valid": false,
      "data": {
        "exchange": {
          "name": "myExchange",
          "type": "topic",
          "durable": true,
          "autoDelete": false
        },
        "routingKey": "user.signedup"
