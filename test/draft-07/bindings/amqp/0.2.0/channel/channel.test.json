          "name": "myExchange",
          "type": "topic",
          "durable": true,
          "autoDelete": false
        }
      }
    },
    {
      "description": "invalid: queue with is routingKey",
      "valid": false,
      "data": {
        "is": "routingKey",
        "queue": {
          "name": "my-queue-name",
          "durable": true,
          "exclusive": true,
          "autoDelete": false
        }
      }
    },
    {
      "description": "invalid: exchange and queue together",
      "valid": false,
      "data": {
        "exchange": {
          "name": "myExchange",
          "type": "topic",
          "durable": true,
          "autoDelete": false
