          "durable": true,
          "autoDelete": false
        }
      }
    },
    {
      "description": "valid: queue with is queue",
      "valid": true,
      "data": {
        "is": "queue",
        "queue": {
          "name": "my-queue-name",
          "durable": true,
          "exclusive": true,
          "autoDelete": false
        }
      }
    },
    {
      "description": "valid: exchange without is",
      "valid": true,
      "data": {
        "exchange": {
          "name": "myExchange",
          "type": "topic",
          "durable": true,
          "autoDelete": false
        }
      }
    },
    {
      "description": "valid: queue without is",
      "valid": true,
      "data": {
        "queue": {
          "name": "my-queue-name",
          "durable": true,
          "exclusive": true,
          "autoDelete": false
        }
      }
    },
