{
  "target": "http://localhost:8000/draft-07/bindings/amqp/channelBindingOrReference.json",
  "tests": [
    {
      "description": "valid: example #1",
      "valid": true,
      "data": {
        "$ref": "#/bindings/amqp/my-amqp-queue"
      }
    },
    {
      "description": "valid: example #2",
      "valid": true,
      "data": {
        "bindingVersion": "0.3.0",
        "exchange": {
          "type": "fanout",
          "autoDelete": false,
          "durable": true,
          "name": "myExchange",
          "vhost": "/"
        },
        "is": "routingKey"
      }
    },
    {
      "description": "valid: local reference",
      "valid": true,
      "data": {
        "$ref": "#/components/channelBindings/my-amqp-queue"
      }
    },
    {
      "description": "valid: external reference",
      "valid": true,
      "data": {
        "$ref": "https://example.com/bindings.json#/amqp"
      }
    },
    {
      "description": "valid: inline binding",
      "valid": true,
      "data": {
        "is": "queue",
        "queue": {
          "name": "my-queue-name",
          "durable": true,
          "exclusive": true,
          "autoDelete": false
        }
      }
    },
    {
      "description": "invalid: reference with extra property",
      "valid": false,
      "data": {
        "$ref": "#/components/channelBindings/my-amqp-queue",
        "bindingVersion": "0.3.0"
      }
    },
    {
      "description": "invalid: reference is not a string",
      "valid": false,
      "data": {
        "$ref": 1
      }
    },
    {
      "description": "invalid: invalid inline binding",
      "valid": false,
      "data": {
        "is": "queue",
        "exchange": {
          "name": "myExchange",
          "type": "topic",
          "durable": true,
          "autoDelete": false
        }
      }
    },
    {
      "description": "invalid: not an object",
      "valid": false,
      "data": "#/components/channelBindings/my-amqp-queue"
    }
  ]
}
