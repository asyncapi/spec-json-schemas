{
  "target": "http://localhost:8000/draft-07/bindings/mqtt/operationBinding.json",
  "tests": [
    {
      "description": "valid: example #1",
      "valid": true,
      "data": {
        "bindingVersion": "0.1.0",
        "qos": 2,
        "retain": true
      }
    },
    {
      "description": "valid: example #2",
      "valid": true,
      "data": {
        "bindingVersion": "0.2.0",
        "messageExpiryInterval": 60,
        "qos": 2,
        "retain": true
      }
    },
    {
      "description": "valid: qos 3 with 0.1.0 (no enum)",
      "valid": true,
      "data": {
        "bindingVersion": "0.1.0",
        "qos": 3
      }
    },
    {
      "description": "invalid: qos 3 with 0.2.0",
      "valid": false,
      "data": {
        "bindingVersion": "0.2.0",
        "qos": 3
      }
    },
    {
      "description": "invalid: qos 3 without bindingVersion uses 0.2.0",
      "valid": false,
      "data": {
        "qos": 3
      }
    },
    {
      "description": "invalid: messageExpiryInterval with 0.1.0",
      "valid": false,
      "data": {
        "bindingVersion": "0.1.0",
        "messageExpiryInterval": 60
      }
    },
    {
      "description": "valid: messageExpiryInterval with latest uses 0.2.0",
      "valid": true,
      "data": {
        "bindingVersion": "latest",
        "messageExpiryInterval": 60
      }
    },
    {
      "description": "valid: without bindingVersion uses 0.2.0",
      "valid": true,
      "data": {
        "messageExpiryInterval": 60,
        "qos": 1
      }
    },
    {
      "description": "invalid: unknown bindingVersion falls back to 0.2.0 and fails its enum",
      "valid": false,
      "data": {
        "bindingVersion": "0.3.0"
      }
    },
    {
      "description": "invalid: not an object",
      "valid": false,
      "data": 1
    }
  ]
}
