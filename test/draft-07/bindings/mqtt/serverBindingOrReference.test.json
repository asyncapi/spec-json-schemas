{
  "target": "http://localhost:8000/draft-07/bindings/mqtt/serverBindingOrReference.json",
  "tests": [
    {
      "description": "valid: example #1",
      "valid": true,
      "data": {
        "$ref": "#/bindings/mqtt/my-mqtt-server"
      }
    },
    {
      "description": "valid: example #2",
      "valid": true,
      "data": {
        "bindingVersion": "0.2.0",
        "cleanSession": true,
        "clientId": "guest",
        "keepAlive": 60,
        "lastWill": {
          "message": "Guest gone offline.",
          "qos": 2,
          "retain": false,
          "topic": "/last-wills"
        },
        "maximumPacketSize": {
          "type": "integer",
          "minimum": 1
        },
        "sessionExpiryInterval": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    {
      "description": "valid: local reference",
      "valid": true,
      "data": {
        "$ref": "#/bindings/mqtt/my-mqtt-channel"
      }
    },
    {
      "description": "valid: external reference",
      "valid": true,
      "data": {
        "$ref": "https://example.com/bindings.json#/mqtt"
      }
    },
    {
      "description": "valid: inline binding",
      "valid": true,
      "data": {
        "clientId": "guest"
      }
    },
    {
      "description": "invalid: reference with extra property",
      "valid": false,
      "data": {
        "$ref": "#/bindings/mqtt/my-mqtt-channel",
        "bindingVersion": "0.2.0"
      }
    },
    {
      "description": "invalid: reference is not a string",
      "valid": false,
      "data": {
        "$ref": 1
      }
    },
    {
      "description": "invalid: invalid inline binding",
      "valid": false,
      "data": {
        "lastWill": {
          "qos": 3
        }
      }
    },
    {
      "description": "invalid: not an object",
      "valid": false,
      "data": "#/bindings/mqtt/my-mqtt-channel"
    }
  ]
}
