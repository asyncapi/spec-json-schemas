{
  "target": "http://localhost:8000/draft-07/bindings/apache-pulsar/channelBinding.json",
  "tests": [
    {
      "description": "valid: example #1",
      "valid": true,
      "data": {
        "bindingVersion": "0.1.0",
        "compaction": 1000,
        "deduplication": true,
        "geo-replication": [
          "us-west",
          "us-east"
        ],
        "namespace": "ns1",
        "persistence": "persistent",
        "retention": {
          "size": 1000,
          "time": 15
        },
        "ttl": 360
      }
    },
    {
      "description": "valid: without bindingVersion uses 0.1.0",
      "valid": true,
      "data": {
        "namespace": "ns1",
        "persistence": "persistent"
      }
    },
    {
      "description": "valid: latest uses 0.1.0",
      "valid": true,
      "data": {
        "namespace": "ns1",
        "persistence": "persistent",
        "bindingVersion": "latest"
      }
    },
    {
      "description": "valid: 0.1.0",
      "valid": true,
      "data": {
        "namespace": "ns1",
        "persistence": "persistent",
        "bindingVersion": "0.1.0"
      }
    },
    {
      "description": "invalid: 0.1.0 with invalid binding",
      "valid": false,
      "data": {
        "namespace": "ns1",
        "persistence": "transient",
        "bindingVersion": "0.1.0"
      }
    },
    {
      "description": "invalid: without bindingVersion uses 0.1.0 and fails",
      "valid": false,
      "data": {
        "namespace": "ns1",
        "persistence": "transient"
      }
    },
    {
      "description": "invalid: unknown bindingVersion falls back to 0.1.0 and fails its enum",
      "valid": false,
      "data": {
        "namespace": "ns1",
        "persistence": "persistent",
        "bindingVersion": "0.2.0"
      }
    },
    {
      "description": "invalid: not an object",
      "valid": false,
      "data": "latest"
    }
  ]
}
