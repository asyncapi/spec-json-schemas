{
  "target": "http://localhost:8000/draft-07/bindings/websockets/channelBinding.json",
  "tests": [
    {
      "description": "valid: example #1",
      "valid": true,
      "data": {}
    },
    {
      "description": "valid: example #2",
      "valid": true,
      "data": {
        "bindingVersion": "latest"
      }
    },
    {
      "description": "valid: example #3",
      "valid": true,
      "data": {
        "bindingVersion": "0.1.0",
        "headers": {
          "session-id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "method": "GET"
      }
    },
    {
      "description": "valid: without bindingVersion uses 0.1.0",
      "valid": true,
      "data": {
        "method": "GET",
        "headers": {
          "type": "object",
          "properties": {
            "session-id": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      }
    },
    {
      "description": "valid: latest uses 0.1.0",
      "valid": true,
      "data": {
        "method": "GET",
        "headers": {
          "type": "object",
          "properties": {
            "session-id": {
              "type": "string",
              "format": "uuid"
            }
          }
        },
        "bindingVersion": "latest"
      }
    },
    {
      "description": "valid: 0.1.0",
      "valid": true,
      "data": {
        "method": "GET",
        "headers": {
          "type": "object",
          "properties": {
            "session-id": {
              "type": "string",
              "format": "uuid"
            }
          }
        },
        "bindingVersion": "0.1.0"
      }
    },
    {
      "description": "invalid: 0.1.0 with invalid binding",
      "valid": false,
      "data": {
        "method": "PUT",
        "bindingVersion": "0.1.0"
      }
    },
    {
      "description": "invalid: without bindingVersion uses 0.1.0 and fails",
      "valid": false,
      "data": {
        "method": "PUT"
      }
    },
    {
      "description": "invalid: unknown bindingVersion falls back to 0.1.0 and fails its enum",
      "valid": false,
      "data": {
        "method": "GET",
        "headers": {
          "type": "object",
          "properties": {
            "session-id": {
              "type": "string",
              "format": "uuid"
            }
          }
        },
        "bindingVersion": "0.2.0"
      }
    },
    {
      "description": "invalid: not an object",
      "valid": false,
      "data": "latest"
    }
  ]
}
