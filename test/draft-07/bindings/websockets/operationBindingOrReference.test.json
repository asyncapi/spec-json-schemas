{
  "target": "http://localhost:8000/draft-07/bindings/websockets/operationBindingOrReference.json",
  "tests": [
    {
      "description": "valid: example #1",
      "valid": true,
      "data": {
        "$ref": "#/bindings/amqp/my-amqp-operation"
      }
    },
    {
      "description": "valid: example #2",
      "valid": true,
      "data": {
        "bindingVersion": "0.1.0"
      }
    },
    {
      "description": "valid: local reference",
      "valid": true,
      "data": {
        "$ref": "#/bindings/websockets/my-websockets-channel"
      }
    },
    {
      "description": "valid: external reference",
      "valid": true,
      "data": {
        "$ref": "https://example.com/bindings.json#/websockets"
      }
    },
    {
      "description": "valid: inline binding",
      "valid": true,
      "data": {}
    },
    {
      "description": "invalid: reference with extra property",
      "valid": false,
      "data": {
        "$ref": "#/bindings/websockets/my-websockets-channel",
        "bindingVersion": "0.1.0"
      }
    },
    {
      "description": "invalid: reference is not a string",
      "valid": false,
      "data": {
        "$ref": 1
      }
    },
    {
      "description": "invalid: invalid inline binding",
      "valid": false,
      "data": {
        "method": "GET"
      }
    },
    {
      "description": "invalid: not an object",
      "valid": false,
      "data": "#/bindings/websockets/my-websockets-channel"
    }
  ]
}
