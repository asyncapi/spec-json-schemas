{
  "target": "http://localhost:8000/draft-07/bindings/amazon-sns/0.2.0/channel.json#/definitions/statement/properties/resource",
  "tests": [
    {
      "description": "valid: resource as a string",
      "valid": true,
      "data": "arn:aws:sns:us-east-1:123456789012:my-sns-topic"
    },
    {
      "description": "valid: resource as an array of strings",
      "valid": true,
      "data": [
        "arn:aws:sns:us-east-1:123456789012:a",
        "arn:aws:sns:us-east-1:123456789012:b"
      ]
    },
    {
      "description": "valid: resource as an empty array",
      "valid": true,
      "data": []
    },
    {
      "description": "invalid: resource as a number",
      "valid": false,
      "data": 1
    },
    {
      "description": "invalid: resource as an array with a non string item",
      "valid": false,
      "data": [
        "arn:aws:sns:us-east-1:123456789012:a",
        1
      ]
    },
    {
      "description": "invalid: resource as an object",
      "valid": false,
      "data": {
        "arn": "arn:aws:sns:us-east-1:123456789012:a"
      }
    }
  ]
}
