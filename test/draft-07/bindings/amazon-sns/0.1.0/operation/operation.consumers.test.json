{
  "target": "http://localhost:8000/draft-07/bindings/amazon-sns/0.1.0/operation.json#/properties/consumers",
  "tests": [
    {
      "description": "valid: single consumer",
      "valid": true,
      "data": [
        {
          "endpoint": {
            "name": "someQueue"
          },
          "protocol": "sqs",
          "rawMessageDelivery": false
        }
      ]
    },
    {
      "description": "valid: several consumers",
      "valid": true,
      "data": [
        {
          "endpoint": {
            "name": "someQueue"
          },
          "protocol": "sqs",
          "rawMessageDelivery": false
        },
        {
          "endpoint": {
            "arn": "arn:aws:lambda:us-east-1:123456789012:function:fn"
          },
          "protocol": "lambda",
          "rawMessageDelivery": false
        }
      ]
    },
    {
      "description": "invalid: empty array",
      "valid": false,
      "data": []
    },
    {
      "description": "invalid: invalid consumer",
      "valid": false,
      "data": [
        {
          "protocol": "sqs"
        }
      ]
    },
    {
      "description": "invalid: not an array",
      "valid": false,
      "data": {
        "endpoint": {
          "name": "someQueue"
        },
        "protocol": "sqs",
        "rawMessageDelivery": false
      }
    }
  ]
}
