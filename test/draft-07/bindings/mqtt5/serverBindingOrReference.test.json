{
  "target": "http://localhost:8000/draft-07/bindings/mqtt5/serverBindingOrReference.json",
  "tests": [
    {
      "description": "valid: example #1",
      "valid": true,
      "data": {
        "$ref": "#/bindings/mqtt5/my-mqtt5-server"
      }
    },
    {
      "description": "valid: example #2",
      "valid": true,
      "data": {
        "bindingVersion": "0.2.0",
        "sessionExpiryInterval": {
          "type": "integer",
          "minimum": 100
        }
      }
    },
    {
      "description": "valid: local reference",
      "valid": true,
      "data": {
        "$ref": "#/bindings/mqtt5/my-mqtt5-channel"
      }
    },
    {
      "description": "valid: external reference",
      "valid": true,
      "data": {
        "$ref": "https://example.com/bindings.json#/mqtt5"
      }
    },
    {
      "description": "valid: inline binding",
      "valid": true,
      "data": {
        "sessionExpiryInterval": 60
      }
    },
    {
      "description": "invalid: reference with extra property",
      "valid": false,
      "data": {
        "$ref": "#/bindings/mqtt5/my-mqtt5-channel",
        "bindingVersion": "0.2.0"
      }
    },
    {
      "description": "invalid: reference is not a string",
      "valid": false,
      "data": {
        "$ref": 1
      }
    },
    {
      "description": "invalid: invalid inline binding",
      "valid": false,
      "data": {
        "sessionExpiryInterval": -1
      }
    },
    {
      "description": "invalid: not an object",
      "valid": false,
      "data": "#/bindings/mqtt5/my-mqtt5-channel"
    }
  ]
}
