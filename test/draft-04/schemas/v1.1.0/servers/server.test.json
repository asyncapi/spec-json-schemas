{
  "target": "http://localhost:8000/draft-04/schemas/v1.1.0/servers/server.json",
  "tests": [
    {
      "description": "valid: required properties only",
      "valid": true,
      "data": {
        "url": "mqtt.weather-forecast.am",
        "scheme": "mqtt"
      }
    },
    {
      "description": "valid: all properties",
      "valid": true,
      "data": {
        "url": "mqtt.weather-forecast.am:{port}",
        "scheme": "mqtts",
        "schemeVersion": "3.1.1",
        "description": "Production broker",
        "variables": {
          "port": {
            "enum": [
              "8883",
              "8884"
            ],
            "default": "8883"
          }
        }
      }
    },
    {
      "description": "valid: with x- extension",
