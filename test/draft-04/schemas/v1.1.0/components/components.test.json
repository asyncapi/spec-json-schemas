{
  "target": "http://localhost:8000/draft-04/schemas/v1.1.0/components/components.json",
  "tests": [
    {
      "description": "valid: empty object",
      "valid": true,
      "data": {}
    },
    {
      "description": "valid: all sections",
      "valid": true,
      "data": {
        "schemas": {
          "city": {
            "type": "object",
            "required": [
              "city"
            ],
            "properties": {
              "city": {
                "type": "string",
                "description": "City name"
              },
              "temperature": {
                "type": "number",
                "minimum": -100,
                "maximum": 100
              }
            }
          }
        },
        "messages": {
          "cityUpdated": {
            "summary": "Weather update for a city",
            "description": "Sent every time the **forecast** changes",
            "headers": {
              "type": "object",
              "properties": {
                "correlationId": {
                  "type": "string"
                }
              }
            },
            "payload": {
              "type": "object",
              "required": [
                "city"
              ],
              "properties": {
                "city": {
                  "type": "string",
                  "description": "City name"
                },
                "temperature": {
                  "type": "number",
                  "minimum": -100,
                  "maximum": 100
                }
              }
            },
            "tags": [
              {
                "name": "city"
              }
            ],
            "externalDocs": {
              "url": "https://api.weather-forecast.am/docs"
            },
            "deprecated": false,
            "example": {
              "city": "Yerevan",
              "temperature": 21.5
            }
          }
        },
        "securitySchemes": {
          "userPassword": {
            "type": "userPassword"
          },
          "bearer": {
            "type": "http",
            "scheme": "bearer",
            "bearerFormat": "JWT"
          }
        }
      }
    },
    {
      "description": "valid: security scheme as absolute uri reference",
      "valid": true,
      "data": {
        "securitySchemes": {
          "userPassword": {
            "$ref": "https://example.com/security.json#/basic"
          }
        }
      }
    },
    {
      "description": "invalid: security scheme as local pointer reference",
      "valid": false,
      "data": {
        "securitySchemes": {
          "userPassword": {
            "$ref": "#/components/securitySchemes/basic"
          }
        }
      }
    },
    {
      "description": "invalid: unknown security scheme type",
      "valid": false,
      "data": {
        "securitySchemes": {
          "oauth": {
            "type": "oauth2"
          }
        }
      }
    },
    {
      "description": "valid: security scheme name outside the pattern is not validated",
      "valid": true,
      "data": {
        "securitySchemes": {
          "user password": {
            "type": "oauth2"
          }
        }
      }
    },
    {
      "description": "invalid: schema with unknown property",
      "valid": false,
      "data": {
        "schemas": {
          "city": {
            "type": "object",
            "foo": "bar"
          }
        }
      }
    },
    {
      "description": "invalid: message with unknown property",
      "valid": false,
      "data": {
        "messages": {
          "cityUpdated": {
            "foo": "bar"
          }
        }
      }
    },
    {
      "description": "invalid: unknown property",
      "valid": false,
      "data": {
        "parameters": {}
      }
    }
  ]
}
