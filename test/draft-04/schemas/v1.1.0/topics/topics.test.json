{
  "target": "http://localhost:8000/draft-04/schemas/v1.1.0/topics/topics.json",
  "tests": [
    {
      "description": "valid: empty object",
      "valid": true,
      "data": {}
    },
    {
      "description": "valid: several topics",
      "valid": true,
      "data": {
        "forecast.city.updated": {
          "subscribe": {
            "$ref": "#/components/messages/cityUpdated"
          }
        },
        "forecast.city.requested": {
          "publish": {
            "payload": {
              "$ref": "#/components/schemas/city"
            }
          }
        },
        "forecast.{city}.alerts": {
          "parameters": [
            {
              "name": "city",
              "description": "City name, e.g. Yerevan",
              "schema": {
                "type": "string"
              }
            }
          ],
          "subscribe": {
            "oneOf": [
              {
                "$ref": "#/components/messages/cityUpdated"
              },
              {
                "payload": {
                  "type": "string"
                }
              }
            ]
          }
        }
      }
    },
    {
      "description": "valid: x- extension that is also a valid topic item",
      "valid": true,
      "data": {
        "x-owner": {
          "deprecated": true
        }
      }
    },
    {
      "description": "invalid: x- extension must also be a valid topic item",
      "valid": false,
      "data": {
        "x-owner": "forecast-team"
      }
    },
    {
      "description": "invalid: topic starts with a dot",
      "valid": false,
      "data": {
        ".hidden": {
          "subscribe": {
            "summary": "Weather update for a city",
            "description": "Sent every time the **forecast** changes",
            "headers": {
              "type": "object",
              "properties": {
                "correlationId": {
                  "type": "string"
                }
              }
            },
            "payload": {
              "type": "object",
              "required": [
                "city"
              ],
              "properties": {
                "city": {
                  "type": "string",
                  "description": "City name"
                },
                "temperature": {
                  "type": "number",
                  "minimum": -100,
                  "maximum": 100
                }
              }
            },
            "tags": [
              {
                "name": "city"
              }
            ],
            "externalDocs": {
              "url": "https://api.weather-forecast.am/docs"
            },
            "deprecated": false,
            "example": {
              "city": "Yerevan",
              "temperature": 21.5
            }
          }
        }
      }
    },
    {
      "description": "invalid: empty topic item",
      "valid": false,
      "data": {
        "forecast.city.updated": {}
      }
    },
    {
      "description": "invalid: topic item with unknown property",
      "valid": false,
      "data": {
        "forecast.city.updated": {
          "get": {
            "summary": "Weather update for a city",
            "description": "Sent every time the **forecast** changes",
            "headers": {
              "type": "object",
              "properties": {
                "correlationId": {
                  "type": "string"
                }
              }
            },
            "payload": {
              "type": "object",
              "required": [
                "city"
              ],
              "properties": {
                "city": {
                  "type": "string",
                  "description": "City name"
                },
                "temperature": {
                  "type": "number",
                  "minimum": -100,
                  "maximum": 100
                }
              }
            },
            "tags": [
              {
                "name": "city"
              }
            ],
            "externalDocs": {
              "url": "https://api.weather-forecast.am/docs"
            },
            "deprecated": false,
            "example": {
              "city": "Yerevan",
              "temperature": 21.5
            }
          }
        }
      }
    }
  ]
}
