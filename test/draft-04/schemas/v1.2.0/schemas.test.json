{
  "target": "http://localhost:8000/draft-04/schemas/v1.2.0/schemas.json",
  "tests": [
    {
      "description": "valid: empty object",
      "valid": true,
      "data": {}
    },
    {
      "description": "valid: several schemas",
      "valid": true,
      "data": {
        "city": {
          "type": "object",
          "required": [
            "city"
          ],
          "properties": {
            "city": {
              "type": "string",
              "description": "City name"
            },
            "temperature": {
              "type": "number",
              "minimum": -100,
              "maximum": 100
            }
          }
        },
        "name": {
          "type": "string"
        }
      }
    },
    {
      "description": "invalid: schema with unknown keyword",
      "valid": false,
      "data": {
        "city": {
          "type": "object",
          "foo": "bar"
        }
      }
    },
    {
      "description": "invalid: schema is not an object",
      "valid": false,
      "data": {
        "city": "string"
      }
    }
  ]
}
