{
  "target": "http://localhost:8000/draft-04/schemas/v1.2.0/topics/parameters/parameters.json",
  "tests": [
    {
      "description": "valid: empty object",
      "valid": true,
      "data": {}
    },
    {
      "description": "valid: several parameters",
      "valid": true,
      "data": {
        "city": {
          "name": "city",
          "description": "City name, e.g. Yerevan",
          "schema": {
            "type": "string"
          }
        },
        "region": {
          "$ref": "#/components/parameters/region"
        }
      }
    },
    {
      "description": "invalid: parameter with unknown property",
      "valid": false,
      "data": {
        "city": {
          "name": "city",
          "in": "path"
        }
      }
    },
    {
      "description": "invalid: parameter with invalid schema",
      "valid": false,
      "data": {
        "city": {
          "schema": {
            "type": "date"
          }
        }
      }
    },
    {
      "description": "invalid: not an object",
      "valid": false,
      "data": [
        "city"
      ]
    }
  ]
}
