{
  "target": "http://localhost:8000/draft-04/schemas/v1/xml.json",
  "tests": [
    {
      "description": "valid: empty object",
      "valid": true,
      "data": {}
    },
    {
      "description": "valid: all properties",
      "valid": true,
      "data": {
        "name": "animal",
        "namespace": "https://example.com/schema",
        "prefix": "sample",
        "attribute": false,
        "wrapped": true
      }
    },
    {
      "description": "invalid: name is not a string",
      "valid": false,
      "data": {
        "name": 1
      }
    },
    {
      "description": "invalid: attribute is not a boolean",
      "valid": false,
      "data": {
        "attribute": "true"
      }
    },
    {
      "description": "invalid: wrapped is not a boolean",
      "valid": false,
      "data": {
        "wrapped": 1
      }
    },
    {
      "description": "invalid: unknown property",
      "valid": false,
      "data": {
        "foo": "bar"
      }
    }
  ]
}
