{
  "target": "http://localhost:8000/draft-04/schemas/v1/security/http/bearerHTTPSecuritySchema.json",
  "tests": [
    {
      "description": "valid: bearer with JWT format",
      "valid": true,
      "data": {
        "type": "http",
        "description": "HTTP - Bearer",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    {
      "description": "valid: without bearerFormat",
      "valid": true,
      "data": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    {
      "description": "valid: with x- extension",
      "valid": true,
      "data": {
        "type": "http",
        "description": "HTTP - Bearer",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "x-issuer": "auth.weather-forecast.am"
      }
    },
    {
      "description": "invalid: missing type",
      "valid": false,
      "data": {
        "scheme": "bearer"
      }
    },
    {
      "description": "invalid: missing scheme",
      "valid": false,
      "data": {
        "type": "http",
        "bearerFormat": "JWT"
      }
    },
    {
      "description": "invalid: wrong scheme value",
      "valid": false,
      "data": {
        "type": "http",
        "scheme": "basic"
      }
    },
    {
      "description": "invalid: wrong type value",
      "valid": false,
      "data": {
        "type": "httpApiKey",
        "scheme": "bearer"
      }
    },
    {
      "description": "invalid: bearerFormat is not a string",
      "valid": false,
      "data": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": 1
      }
    },
    {
      "description": "invalid: unknown property",
      "valid": false,
      "data": {
        "type": "http",
        "description": "HTTP - Bearer",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "in": "header"
      }
    }
  ]
}
