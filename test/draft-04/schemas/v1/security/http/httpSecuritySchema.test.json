{
  "target": "http://localhost:8000/draft-04/schemas/v1/security/http/httpSecuritySchema.json",
  "tests": [
    {
      "description": "valid: HTTP API key",
      "valid": true,
      "data": {
        "type": "httpApiKey",
        "description": "HTTP - API Key",
        "name": "api_key",
        "in": "header"
      }
    },
    {
      "description": "valid: HTTP basic",
      "valid": true,
      "data": {
        "type": "http",
        "description": "HTTP - Basic",
        "scheme": "basic"
      }
    },
    {
      "description": "valid: HTTP bearer",
      "valid": true,
      "data": {
        "type": "http",
        "description": "HTTP - Bearer",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    {
      "description": "invalid: HTTP API key with wrong in",
      "valid": false,
      "data": {
        "type": "httpApiKey",
        "description": "HTTP - API Key",
        "name": "api_key",
        "in": "user"
      }
    },
    {
      "description": "invalid: HTTP without scheme",
      "valid": false,
      "data": {
        "type": "http"
      }
    },
    {
      "description": "invalid: non HTTP scheme",
      "valid": false,
      "data": {
        "type": "apiKey",
        "in": "user"
      }
    },
    {
      "description": "invalid: empty object",
      "valid": false,
      "data": {}
    }
  ]
}
