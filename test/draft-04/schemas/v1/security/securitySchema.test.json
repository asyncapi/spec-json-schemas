{
  "target": "http://localhost:8000/draft-04/schemas/v1/security/securitySchema.json",
  "tests": [
    {
      "description": "valid: userPassword",
      "valid": true,
      "data": {
        "type": "userPassword"
      }
    },
    {
      "description": "valid: apiKey",
      "valid": true,
      "data": {
        "type": "apiKey",
        "in": "user"
      }
    },
    {
      "description": "valid: X509",
      "valid": true,
      "data": {
        "type": "X509"
      }
    },
    {
      "description": "valid: symmetricEncryption",
      "valid": true,
      "data": {
        "type": "symmetricEncryption"
      }
    },
    {
      "description": "valid: asymmetricEncryption",
      "valid": true,
      "data": {
        "type": "asymmetricEncryption"
      }
    },
    {
      "description": "valid: HTTP API key",
      "valid": true,
      "data": {
        "type": "httpApiKey",
        "description": "HTTP - API Key",
        "name": "api_key",
        "in": "header"
      }
    },
    {
      "description": "valid: HTTP basic",
      "valid": true,
      "data": {
        "type": "http",
        "description": "HTTP - Basic",
        "scheme": "basic"
      }
    },
    {
      "description": "valid: HTTP bearer",
      "valid": true,
      "data": {
        "type": "http",
        "description": "HTTP - Bearer",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    {
      "description": "invalid: unknown type",
      "valid": false,
      "data": {
        "type": "oauth2"
      }
    },
    {
      "description": "invalid: apiKey without in",
      "valid": false,
      "data": {
        "type": "apiKey"
      }
    },
    {
      "description": "invalid: HTTP API key without name",
      "valid": false,
      "data": {
        "type": "httpApiKey",
        "in": "header"
      }
    },
    {
      "description": "invalid: empty object",
      "valid": false,
      "data": {}
    }
  ]
