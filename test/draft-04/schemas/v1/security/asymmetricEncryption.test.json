{
  "target": "http://localhost:8000/draft-04/schemas/v1/security/asymmetricEncryption.json",
  "tests": [
    {
      "description": "valid: type only",
      "valid": true,
      "data": {
        "type": "asymmetricEncryption"
      }
    },
    {
      "description": "valid: type and description",
      "valid": true,
      "data": {
        "type": "asymmetricEncryption",
        "description": "Provides authentication by using a public and private key pair to create digital signatures and verify user or device identity"
      }
    },
    {
      "description": "valid: with x- extension",
      "valid": true,
      "data": {
        "type": "asymmetricEncryption",
        "x-custom": {
          "any": "value"
        }
      }
    },
    {
      "description": "invalid: missing type",
      "valid": false,
      "data": {
        "description": "Provides authentication by using a public and private key pair to create digital signatures and verify user or device identity"
      }
    },
    {
      "description": "invalid: wrong type value",
      "valid": false,
      "data": {
        "type": "unknown"
      }
    },
    {
      "description": "invalid: type is not a string",
      "valid": false,
      "data": {
        "type": 1
      }
    },
    {
      "description": "invalid: description is not a string",
      "valid": false,
      "data": {
        "type": "asymmetricEncryption",
        "description": 1
      }
    },
    {
      "description": "invalid: unknown property",
      "valid": false,
      "data": {
        "type": "asymmetricEncryption",
        "foo": "bar"
      }
    },
    {
      "description": "invalid: not an object",
      "valid": false,
      "data": "asymmetricEncryption"
    }
  ]
}
