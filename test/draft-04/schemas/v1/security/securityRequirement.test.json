{
  "target": "http://localhost:8000/draft-04/schemas/v1/security/securityRequirement.json",
  "tests": [
    {
      "description": "valid: empty object",
      "valid": true,
      "data": {}
    },
    {
      "description": "valid: scheme with empty scopes",
      "valid": true,
      "data": {
        "apiKey": []
      }
    },
    {
      "description": "valid: several schemes with scopes",
      "valid": true,
      "data": {
        "oauth": [
          "read",
          "write"
        ],
        "apiKey": []
      }
    },
    {
      "description": "invalid: scopes are not an array",
      "valid": false,
      "data": {
        "oauth": "read"
      }
    },
    {
      "description": "invalid: scope is not a string",
      "valid": false,
      "data": {
        "oauth": [
          1
        ]
      }
    },
    {
      "description": "invalid: not an object",
      "valid": false,
      "data": [
        "apiKey"
      ]
    }
  ]
}
