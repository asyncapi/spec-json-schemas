{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "id": "http://localhost:8000/draft-04/schemas/v1.0.0/topics/messages/message.json",
  "type": "object",
  "properties": {
    "$ref": {
      "type": "string"
    },
    "headers": {
      "$ref": "http://localhost:8000/draft-04/schemas/v1.0.0/schema.json"
    },
    "payload": {
      "$ref": "http://localhost:8000/draft-04/schemas/v1.0.0/schema.json"
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "http://localhost:8000/draft-04/schemas/v1/tag.json"
      }
    },
    "summary": {
      "description": "A brief summary of the message.",
      "type": "string"
    },
    "description": {
      "description": "A longer description of the message. CommonMark is allowed.",
      "type": "string"
    },
    "externalDocs": {
      "$ref": "http://localhost:8000/draft-04/schemas/v1/externalDocs.json"
    },
    "deprecated": {
      "default": false,
      "type": "boolean"
    },
    "example": {}
  },
  "patternProperties": {
    "^x-": {
      "$ref": "http://localhost:8000/draft-04/schemas/v1/vendorExtension.json"
    }
  },
  "additionalProperties": false
}
