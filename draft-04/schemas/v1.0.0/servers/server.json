{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "id": "http://localhost:8000/draft-04/schemas/v1.0.0/servers/server.json",
  "description": "An object representing a Server.",
  "type": "object",
  "required": [ "url", "scheme" ],
  "properties": {
    "url": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "scheme": {
      "description": "The transfer protocol.",
      "type": "string",
      "enum": [
        "kafka",
        "kafka-secure",
        "amqp",
        "amqps",
        "mqtt",
        "mqtts",
        "secure-mqtt",
        "ws",
        "wss",
        "stomp",
        "stomps"
      ]
    },
    "schemeVersion": {
      "type": "string"
    },
    "variables": {
      "$ref": "http://localhost:8000/draft-04/schemas/v1/servers/serverVariables.json"
    }
  },
  "patternProperties": {
    "^x-": {
      "$ref": "http://localhost:8000/draft-04/schemas/v1/vendorExtension.json"
    }
  },
  "additionalProperties": false
}
