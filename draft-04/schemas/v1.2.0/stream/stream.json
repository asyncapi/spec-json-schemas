{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "id": "http://localhost:8000/draft-04/schemas/v1.2.0/stream/stream.json",
  "title": "Stream Object",
  "type": "object",
  "minProperties": 1,
  "properties": {
    "framing": {
      "title": "Stream Framing Object",
      "type": "object",
      "oneOf": [
        {
          "properties": {
            "type": {
              "type": "string",
              "enum": [ "chunked" ]
            },
            "delimiter": {
              "default": "\\r\\n",
              "type": "string",
              "enum": [ "\\r\\n", "\\n" ]
            }
          },
          "additionalProperties": false
        },
        {
          "properties": {
            "type": {
              "type": "string",
              "enum": [ "sse" ]
            },
            "delimiter": {
              "default": "\\n\\n",
              "type": "string",
              "enum": [ "\\n\\n" ]
            }
          },
          "additionalProperties": false
        }
      ],
      "minProperties": 1,
      "patternProperties": {
        "^x-": {
          "$ref": "http://localhost:8000/draft-04/schemas/v1/vendorExtension.json"
        }
      }
    },
    "read": {
      "title": "Stream Read Object",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "http://localhost:8000/draft-04/schemas/v1.2.0/topics/messages/message.json"
      }
    },
    "write": {
      "title": "Stream Write Object",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "http://localhost:8000/draft-04/schemas/v1.2.0/topics/messages/message.json"
      }
    }
  },
  "patternProperties": {
    "^x-": {
      "$ref": "http://localhost:8000/draft-04/schemas/v1/vendorExtension.json"
    }
  },
  "additionalProperties": false
}
