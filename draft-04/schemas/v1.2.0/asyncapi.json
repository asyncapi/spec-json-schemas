{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "id": "http://localhost:8000/draft-04/schemas/v1.2.0/asyncapi.json",
  "title": "AsyncAPI 1.2.0 schema.",
  "type": "object",
  "oneOf": [
    {
      "required": [ "topics" ]
    },
    {
      "required": [ "stream" ]
    },
    {
      "required": [ "events" ]
    }
  ],
  "required": [ "asyncapi", "info" ],
  "properties": {
    "asyncapi": {
      "description": "The AsyncAPI specification version of this document.",
      "type": "string",
      "enum": [ "1.0.0", "1.1.0", "1.2.0" ]
    },
    "info": {
      "$ref": "http://localhost:8000/draft-04/schemas/v1/info/info.json"
    },
    "baseTopic": {
      "description": "The base topic to the API. Example: 'hitch'.",
      "default": "",
      "type": "string",
      "pattern": "^[^/.]"
    },
    "servers": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "http://localhost:8000/draft-04/schemas/v1.2.0/servers/server.json"
      }
    },
    "topics": {
      "$ref": "http://localhost:8000/draft-04/schemas/v1.2.0/topics/topics.json"
    },
    "stream": {
      "description": "The list of messages a consumer can read or write from/to a streaming API.",
      "$ref": "http://localhost:8000/draft-04/schemas/v1.2.0/stream/stream.json"
    },
    "events": {
      "description": "The list of messages an events API sends and/or receives.",
      "$ref": "http://localhost:8000/draft-04/schemas/v1.2.0/events/events.json"
    },
    "components": {
      "$ref": "http://localhost:8000/draft-04/schemas/v1.2.0/components/components.json"
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "http://localhost:8000/draft-04/schemas/v1/tag.json"
      }
    },
    "security": {
      "type": "array",
      "items": {
        "$ref": "http://localhost:8000/draft-04/schemas/v1/security/securityRequirement.json"
      }
    },
    "externalDocs": {
      "$ref": "http://localhost:8000/draft-04/schemas/v1/externalDocs.json"
    }
  },
  "patternProperties": {
    "^x-": {
      "$ref": "http://localhost:8000/draft-04/schemas/v1/vendorExtension.json"
    }
  },
  "additionalProperties": false
}
