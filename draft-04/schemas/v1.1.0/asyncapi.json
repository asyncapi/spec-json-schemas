{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "id": "http://localhost:8000/draft-04/schemas/v1.1.0/asyncapi.json",
  "title": "AsyncAPI 1.1.0 schema.",
  "type": "object",
  "required": [ "asyncapi", "info", "topics" ],
  "properties": {
    "asyncapi": {
      "description": "The AsyncAPI specification version of this document.",
      "type": "string",
      "enum": [ "1.0.0", "1.1.0" ]
    },
    "info": {
      "$ref": "http://localhost:8000/draft-04/schemas/v1/info/info.json"
    },
    "baseTopic": {
      "description": "The base topic to the API. Example: 'hitch'.",
      "default": "",
      "type": "string",
      "pattern": "^[^/.]"
    },
    "servers": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "http://localhost:8000/draft-04/schemas/v1.1.0/servers/server.json"
      }
    },
    "topics": {
      "$ref": "http://localhost:8000/draft-04/schemas/v1.1.0/topics/topics.json"
    },
    "components": {
      "$ref": "http://localhost:8000/draft-04/schemas/v1.1.0/components/components.json"
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "http://localhost:8000/draft-04/schemas/v1/tag.json"
      }
    },
    "security": {
      "type": "array",
      "items": {
        "$ref": "http://localhost:8000/draft-04/schemas/v1/security/securityRequirement.json"
      }
    },
    "externalDocs": {
      "$ref": "http://localhost:8000/draft-04/schemas/v1/externalDocs.json"
    }
  },
  "patternProperties": {
    "^x-": {
      "$ref": "http://localhost:8000/draft-04/schemas/v1/vendorExtension.json"
    }
  },
  "additionalProperties": false
}
