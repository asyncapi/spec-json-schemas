{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://asyncapi.pavelon.dev/bindings/googlepubsub/messageBinding.json",
  "title": "Google Cloud Pub/Sub - Message Binding",
  "description": "Describes protocol-specific definitions for a message",
  "examples": [
    {
      "orderingKey": "uuid",
      "schema": {
        "type": "avro",
        "name": "projects/your-project-id/schemas/your-avro-schema-id"
      },
      "bindingVersion": "0.1.0"
    },
    {
      "schema": {
        "name": "projects/your-project-id/schemas/your-protobuf-schema-id"
      },
      "bindingVersion": "0.2.0"
    }
  ],
  "type": "object",
  "allOf": [
    {
      "if": {
        "required": [ "bindingVersion" ],
        "properties": {
          "bindingVersion": {
            "const": "0.1.0"
          }
        }
      },
      "then": {
        "$ref": "https://asyncapi.pavelon.dev/bindings/googlepubsub/0.1.0/message.json"
      }
    },
    {
      "if": {
        "required": [ "bindingVersion" ],
        "properties": {
          "bindingVersion": {
            "const": "0.2.0"
          }
        }
      },
      "then": {
        "$ref": "https://asyncapi.pavelon.dev/bindings/googlepubsub/0.2.0/message.json"
      }
    },
    {
      "description": "If bindingVersion is omitted, than use latest JSON Schema",
      "if": {
        "not": {
          "required": [ "bindingVersion" ],
          "properties": {
            "bindingVersion": {
              "enum": [ "0.1.0", "0.2.0" ]
            }
          }
        }
      },
      "then": {
        "$ref": "https://asyncapi.pavelon.dev/bindings/googlepubsub/0.2.0/message.json"
      }
    }
  ]
}
