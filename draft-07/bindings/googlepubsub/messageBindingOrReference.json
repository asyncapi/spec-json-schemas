{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "http://localhost:8000/draft-07/bindings/googlepubsub/messageBindingOrReference.json",
  "title": "Mercure - Message Binding or Reference",
  "description": "Describes protocol-specific definitions for a message or it's reference",
  "examples": [
    {
      "$ref": "#/bindings/googlepubsub/my-googlepubsub-queue"
    },
    {
      "schema": {
        "name": "projects/your-project-id/schemas/your-protobuf-schema-id"
      },
      "bindingVersion": "0.2.0"
    }
  ],
  "type": "object",
  "if": {
    "required": [ "$ref" ],
    "properties": {
      "$ref": true
    }
  },
  "then": {
    "$ref": "http://localhost:8000/draft-07/schemas/reference.json"
  },
  "else": {
    "$ref": "http://localhost:8000/draft-07/bindings/googlepubsub/messageBinding.json"
  }
}
