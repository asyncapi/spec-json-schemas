{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "http://localhost:8000/draft-07/bindings/googlepubsub/operationBinding.json",
  "title": "Google Cloud Pub/Sub - Operation Binding",
  "description": "Describes protocol-specific definitions for a operation",
  "examples": [
    {
      "bindingVersion": "0.1.0"
    },
    {
      "bindingVersion": "0.2.0"
    }
  ],
  "type": "object",
  "allOf": [
    {
      "if": {
        "required": [ "bindingVersion" ],
        "properties": {
          "bindingVersion": {
            "const": "0.1.0"
          }
        }
      },
      "then": {
        "$ref": "http://localhost:8000/draft-07/bindings/googlepubsub/0.1.0/operation.json"
      }
    },
    {
      "if": {
        "required": [ "bindingVersion" ],
        "properties": {
          "bindingVersion": {
            "const": "0.2.0"
          }
        }
      },
      "then": {
        "$ref": "http://localhost:8000/draft-07/bindings/googlepubsub/0.2.0/operation.json"
      }
    },
    {
      "description": "If bindingVersion is omitted, than use latest JSON Schema",
      "if": {
        "not": {
          "required": [ "bindingVersion" ],
          "properties": {
            "bindingVersion": {
              "enum": [ "0.1.0", "0.2.0" ]
            }
          }
        }
      },
      "then": {
        "$ref": "http://localhost:8000/draft-07/bindings/googlepubsub/0.2.0/operation.json"
      }
    }
  ]
}
