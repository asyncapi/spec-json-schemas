{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://asyncapi.pavelon.dev/bindings/http/operationBindingOrReference.json",
  "title": "HTTP - Operation Binding or Reference",
  "description": "Describes protocol-specific definitions for a operation or it's reference",
  "examples": [
    {
      "$ref": "#/bindings/http/my-http-operation"
    },
    {
      "bindingVersion": "0.3.0",
      "method": "GET",
      "query": {
        "type": "object",
        "required": [ "companyId" ],
        "properties": {
          "companyId": {
            "description": "The Id of the company.",
            "type": "number",
            "minimum": 1
          }
        },
        "additionalProperties": false
      }
    }
  ],
  "type": "object",
  "if": {
    "required": [ "$ref" ],
    "properties": {
      "$ref": true
    }
  },
  "then": {
    "$ref": "https://asyncapi.pavelon.dev/schemas/reference.json"
  },
  "else": {
    "$ref": "https://asyncapi.pavelon.dev/bindings/http/operationBinding.json"
  }
}
