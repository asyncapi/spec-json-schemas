{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "http://localhost:8000/draft-07/bindings/ros2/serverBinding.json",
  "title": "ROS 2 - Server Binding",
  "description": "Describes protocol-specific definitions for a server",
  "examples": [
    {},
    {
      "bindingVersion": "latest"
    },
    {
      "domainId": 0,
      "rmwImplementation": "rmw_fastrtps_cpp"
    }
  ],
  "type": "object",
  "allOf": [
    {
      "if": {
        "required": [ "bindingVersion" ],
        "properties": {
          "bindingVersion": {
            "const": "0.1.0"
          }
        }
      },
      "then": {
        "$ref": "http://localhost:8000/draft-07/bindings/ros2/0.1.0/server.json"
      }
    },
    {
      "description": "If bindingVersion is omitted, than use latest JSON Schema",
      "if": {
        "not": {
          "required": [ "bindingVersion" ],
          "properties": {
            "bindingVersion": {
              "const": "0.1.0"
            }
          }
        }
      },
      "then": {
        "$ref": "http://localhost:8000/draft-07/bindings/ros2/0.1.0/server.json"
      }
    }
  ]
}
