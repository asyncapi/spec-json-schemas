{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "http://localhost:8000/draft-07/bindings/ros2/operationBindingOrReference.json",
  "title": "ROS 2 - Operation Binding or Reference",
  "description": "Describes protocol-specific definitions for a operation or it's reference",
  "examples": [
    {
      "$ref": "#/bindings/ros2/my-ros2-binding"
    },
    {
      "node": "/turtlesim",
      "qosPolicies": {
        "deadline": -1,
        "durability": "volatile",
        "history": "unknown",
        "leaseDuration": -1,
        "lifespan": -1,
        "liveliness": "automatic",
        "reliability": "reliable"
      },
      "role": "subscriber"
    }
  ],
  "type": "object",
  "if": {
    "required": [ "$ref" ],
    "properties": {
      "$ref": true
    }
  },
  "then": {
    "$ref": "http://localhost:8000/draft-07/schemas/reference.json"
  },
  "else": {
    "$ref": "http://localhost:8000/draft-07/bindings/ros2/operationBinding.json"
  }
}
