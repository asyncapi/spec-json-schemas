{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "http://localhost:8000/draft-07/bindings/nats/serverBindingOrReference.json",
  "title": "NATS - Server Binding or Reference",
  "description": "Describes protocol-specific definitions for a server or it's reference",
  "examples": [
    {
      "$ref": "#/bindings/nats/my-nats-server"
    },
    {
      "bindingVersion": "0.1.0"
    }
  ],
  "type": "object",
  "if": {
    "required": [ "$ref" ],
    "properties": {
      "$ref": true
    }
  },
  "then": {
    "$ref": "http://localhost:8000/draft-07/schemas/reference.json"
  },
  "else": {
    "$ref": "http://localhost:8000/draft-07/bindings/nats/serverBinding.json"
  }
}
