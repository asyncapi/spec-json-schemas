{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "http://localhost:8000/draft-07/bindings/anypointmq/channelBindingOrReference.json",
  "title": "Anypoint MQ - Channel Binding or Reference",
  "description": "Describes protocol-specific definitions for a channel or it's reference",
  "examples": [
    {
      "$ref": "#/bindings/anypointmq/my-anypointmq-queue"
    },
    {
      "bindingVersion": "0.0.1",
      "destination": "user-signup-fifo-queue",
      "destinationType": "fifo-queue"
    }
  ],
  "type": "object",
  "if": {
    "required": [ "$ref" ],
    "properties": {
      "$ref": true
    }
  },
  "then": {
    "$ref": "http://localhost:8000/draft-07/schemas/reference.json"
  },
  "else": {
    "$ref": "http://localhost:8000/draft-07/bindings/anypointmq/channelBinding.json"
  }
}
