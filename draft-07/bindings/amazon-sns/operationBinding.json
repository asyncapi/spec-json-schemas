{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://asyncapi.pavelon.dev/bindings/amazon-sns/operationBinding.json",
  "title": "Amazon SNS - Operation Binding",
  "description": "Describes protocol-specific definitions for a operation",
  "examples": [
    {
      "consumers": [
        {
          "endpoint": {
            "name": "someQueue"
          },
          "protocol": "sqs",
          "rawMessageDelivery": false
        }
      ],
      "topic": {
        "name": "someTopic"
      }
    },
    {
      "consumers": [
        {
          "endpoint": {
            "name": "someQueue"
          },
          "protocol": "sqs",
          "rawMessageDelivery": false
        }
      ],
      "topic": {
        "name": "someTopic"
      },
      "bindingVersion": "latest"
    },
    {
      "consumers": [
        {
          "endpoint": {
            "name": "someQueue"
          },
          "protocol": "sqs",
          "rawMessageDelivery": false
        }
      ],
      "topic": {
        "name": "someTopic"
      },
      "bindingVersion": "0.1.0"
    },
    {
      "consumers": [
        {
          "endpoint": {
            "name": "someQueue"
          },
          "protocol": "sqs",
          "rawMessageDelivery": false
        }
      ],
      "topic": {
        "name": "someTopic"
      },
      "bindingVersion": "0.2.0"
    }
  ],
  "type": "object",
  "allOf": [
    {
      "if": {
        "required": [ "bindingVersion" ],
        "properties": {
          "bindingVersion": {
            "const": "0.1.0"
          }
        }
      },
      "then": {
        "$ref": "https://asyncapi.pavelon.dev/bindings/amazon-sns/0.1.0/operation.json"
      }
    },
    {
      "if": {
        "required": [ "bindingVersion" ],
        "properties": {
          "bindingVersion": {
            "const": "0.2.0"
          }
        }
      },
      "then": {
        "$ref": "https://asyncapi.pavelon.dev/bindings/amazon-sns/0.2.0/operation.json"
      }
    },
    {
      "description": "If bindingVersion is omitted, than use latest JSON Schema",
      "if": {
        "not": {
          "required": [ "bindingVersion" ],
          "properties": {
            "bindingVersion": {
              "enum": [ "0.1.0", "0.2.0" ]
            }
          }
        }
      },
      "then": {
        "$ref": "https://asyncapi.pavelon.dev/bindings/amazon-sns/0.2.0/operation.json"
      }
    }
  ]
}
