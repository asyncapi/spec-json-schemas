{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "http://localhost:8000/draft-07/bindings/amazon-sns/channelBindingOrReference.json",
  "title": "Amazon SNS - Channel Binding or Reference",
  "description": "Describes protocol-specific definitions for a channel or it's reference",
  "examples": [
    {
      "$ref": "#/bindings/amazon-sns/my-sns-topic"
    },
    {
      "name": "my-sns-topic",
      "policy": {
        "statements": [
          {
            "action": "SNS:Publish",
            "effect": "Allow",
            "principal": "*"
          }
        ]
      },
      "bindingVersion": "0.1.0"
    }
  ],
  "type": "object",
  "if": {
    "required": [ "$ref" ],
    "properties": {
      "$ref": true
    }
  },
  "then": {
    "$ref": "http://localhost:8000/draft-07/schemas/reference.json"
  },
  "else": {
    "$ref": "http://localhost:8000/draft-07/bindings/amazon-sns/channelBinding.json"
  }
}
