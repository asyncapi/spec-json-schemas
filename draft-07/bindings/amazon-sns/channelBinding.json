{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://asyncapi.pavelon.dev/bindings/amazon-sns/channelBinding.json",
  "title": "Amazon SNS - Channel Binding",
  "description": "Describes protocol-specific definitions for a channel",
  "examples": [
    {
      "name": "my-sns-topic",
      "policy": {
        "statements": [
          {
            "action": "SNS:Publish",
            "effect": "Allow",
            "principal": "*"
          }
        ]
      },
      "bindingVersion": "0.1.0"
    },
    {
      "name": "my-sns-topic",
      "policy": {
        "statements": [
          {
            "action": "SNS:Publish",
            "effect": "Allow",
            "principal": "*",
            "condition": {
              "StringEquals": {
                "aws:SourceAccount": "123456789012"
              }
            }
          }
        ]
      },
      "bindingVersion": "0.2.0"
    },
    {
      "name": "my-sns-topic",
      "policy": {
        "statements": [
          {
            "action": "SNS:Publish",
            "effect": "Allow",
            "principal": "*",
            "condition": {
              "StringEquals": {
                "aws:SourceAccount": "123456789012"
              }
            }
          }
        ]
      }
    }
  ],
  "type": "object",
  "allOf": [
    {
      "if": {
        "required": [ "bindingVersion" ],
        "properties": {
          "bindingVersion": {
            "const": "0.1.0"
          }
        }
      },
      "then": {
        "$ref": "https://asyncapi.pavelon.dev/bindings/amazon-sns/0.1.0/channel.json"
      }
    },
    {
      "if": {
        "required": [ "bindingVersion" ],
        "properties": {
          "bindingVersion": {
            "const": "0.2.0"
          }
        }
      },
      "then": {
        "$ref": "https://asyncapi.pavelon.dev/bindings/amazon-sns/0.2.0/channel.json"
      }
    },
    {
      "description": "If bindingVersion is omitted, than use latest JSON Schema",
      "if": {
        "not": {
          "required": [ "bindingVersion" ],
          "properties": {
            "bindingVersion": {
              "enum": [ "0.1.0", "0.2.0" ]
            }
          }
        }
      },
      "then": {
        "$ref": "https://asyncapi.pavelon.dev/bindings/amazon-sns/0.2.0/channel.json"
      }
    }
  ]
}
