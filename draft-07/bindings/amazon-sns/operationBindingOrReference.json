{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "http://localhost:8000/draft-07/bindings/amazon-sns/operationBindingOrReference.json",
  "title": "Amazon SNS - Operation Binding or Reference",
  "description": "Describes protocol-specific definitions for a operation or it's reference",
  "examples": [
    {
      "$ref": "#/bindings/amazon-sns/my-sns-topic"
    },
    {
      "consumers": [
        {
          "endpoint": {
            "name": "someQueue"
          },
          "protocol": "sqs",
          "rawMessageDelivery": false
        }
      ],
      "topic": {
        "name": "someTopic"
      },
      "bindingVersion": "0.2.0"
    }
  ],
  "type": "object",
  "if": {
    "required": [ "$ref" ],
    "properties": {
      "$ref": true
    }
  },
  "then": {
    "$ref": "http://localhost:8000/draft-07/schemas/reference.json"
  },
  "else": {
    "$ref": "http://localhost:8000/draft-07/bindings/amazon-sns/operationBinding.json"
  }
}
