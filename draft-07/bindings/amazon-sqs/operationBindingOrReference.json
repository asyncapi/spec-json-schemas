{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "http://localhost:8000/draft-07/bindings/amazon-sqs/operationBindingOrReference.json",
  "title": "Amazon SQS - Operation Binding or Reference",
  "description": "Describes protocol-specific definitions for a operation or it's reference",
  "examples": [
    {
      "$ref": "#/bindings/amazon-sqs/my-sqs-operation"
    },
    {
      "queues": [
        {
          "name": "myQueue",
          "policy": {
            "statements": [
              {
                "action": [ "sqs:SendMessage", "sqs:ReceiveMessage" ],
                "effect": "Deny",
                "principal": "arn:aws:iam::123456789012:user/dec.kolakowski",
                "condition": {
                  "ArnEquals": {
                    "aws:SourceArn": "arn:aws:sns:us-east-1:123456789012:MyTopic"
                  }
                }
              }
            ]
          }
        }
      ],
      "bindingVersion": "0.3.0"
    }
  ],
  "type": "object",
  "if": {
    "required": [ "$ref" ],
    "properties": {
      "$ref": true
    }
  },
  "then": {
    "$ref": "http://localhost:8000/draft-07/schemas/reference.json"
  },
  "else": {
    "$ref": "http://localhost:8000/draft-07/bindings/amazon-sqs/operationBinding.json"
  }
}
