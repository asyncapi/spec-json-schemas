{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "http://localhost:8000/draft-07/bindings/jms/operationBinding.json",
  "title": "JMS - Operation Binding",
  "description": "Describes protocol-specific definitions for a operation",
  "examples": [
    {},
    {
      "bindingVersion": "latest"
    },
    {
      "bindingVersion": "0.0.1"
    }
  ],
  "type": "object",
  "allOf": [
    {
      "if": {
        "required": [ "bindingVersion" ],
        "properties": {
          "bindingVersion": {
            "const": "0.0.1"
          }
        }
      },
      "then": {
        "$ref": "http://localhost:8000/draft-07/bindings/jms/0.0.1/operation.json"
      }
    },
    {
      "description": "If bindingVersion is omitted, than use latest JSON Schema",
      "if": {
        "not": {
          "required": [ "bindingVersion" ],
          "properties": {
            "bindingVersion": {
              "const": "0.0.1"
            }
          }
        }
      },
      "then": {
        "$ref": "http://localhost:8000/draft-07/bindings/jms/0.0.1/operation.json"
      }
    }
  ]
}
