{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "http://localhost:8000/draft-07/bindings/ibmmq/messageBindingOrReference.json",
  "title": "IBM MQ - Message Binding or Reference",
  "description": "Describes protocol-specific definitions for a message or it's reference",
  "examples": [
    {
      "$ref": "#/bindings/ibmmq/my-ibmmq-queue"
    },
    {
      "type": "binary",
      "description": "Binary message",
      "expiry": 10,
      "headers": "k=v;",
      "bindingVersion": "0.1.0"
    }
  ],
  "type": "object",
  "if": {
    "required": [ "$ref" ],
    "properties": {
      "$ref": true
    }
  },
  "then": {
    "$ref": "http://localhost:8000/draft-07/schemas/reference.json"
  },
  "else": {
    "$ref": "http://localhost:8000/draft-07/bindings/ibmmq/messageBinding.json"
  }
}
