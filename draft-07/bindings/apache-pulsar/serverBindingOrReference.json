{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "http://localhost:8000/draft-07/bindings/apache-pulsar/serverBindingOrReference.json",
  "title": "Apache Pulsar - Server Binding or Reference",
  "description": "Describes protocol-specific definitions for a server or it's reference",
  "examples": [
    {
      "$ref": "#/bindings/apache-pulsar/my-apache-pulsar-server"
    },
    {
      "bindingVersion": "0.1.0",
      "tenant": "contoso"
    }
  ],
  "type": "object",
  "if": {
    "required": [ "$ref" ],
    "properties": {
      "$ref": true
    }
  },
  "then": {
    "$ref": "http://localhost:8000/draft-07/schemas/reference.json"
  },
  "else": {
    "$ref": "http://localhost:8000/draft-07/bindings/apache-pulsar/serverBinding.json"
  }
}
