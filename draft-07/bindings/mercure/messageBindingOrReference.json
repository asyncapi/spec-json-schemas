{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://asyncapi.pavelon.dev/bindings/mercure/messageBindingOrReference.json",
  "title": "Mercure - Message Binding or Reference",
  "description": "Describes protocol-specific definitions for a message or it's reference",
  "examples": [
    {
      "$ref": "#/bindings/mercure/my-mercure-queue"
    },
    {
      "bindingVersion": "0.1.0"
    }
  ],
  "type": "object",
  "if": {
    "required": [ "$ref" ],
    "properties": {
      "$ref": true
    }
  },
  "then": {
    "$ref": "https://asyncapi.pavelon.dev/schemas/reference.json"
  },
  "else": {
    "$ref": "https://asyncapi.pavelon.dev/bindings/mercure/messageBinding.json"
  }
}
