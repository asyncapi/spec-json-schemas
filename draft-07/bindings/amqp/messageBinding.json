{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://asyncapi.pavelon.dev/bindings/amqp/messageBinding.json",
  "title": "AMQP 0-9-1 - Message Binding",
  "description": "Describes protocol-specific definitions for a message",
  "examples": [
    {
      "contentEncoding": "gzip",
      "messageType": "user.signup",
      "bindingVersion": "0.1.0"
    },
    {
      "contentEncoding": "gzip",
      "messageType": "user.signup",
      "bindingVersion": "0.2.0"
    },
    {
      "contentEncoding": "gzip",
      "messageType": "user.signup",
      "bindingVersion": "0.3.0"
    },
    {
      "contentEncoding": "gzip",
      "messageType": "user.signup",
      "bindingVersion": "latest"
    }
  ],
  "type": "object",
  "allOf": [
    {
      "if": {
        "required": [ "bindingVersion" ],
        "properties": {
          "bindingVersion": {
            "const": "0.1.0"
          }
        }
      },
      "then": {
        "$ref": "https://asyncapi.pavelon.dev/bindings/amqp/0.1.0/message.json"
      }
    },
    {
      "if": {
        "required": [ "bindingVersion" ],
        "properties": {
          "bindingVersion": {
            "const": "0.2.0"
          }
        }
      },
      "then": {
        "$ref": "https://asyncapi.pavelon.dev/bindings/amqp/0.2.0/message.json"
      }
    },
    {
      "if": {
        "required": [ "bindingVersion" ],
        "properties": {
          "bindingVersion": {
            "const": "0.3.0"
          }
        }
      },
      "then": {
        "$ref": "https://asyncapi.pavelon.dev/bindings/amqp/0.3.0/message.json"
      }
    },
    {
      "description": "If bindingVersion is omitted, than use latest JSON Schema",
      "if": {
        "not": {
          "required": [ "bindingVersion" ],
          "properties": {
            "bindingVersion": {
              "enum": [ "0.1.0", "0.2.0", "0.3.0" ]
            }
          }
        }
      },
      "then": {
        "$ref": "https://asyncapi.pavelon.dev/bindings/amqp/0.3.0/message.json"
      }
    }
  ]
}
