{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "http://localhost:8000/draft-07/bindings/websockets/channelBindingOrReference.json",
  "title": "WebSockets - Channel Binding or Reference",
  "description": "Describes protocol-specific definitions for a channel or it's reference",
  "examples": [
    {
      "$ref": "#/bindings/amqp/my-amqp-queue"
    },
    {
      "bindingVersion": "0.1.0",
      "headers": {
        "session-id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "method": "GET"
    }
  ],
  "type": "object",
  "if": {
    "required": [ "$ref" ],
    "properties": {
      "$ref": true
    }
  },
  "then": {
    "$ref": "http://localhost:8000/draft-07/schemas/reference.json"
  },
  "else": {
    "$ref": "http://localhost:8000/draft-07/bindings/websockets/channelBinding.json"
  }
}
