{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://asyncapi.pavelon.dev/bindings/websockets/channelBinding.json",
  "title": "WebSockets - Channel Binding",
  "description": "Describes protocol-specific definitions for a channel",
  "examples": [
    {},
    {
      "bindingVersion": "latest"
    },
    {
      "bindingVersion": "0.1.0",
      "headers": {
        "session-id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "method": "GET"
    }
  ],
  "type": "object",
  "allOf": [
    {
      "if": {
        "required": [ "bindingVersion" ],
        "properties": {
          "bindingVersion": {
            "const": "0.1.0"
          }
        }
      },
      "then": {
        "$ref": "https://asyncapi.pavelon.dev/bindings/websockets/0.1.0/channel.json"
      }
    },
    {
      "description": "If bindingVersion is omitted, than use latest JSON Schema",
      "if": {
        "not": {
          "required": [ "bindingVersion" ],
          "properties": {
            "bindingVersion": {
              "const": "0.1.0"
            }
          }
        }
      },
      "then": {
        "$ref": "https://asyncapi.pavelon.dev/bindings/websockets/0.1.0/channel.json"
      }
    }
  ]
}
