{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "http://localhost:8000/draft-07/schemas/v2.0.0-rc2/channels/messages/message.json",
  "title": "AsyncAPI v2.0.0-rc2 - Channel Operation Message",
  "description": "Describes a message received on a given channel and operation",
  "oneOf": [
    {
      "$ref": "http://localhost:8000/draft-07/schemas/reference.json"
    },
    {
      "oneOf": [
        {
          "type": "object",
          "required": [ "oneOf" ],
          "properties": {
            "oneOf": {
              "type": "array",
              "items": {
                "$ref": "http://localhost:8000/draft-07/schemas/v2.0.0-rc2/channels/messages/message.json"
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "schemaFormat": {
              "type": "string"
            },
            "contentType": {
              "type": "string"
            },
            "headers": {
              "$ref": "http://localhost:8000/draft-07/schemas/v2.0.0-rc2/schema.json"
            },
            "payload": {},
            "correlationId": {
              "oneOf": [
                {
                  "$ref": "http://localhost:8000/draft-07/schemas/reference.json"
                },
                {
                  "$ref": "http://localhost:8000/draft-07/schemas/v2/channels/messages/correlationId.json"
                }
              ]
            },
            "tags": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "http://localhost:8000/draft-07/schemas/v2/tag.json"
              }
            },
            "summary": {
              "description": "A brief summary of the message.",
              "type": "string"
            },
            "name": {
              "description": "Name of the message.",
              "type": "string"
            },
            "title": {
              "description": "A human-friendly title for the message.",
              "type": "string"
            },
            "description": {
              "description": "A longer description of the message. CommonMark is allowed.",
              "type": "string"
            },
            "externalDocs": {
              "$ref": "http://localhost:8000/draft-07/schemas/v2/externalDocs.json"
            },
            "deprecated": {
              "default": false,
              "type": "boolean"
            },
            "examples": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "bindings": {
              "$ref": "http://localhost:8000/draft-07/schemas/v2.0.0-rc2/bindingsObject.json"
            },
            "traits": {
              "type": "array",
              "items": {
                "oneOf": [
                  {
                    "$ref": "http://localhost:8000/draft-07/schemas/reference.json"
                  },
                  {
                    "$ref": "http://localhost:8000/draft-07/schemas/v2.0.0-rc2/channels/messages/messageTrait.json"
                  }
                ]
              }
            }
          },
          "patternProperties": {
            "^x-[\\w\\d\\.\\x2d_]+$": true
          },
          "additionalProperties": false
        }
      ]
    }
  ]
}
