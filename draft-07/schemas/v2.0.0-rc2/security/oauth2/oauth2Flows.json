{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "http://localhost:8080/draft-07/schemas/v2.0.0-rc2/security/oauth2/oauth2Flows.json",
  "type": "object",
  "required": [ "type", "flows" ],
  "properties": {
    "type": {
      "type": "string",
      "enum": [ "oauth2" ]
    },
    "description": {
      "type": "string"
    },
    "flows": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "implicit": {
          "allOf": [
            {
              "$ref": "http://localhost:8080/draft-07/schemas/v2.0.0-rc2/security/oauth2/oauth2Flow.json"
            },
            {
              "required": [ "authorizationUrl", "scopes" ]
            },
            {
              "not": {
                "required": [ "tokenUrl" ]
              }
            }
          ]
        },
        "password": {
          "allOf": [
            {
              "$ref": "http://localhost:8080/draft-07/schemas/v2.0.0-rc2/security/oauth2/oauth2Flow.json"
            },
            {
              "required": [ "tokenUrl", "scopes" ]
            },
            {
              "not": {
                "required": [ "authorizationUrl" ]
              }
            }
          ]
        },
        "clientCredentials": {
          "allOf": [
            {
              "$ref": "http://localhost:8080/draft-07/schemas/v2.0.0-rc2/security/oauth2/oauth2Flow.json"
            },
            {
              "required": [ "tokenUrl", "scopes" ]
            },
            {
              "not": {
                "required": [ "authorizationUrl" ]
              }
            }
          ]
        },
        "authorizationCode": {
          "allOf": [
            {
              "$ref": "http://localhost:8080/draft-07/schemas/v2.0.0-rc2/security/oauth2/oauth2Flow.json"
            },
            {
              "required": [ "authorizationUrl", "tokenUrl", "scopes" ]
            }
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "patternProperties": {
    "^x-[\\w\\d\\.\\x2d_]+$": true
  }
}
