{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "http://localhost:8000/draft-07/schemas/v2.0.0-rc2/security/oauth2/oauth2Flows.json",
  "title": "AsyncAPI v2.0.0-rc2 - OAuth2 flows",
  "description": "Contains information about OAuth2 flows",
  "type": "object",
  "required": [ "type", "flows" ],
  "examples": [
    {
      "type": "oauth2",
      "description": "oauth2",
      "flows": {
        "authorizationCode": {
          "authorizationUrl": "https://example.com/api/oauth/dialog",
          "tokenUrl": "https://example.com/api/oauth/token",
          "refreshUrl": "https://example.com/api/oauth/refresh",
          "scopes": {
            "write:pets": "modify pets in your account",
            "read:pets": "read your pets"
          }
        },
        "clientCredentials": {
          "tokenUrl": "https://example.com/api/oauth/token",
          "refreshUrl": "https://example.com/api/oauth/refresh",
          "scopes": {
            "write:pets": "modify pets in your account",
            "read:pets": "read your pets"
          }
        },
        "implicit": {
          "authorizationUrl": "https://example.com/api/oauth/dialog",
          "refreshUrl": "https://example.com/api/oauth/refresh",
          "scopes": {
            "write:pets": "modify pets in your account",
            "read:pets": "read your pets"
          }
        },
        "password": {
          "tokenUrl": "https://example.com/api/oauth/token",
          "refreshUrl": "https://example.com/api/oauth/refresh",
          "scopes": {
            "write:pets": "modify pets in your account",
            "read:pets": "read your pets"
          }
        }
      },
      "scopes": [ "write:pets", "read:pets" ]
    }
  ],
  "properties": {
    "type": {
      "type": "string",
      "enum": [ "oauth2" ]
    },
    "description": {
      "type": "string"
    },
    "flows": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "implicit": {
          "allOf": [
            {
              "$ref": "http://localhost:8000/draft-07/schemas/v2.0.0-rc2/security/oauth2/oauth2Flow.json"
            },
            {
              "required": [ "authorizationUrl", "scopes" ]
            },
            {
              "not": {
                "required": [ "tokenUrl" ]
              }
            }
          ]
        },
        "password": {
          "allOf": [
            {
              "$ref": "http://localhost:8000/draft-07/schemas/v2.0.0-rc2/security/oauth2/oauth2Flow.json"
            },
            {
              "required": [ "tokenUrl", "scopes" ]
            },
            {
              "not": {
                "required": [ "authorizationUrl" ]
              }
            }
          ]
        },
        "clientCredentials": {
          "allOf": [
            {
              "$ref": "http://localhost:8000/draft-07/schemas/v2.0.0-rc2/security/oauth2/oauth2Flow.json"
            },
            {
              "required": [ "tokenUrl", "scopes" ]
            },
            {
              "not": {
                "required": [ "authorizationUrl" ]
              }
            }
          ]
        },
        "authorizationCode": {
          "allOf": [
            {
              "$ref": "http://localhost:8000/draft-07/schemas/v2.0.0-rc2/security/oauth2/oauth2Flow.json"
            },
            {
              "required": [ "authorizationUrl", "tokenUrl", "scopes" ]
            }
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "patternProperties": {
    "^x-[\\w\\d\\.\\x2d_]+$": true
  }
}
