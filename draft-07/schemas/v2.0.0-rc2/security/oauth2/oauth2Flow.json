{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "http://localhost:8080/draft-07/schemas/v2.0.0-rc2/security/oauth2/oauth2Flow.json",
  "type": "object",
  "properties": {
    "authorizationUrl": {
      "type": "string",
      "format": "uri"
    },
    "tokenUrl": {
      "type": "string",
      "format": "uri"
    },
    "refreshUrl": {
      "type": "string",
      "format": "uri"
    },
    "scopes": {
      "$ref": "http://localhost:8080/draft-07/schemas/v2.0.0-rc2/security/oauth2/oauth2Scopes.json"
    }
  },
  "patternProperties": {
    "^x-[\\w\\d\\.\\x2d_]+$": true
  },
  "additionalProperties": false
}
