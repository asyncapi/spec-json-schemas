{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "http://localhost:8000/draft-07/schemas/v2.0.0-rc2/asyncapi.json",
  "title": "AsyncAPI v2.0.0-rc2",
  "description": "AsyncAPI 2.0.0-rc2 JSON Schema",
  "type": "object",
  "required": [ "asyncapi", "info", "channels" ],
  "properties": {
    "asyncapi": {
      "description": "The AsyncAPI specification version of this document",
      "type": "string",
      "const": "2.0.0-rc2"
    },
    "id": {
      "description": "A unique id representing the application",
      "type": "string",
      "format": "uri"
    },
    "info": {
      "$ref": "http://localhost:8000/draft-07/schemas/v2/info/info.json"
    },
    "servers": {
      "type": "object",
      "additionalProperties": {
        "$ref": "http://localhost:8000/draft-07/schemas/v2.0.0-rc2/servers/server.json"
      }
    },
    "defaultContentType": {
      "type": "string"
    },
    "channels": {
      "$ref": "http://localhost:8000/draft-07/schemas/v2.0.0-rc2/channels/channels.json"
    },
    "components": {
      "$ref": "http://localhost:8000/draft-07/schemas/v2.0.0-rc2/components/components.json"
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "http://localhost:8000/draft-07/schemas/v2/tag.json"
      }
    },
    "externalDocs": {
      "$ref": "http://localhost:8000/draft-07/schemas/v2/externalDocs.json"
    }
  },
  "patternProperties": {
    "^x-[\\w\\d\\.\\x2d_]+$": true
  },
  "additionalProperties": false
}
