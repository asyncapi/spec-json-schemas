    "securitySchemes": {
      "type": "object",
      "patternProperties": {
        "^[\\w\\d\\.\\-_]+$": {
          "oneOf": [
            {
              "$ref": "http://localhost:8000/draft-07/schemas/reference.json"
            },
            {
              "$ref": "http://localhost:8000/draft-07/schemas/v2.0.0-rc2/security/securitySchema.json"
            }
          ]
        }
      }
    },
    "parameters": {
      "$ref": "http://localhost:8000/draft-07/schemas/v2.0.0-rc2/channels/parameters.json"
