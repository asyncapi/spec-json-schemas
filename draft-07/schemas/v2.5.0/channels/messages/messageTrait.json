{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "http://localhost:8000/draft-07/schemas/v2.5.0/channels/messages/messageTrait.json",
  "title": "AsyncAPI v2.5.0 - Channel Operation Message Trait",
  "description": "Describes a trait that MAY be applied to an Channel Operation Message",
  "examples": [
    {
      "messageId": "userSignup",
      "summary": "Action to sign a user up.",
      "description": "A longer description",
      "schemaFormat": "application/vnd.apache.avro+json;version=1.9.0",
      "examples": [
        {
          "name": "SimpleSignup",
          "summary": "A simple UserSignup example message",
          "headers": {
            "correlationId": "my-correlation-id",
            "applicationInstanceId": "myInstanceId"
          },
          "payload": {
            "user": {
              "someUserKey": "someUserValue"
            },
            "signup": {
              "someSignupKey": "someSignupValue"
            }
          }
        }
      ]
    }
  ],
  "type": "object",
  "properties": {
    "schemaFormat": {
      "description": "A string containing the name of the schema format/language used to define the message payload",
      "type": "string"
    },
    "contentType": {
      "description": "The content type to use when encoding/decoding a message's payload",
      "type": "string"
    },
    "headers": {
      "description": "Schema definition of the application headers",
      "allOf": [
        {
          "$ref": "http://localhost:8000/draft-07/schemas/v2/schema.json"
        },
        {
          "properties": {
            "type": {
              "const": "object"
            }
          }
        }
      ]
    },
    "messageId": {
      "description": "Unique string used to identify the message. The id MUST be unique among all messages described in the API",
      "type": "string"
    },
    "correlationId": {
      "description": "Definition of the correlation ID used for message tracing or matching",
      "oneOf": [
        {
          "$ref": "http://localhost:8000/draft-07/schemas/reference.json"
        },
        {
          "$ref": "http://localhost:8000/draft-07/schemas/v2/channels/messages/correlationId.json"
        }
      ]
    },
    "tags": {
      "description": "A list of tags for logical grouping and categorization of messages",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "http://localhost:8000/draft-07/schemas/v2/tag.json"
      }
    },
    "summary": {
      "description": "A brief summary of the message",
      "type": "string"
    },
    "name": {
      "description": "Name of the message",
      "type": "string"
    },
    "title": {
      "description": "A human-friendly title for the message",
      "type": "string"
    },
    "description": {
      "description": "A longer description of the message. CommonMark is allowed",
      "type": "string"
    },
    "externalDocs": {
      "$ref": "http://localhost:8000/draft-07/schemas/v2/externalDocs.json"
    },
    "deprecated": {
      "default": false,
      "type": "boolean"
    },
    "examples": {
      "description": "List of examples",
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "bindings": {
      "$ref": "http://localhost:8000/draft-07/schemas/v2.5.0/messageBindings.json"
    }
  },
  "patternProperties": {
    "^x-[\\w\\d\\.\\x2d_]+$": true
  },
  "additionalProperties": false
}
