{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "http://localhost:8080/draft-07/schemas/v2/asyncapi-2.6.0.json",
  "title": "AsyncAPI v2.6.0",
  "description": "AsyncAPI 2.6.0 JSON Schema",
  "type": "object",
  "required": [ "asyncapi", "info", "channels" ],
  "properties": {
    "asyncapi": {
      "description": "The AsyncAPI specification version of this document.",
      "type": "string",
      "enum": [ "2.6.0" ]
    },
    "id": {
      "description": "A unique id representing the application.",
      "type": "string",
      "format": "uri"
    },
    "info": {
      "$ref": "http://localhost:8080/draft-07/schemas/v2/info/info.json"
    },
    "servers": {
      "$ref": "https://asyncapi.com/definitions/2.6.0/servers.json"
    },
    "defaultContentType": {
      "type": "string"
    },
    "channels": {
      "$ref": "http://localhost:8080/draft-07/schemas/v2/channels/channels.json"
    },
    "components": {
      "$ref": "https://asyncapi.com/definitions/2.6.0/components.json"
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "http://asyncapi.com/definitions/2.6.0/tag.json"
      }
    },
    "externalDocs": {
      "$ref": "http://localhost:8080/draft-07/schemas/v2/externalDocs.json"
    }
  },
  "patternProperties": {
    "^x-[\\w\\d\\.\\x2d_]+$": true
  },
  "additionalProperties": false
}
