{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "http://localhost:8080/draft-07/schemas/v2.1.0/channels/operations/operationTrait.json",
  "title": "AsyncAPI v2.1.0 - Channel Operation Trait",
  "description": "Describes a trait that MAY be applied to an Channel Operation",
  "examples": [
    {
      "operationId": "sendMessage",
      "summary": "Send message",
      "description": "Send message to remote server",
      "tags": [
        {
          "name": "messages",
          "description": "operations with messages",
          "externalDocs": {
            "description": "Messages validation rules",
            "url": "messages/validation-rules"
          }
        }
      ],
      "externalDocs": {
        "description": "Messages sending rules",
        "url": "messages/sending-rules"
      }
    }
  ],
  "type": "object",
  "properties": {
    "summary": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "http://localhost:8080/draft-07/schemas/v2/tag.json"
      }
    },
    "externalDocs": {
      "$ref": "http://localhost:8080/draft-07/schemas/v2/externalDocs.json"
    },
    "operationId": {
      "type": "string"
    },
    "bindings": {
      "$ref": "http://localhost:8080/draft-07/schemas/v2.1.0/bindingsObject.json"
    }
  },
  "patternProperties": {
    "^x-[\\w\\d\\.\\x2d_]+$": true
  },
  "additionalProperties": false
}
