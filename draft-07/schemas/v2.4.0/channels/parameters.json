{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "http://localhost:8080/draft-07/schemas/v2.4.0/channels/parameters.json",
  "title": "AsyncAPI v2.4.0 - Channel Parameters Map",
  "description": "A key-value map where key is parameter ID and value is parameter representation",
  "examples": [
    {
      "accessToken": {
        "location": "$message.header#/authorization"
      }
    }
  ],
  "type": "object",
  "additionalProperties": {
    "if": {
      "required": [ "$ref" ],
      "properties": {
        "$ref": true
      }
    },
    "then": {
      "$ref": "https://asyncapi.pavelon.dev/schemas/reference.json"
    },
    "else": {
      "$ref": "http://localhost:8080/draft-07/schemas/v2.4.0/channels/parameters.json"
    }
  }
}
