{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "http://localhost:8080/draft-07/schemas/v2.4.0/channels/operations/operation.json",
  "title": "AsyncAPI v2.4.0 - Channel Operation",
  "description": "Describes a publish or a subscribe operation. This provides a place to document how and why messages are sent and received",
  "examples": [
    {
      "operationId": "sendMessage",
      "summary": "Send message",
      "description": "Send message to remote server"
    },
    {
      "operationId": "sendMessage",
      "summary": "Send message",
      "description": "Send message to remote server",
      "externalDocs": {
        "description": "Messages sending rules",
        "url": "messages/sending-rules"
      }
    },
    {
      "operationId": "sendMessage",
      "summary": "Secured Send message",
      "security": [
        {
          "type": "userPassword",
          "description": "Sent inside the initial CONNECT message"
        }
      ]
    },
    {
      "operationId": "sendMessage",
      "summary": "Send message",
      "description": "Send message to remote server",
      "message": {
        "headers": {
          "type": "object",
          "properties": {
            "correlationId": {
              "description": "Correlation ID set by application",
              "type": "string"
            },
            "applicationInstanceId": {
              "description": "Unique identifier for a given instance of the publishing application",
              "type": "string"
            }
          }
        },
        "payload": {
          "type": "object",
          "properties": {
            "user": {
              "$ref": "#/components/schemas/userCreate"
            },
            "signup": {
              "$ref": "#/components/schemas/signup"
            }
          }
        },
        "correlationId": {
          "description": "Default Correlation ID",
          "location": "$message.header#/correlationId"
        },
        "schemaFormat": "application/vnd.apache.avro+json;version=1.9.0",
        "contentType": "application/json",
        "name": "UserSignup"
      }
    },
    {
      "operationId": "sendMessage",
      "tags": [
        {
          "name": "messages",
          "description": "operations with messages",
          "externalDocs": {
            "description": "Messages validation rules",
            "url": "messages/validation-rules"
          }
        }
      ],
      "traits": [
        {
          "$ref": "#/components/operationTraits/sendMessage"
        },
        {
          "operationId": "sendMessage",
          "summary": "Send message",
          "description": "Send message to remote server",
          "tags": [
            {
              "name": "messages",
              "description": "operations with messages",
              "externalDocs": {
                "description": "Messages validation rules",
                "url": "messages/validation-rules"
              }
            }
          ],
          "externalDocs": {
            "description": "Messages sending rules",
            "url": "messages/sending-rules"
          }
        }
      ]
    }
  ],
  "type": "object",
  "properties": {
    "traits": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "https://asyncapi.pavelon.dev/schemas/reference.json"
          },
          {
            "$ref": "http://localhost:8080/draft-07/schemas/v2.4.0/channels/operations/operationTrait.json"
          }
        ]
      }
    },
    "summary": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "security": {
      "type": "array",
      "items": {
        "$ref": "http://localhost:8080/draft-07/schemas/v2/security/securitySchema.json"
      }
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "http://localhost:8080/draft-07/schemas/v2/tag.json"
      }
    },
    "externalDocs": {
      "$ref": "http://localhost:8080/draft-07/schemas/v2/externalDocs.json"
    },
    "operationId": {
      "type": "string"
    },
    "bindings": {
      "$ref": "http://localhost:8080/draft-07/schemas/v2.4.0/bindingsObject.json"
    },
    "message": {
      "$ref": "http://localhost:8080/draft-07/schemas/v2.4.0/channels/messages/message.json"
    }
  },
  "patternProperties": {
    "^x-[\\w\\d\\.\\x2d_]+$": true
  },
  "additionalProperties": false
}
