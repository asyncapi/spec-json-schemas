{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "http://localhost:8080/draft-07/schemas/v2/security/userPassword.json",
  "title": "AsyncAPI v2 - user/password Authentication",
  "description": "Contains information about user/password Authentication",
  "examples": [
    {
      "type": "userPassword"
    },
    {
      "type": "userPassword",
      "description": "Security process that verifies a user's identity using a unique username and a secret password, involving registration, secure storage via hashing, and login verification"
    }
  ],
  "type": "object",
  "required": [ "type" ],
  "properties": {
    "description": {
      "type": "string"
    },
    "type": {
      "const": "userPassword"
    }
  },
  "patternProperties": {
    "^x-[\\w\\d\\.\\x2d_]+$": true
  },
  "additionalProperties": false
}
