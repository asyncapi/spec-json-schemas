    },
    {
      "$ref": "http://localhost:8080/draft-07/schemas/v2/security/http/httpSecuritySchema.json"
    },
    {
      "$ref": "http://localhost:8080/draft-07/schemas/v2/security/oauth2/oauth2.json"
    },
    {
      "$ref": "http://localhost:8080/draft-07/schemas/v2/security/openIdConnect.json"
