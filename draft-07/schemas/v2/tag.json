{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "http://localhost:8080/draft-07/schemas/v2/tag.json",
  "title": "AsyncAPI v2 - Tag",
  "description": "Allows adding metadata to a single tag",
  "examples": [
    {
      "name": "city"
    },
    {
      "name": "city",
      "description": "City forecast for e.g. Yerevan"
    },
    {
      "name": "city",
      "externalDocs": {
        "url": "https://api.weather-forecast.am/docs",
        "description": "Required information to integrate with API"
      }
    }
  ],
  "type": "object",
  "required": [ "name" ],
  "properties": {
    "name": {
      "description": "The name of the tag",
      "type": "string"
    },
    "description": {
      "description": "A short description for the tag",
      "type": "string"
    },
    "externalDocs": {
      "description": "Additional external documentation for this tag",
      "$ref": "http://localhost:8080/draft-07/schemas/v2/externalDocs.json"
    }
  },
  "patternProperties": {
    "^x-[\\w\\d\\.\\x2d_]+$": true
  },
  "additionalProperties": false
}
