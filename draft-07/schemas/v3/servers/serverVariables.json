{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://asyncapi.pavelon.dev/schemas/v3/servers/serverVariables.json",
  "title": "AsyncAPI v3.0.0 - Server Variables Map",
  "description": "A key-value map where key is variable ID and value is variable representation",
  "examples": [
    {
      "port": {
        "enum": [
          "8883",
          "8884"
        ],
        "default": "8883",
        "description": "Ports application listening for",
        "examples": [
          "8883",
          "8884"
        ]
      },
      "basePath": {
        "$ref": "#/variables/base-path"
      }
    }
  ],
  "type": "object",
  "additionalProperties": {
    "if": {
      "required": [ "$ref" ],
      "properties": {
        "$ref": true
      }
    },
    "then": {
      "$ref": "https://asyncapi.pavelon.dev/schemas/reference.json"
    },
    "else": {
      "$ref": "https://asyncapi.pavelon.dev/schemas/v3/servers/serverVariable.json"
    }
  }
}
