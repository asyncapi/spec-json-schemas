{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://asyncapi.pavelon.dev/schemas/v3/servers/servers.json",
  "title": "AsyncAPI v3.0.0 - Servers Map",
  "description": "A key-value map where key is server ID and value is server representation",
  "examples": [
    {
      "mqtt": {
        "$ref": "#/servers/mqtt"
      }
    },
    {
      "secure-mqtt": {
        "host": "{username}.gigantic-server.com:{port}/{basePath}",
        "protocol": "secure-mqtt",
        "protocolVersion": "5.0"
      }
    },
    {
      "mqtt": {
        "$ref": "#/servers/mqtt"
      },
      "secure-mqtt": {
        "host": "{username}.gigantic-server.com:{port}/{basePath}",
        "protocol": "secure-mqtt",
        "protocolVersion": "5.0"
      }
    }
  ],
  "type": "object",
  "additionalProperties": {
    "if": {
      "required": [ "$ref" ],
      "properties": {
        "$ref": true
      }
    },
    "then": {
      "$ref": "https://asyncapi.pavelon.dev/schemas/reference.json"
    },
    "else": {
      "$ref": "https://asyncapi.pavelon.dev/schemas/v3/servers/server.json"
    }
  }
}
