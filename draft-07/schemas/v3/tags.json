{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "http://localhost:8000/draft-07/schemas/v3/tags.json",
  "title": "AsyncAPI v3.0.0 - Tags",
  "description": "Collection of Tags",
  "examples": [
    [
      {
        "$ref": "#/tags/secured"
      },
      {
        "name": "secured",
        "description": "Groups secured APIs"
      }
    ]
  ],
  "type": "array",
  "uniqueItems": true,
  "items": {
    "if": {
      "required": [ "$ref" ],
      "properties": {
        "$ref": true
      }
    },
    "then": {
      "$ref": "http://localhost:8000/draft-07/schemas/reference.json"
    },
    "else": {
      "$ref": "http://localhost:8000/draft-07/schemas/v3/tag.json"
    }
  }
}
