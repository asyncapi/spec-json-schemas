{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://asyncapi.pavelon.dev/schemas/v3/components/components.json",
  "title": "AsyncAPI v3 - Components",
  "description": "An object to hold a set of reusable objects for different aspects of the AsyncAPI specification. All objects defined within the components object will have no effect on the API unless they are explicitly referenced from properties outside the components object",
  "examples": [
    {
      "schemas": {
        "multiformat-schema": {
          "schemaFormat": "application/schema+json;version=draft-07",
          "schema": {
            "$id": "https://example.com/user-profile.schema.json",
            "$schema": "http://json-schema.org/draft-07/schema#",
            "description": "A representation of a user profile",
            "type": "object",
            "required": ["username", "email"],
            "properties": {
              "username": {
                "type": "string"
              },
              "email": {
                "type": "string",
                "format": "email"
              },
              "fullName": {
                "type": "string"
              },
              "age": {
                "type": "integer",
                "minimum": 0
              },
              "location": {
                "type": "string"
              },
              "interests": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "schema": {
          "$id": "https://example.com/user-profile.schema.json",
          "$schema": "http://json-schema.org/draft-07/schema#",
          "description": "A representation of a user profile",
          "type": "object",
          "required": ["username", "email"],
          "properties": {
            "username": {
              "type": "string"
            },
            "email": {
              "type": "string",
              "format": "email"
            },
            "fullName": {
              "type": "string"
            },
            "age": {
              "type": "integer",
              "minimum": 0
            },
            "location": {
              "type": "string"
            },
            "interests": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    {
      "servers": {
        "apache-kafka-v1": {
          "host": "https://kaas.lo/apache-kafka-v1",
          "protocol": "kafka"
        },
        "apache-kafka-v2": {
          "$ref": "https://catalog.lo/servers/apache-kafka-v2"
        }
      }
    },
    {
      "serverVariables": {
        "rabbitmq-ports-v1": {
          "enum": [
            "5672",
            "5671"
          ]
        },
        "rabbitmq-ports-v2": {
          "$ref": "https://catalog.lo/servers/rabbitmq-v2/variables/ports"
        }
      }
    },
    {
      "channels": {
        "user-notifications-v1": {
          "address": "users.notifications.{userId}",
          "title": "User notifications"
        },
        "user-notifications-v2": {
          "$ref": "https://catalog.lo/servers/apache-kafka-v2/topics/user-notifications"
        }
      }
    },
    {
      "operations": {
        "notify-user-signed-up-v1": {
          "action": "send",
          "channel": {
            "$ref": "#/components/channels/user-notifications-v1"
          }
        },
        "notify-user-signed-up-v2": {
          "$ref": "https://catalog.lo/servers/apache-kafka-v2/events/user-signed-up"
        }
      }
    },
    {
      "messages": {
        "user-signed-up-v1": {
          "contentType": "application/json",
          "name": "user-signed-up-v1",
          "deprecated": true
        },
        "user-signed-up-v2": {
          "$ref": "https://catalog.lo/servers/apache-kafka-v2/events/user-signed-up"
        }
      }
    },
    {
      "securitySchemes": {
        "apiKey": {
          "type": "apiKey",
          "in": "user"
        },
        "x.509": {
          "$ref": "#/components/securitySchemes/x.509"
        }
      }
    },
    {
      "parameters": {
        "accessToken": {
          "description": "User AccessToken",
          "examples": [ "Bearer eyJhbGciOiJIUzI1Ni..." ],
          "location": "$message.header#/authorization"
        },
        "userId": {
          "$ref": "https://catalog.lo/servers/apache-kafka-v2/headers/user-id"
        }
      }
    },
    {
      "correlationIds": {
        "correlation-id-v1": {
          "description": "Incoming message correlation-id",
          "location": "$message.payload#/correlation-id"
        },
        "correlation-id-v2": {
          "$ref": "https://catalog.lo/servers/apache-kafka-v2/headers/correlation-id"
        }
      }
    },
    {
      "operationTraits": {
        "notify-user-signed-up-trait-v1": {
          "summary": "User signed up",
          "security": [
            {
              "type": "openIdConnect",
              "openIdConnectUrl": "https://server.com/.well-known/openid-configuration"
            }
          ]
        },
        "notify-user-signed-up-trait-v2": {
          "$ref": "https://catalog.lo/servers/apache-kafka-v2/events/user-signed-up-trait"
        }
      }
    },
    {
      "messageTraits": {
        "user-signed-up-trait-v1": {
          "contentType": "application/json",
          "name": "user-signed-up-v1",
          "correlationId": {
            "description": "Incoming message correlation-id",
            "location": "$message.payload#/correlation-id"
          },
          "deprecated": true
