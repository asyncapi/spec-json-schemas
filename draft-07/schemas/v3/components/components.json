          }
        }
      }
    },
    {
      "channelBindings": {
        "v1": {
          "kafka": {
            "bindingVersion": "0.5.0",
            "partitions": 20,
            "replicas": 3,
            "topic": "my-specific-topic",
            "topicConfiguration": {
              "cleanup.policy": [ "compact", "delete" ],
              "delete.retention.ms": 1000,
              "max.message.bytes": 2000,
              "retention.bytes": 10,
              "retention.ms": 2000,
              "confluent.key.schema.validation": true,
              "confluent.key.subject.name.strategy": "schema",
              "confluent.value.schema.validation": true,
              "confluent.value.subject.name.strategy": "schema"
            }
          },
          "pulsar": {
            "bindingVersion": "0.1.0",
            "compaction": 1000,
            "deduplication": true,
            "geo-replication": [ "us-west", "us-east" ],
            "namespace": "ns1",
            "persistence": "persistent",
            "retention": {
              "size": 1000,
              "time": 15
            },
            "ttl": 360
          }
        },
        "v2": {
          "kafka": {
            "$ref": "https://catalog.lo/bindings/apache-kafka-v2/channel"
          },
          "pulsar": {
            "$ref": "https://catalog.lo/bindings/apache-pulsar-v2/channel"
          }
        }
      }
    },
    {
      "operationBindings": {
        "v1": {
          "kafka": {
            "bindingVersion": "0.5.0",
            "clientId": {
              "type": "string",
              "enum": [ "myClientId" ]
            },
            "groupId": {
              "type": "string",
              "enum": [ "myGroupId" ]
            }
          },
          "pulsar": {
            "bindingVersion": "0.1.0"
          }
        },
        "v2": {
          "kafka": {
            "$ref": "https://catalog.lo/bindings/apache-kafka-v2/operation"
          },
          "pulsar": {
            "$ref": "https://catalog.lo/bindings/apache-pulsar-v2/operation"
          }
        }
      }
    },
    {
      "messageBindings": {
        "v1": {
          "kafka": {
            "bindingVersion": "0.5.0",
            "key": {
              "type": "string",
              "enum": [ "myKey" ]
            },
            "schemaIdLocation": "header",
            "schemaIdPayloadEncoding": "apicurio-new",
            "schemaLookupStrategy": "TopicIdStrategy"
          },
          "pulsar": {
            "bindingVersion": "0.1.0"
          }
        },
        "v2": {
          "kafka": {
            "$ref": "https://catalog.lo/bindings/apache-kafka-v2/message"
          },
          "pulsar": {
            "$ref": "https://catalog.lo/bindings/apache-pulsar-v2/message"
          }
        }
      }
    },
