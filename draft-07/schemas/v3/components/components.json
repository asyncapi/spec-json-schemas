  "type": "object",
  "properties": {
    "schemas": {
      "description": "An object to hold reusable Schema Object. If this is a Schema Object, then the schemaFormat will be assumed to be 'application/vnd.aai.asyncapi+json;version=asyncapi' where the version is equal to the AsyncAPI Version String",
      "type": "object",
      "patternProperties": {
        "^[\\w\\d\\.\\-_]+$": {
          "$ref": "https://asyncapi.pavelon.dev/schemas/anySchema.json"
        }
      }
    },
    "servers": {
      "description": "An object to hold reusable Server Objects",
      "type": "object",
      "patternProperties": {
        "^[\\w\\d\\.\\-_]+$": {
          "if": {
            "required": [ "$ref" ],
            "properties": {
              "$ref": true
            }
          },
          "then": {
            "$ref": "https://asyncapi.pavelon.dev/schemas/reference.json"
          },
          "else": {
            "$ref": "https://asyncapi.pavelon.dev/schemas/v3/servers/server.json"
          }
        }
      }
    },
    "channels": {
      "description": "An object to hold reusable Channel Objects",
      "type": "object",
      "patternProperties": {
        "^[\\w\\d\\.\\-_]+$": {
          "if": {
            "required": [ "$ref" ],
            "properties": {
              "$ref": true
            }
          },
          "then": {
            "$ref": "https://asyncapi.pavelon.dev/schemas/reference.json"
          },
          "else": {
            "$ref": "https://asyncapi.pavelon.dev/schemas/v3/channels/channel.json"
          }
        }
      }
    },
    "serverVariables": {
      "description": "An object to hold reusable Server Variable Objects",
      "type": "object",
      "patternProperties": {
        "^[\\w\\d\\.\\-_]+$": {
          "if": {
            "required": [ "$ref" ],
            "properties": {
              "$ref": true
            }
          },
          "then": {
            "$ref": "https://asyncapi.pavelon.dev/schemas/reference.json"
          },
          "else": {
            "$ref": "https://asyncapi.pavelon.dev/schemas/v3/servers/serverVariable.json"
          }
        }
      }
    },
    "operations": {
      "type": "object",
      "patternProperties": {
        "^[\\w\\d\\.\\-_]+$": {
          "if": {
            "required": [ "$ref" ],
            "properties": {
              "$ref": true
            }
          },
          "then": {
            "$ref": "https://asyncapi.pavelon.dev/schemas/reference.json"
          },
          "else": {
            "$ref": "https://asyncapi.pavelon.dev/schemas/v3/operations/operation.json"
          }
        }
      }
    },
    "messages": {
      "description": "An object to hold reusable Message Objects",
      "type": "object",
      "patternProperties": {
        "^[\\w\\d\\.\\-_]+$": {
          "if": {
            "required": [ "$ref" ],
            "properties": {
              "$ref": true
            }
          },
          "then": {
            "$ref": "https://asyncapi.pavelon.dev/schemas/reference.json"
          },
          "else": {
            "$ref": "https://asyncapi.pavelon.dev/schemas/v3/channels/messages/channelMessage.json"
          }
        }
      }
    },
    "securitySchemes": {
      "description": "An object to hold reusable Security Scheme Objects",
      "type": "object",
      "patternProperties": {
        "^[\\w\\d\\.\\-_]+$": {
          "if": {
            "required": [ "$ref" ],
            "properties": {
              "$ref": true
            }
          },
          "then": {
            "$ref": "https://asyncapi.pavelon.dev/schemas/reference.json"
          },
          "else": {
            "$ref": "https://asyncapi.pavelon.dev/schemas/v3/security/securitySchema.json"
          }
        }
      }
    },
    "parameters": {
      "description": "An object to hold reusable Parameter Objects",
      "type": "object",
      "patternProperties": {
        "^[\\w\\d\\.\\-_]+$": {
          "if": {
            "required": [ "$ref" ],
            "properties": {
              "$ref": true
            }
          },
          "then": {
            "$ref": "https://asyncapi.pavelon.dev/schemas/reference.json"
          },
          "else": {
            "$ref": "https://asyncapi.pavelon.dev/schemas/v3/channels/channelAddressParameter.json"
          }
        }
      }
    },
    "correlationIds": {
      "description": "An object to hold reusable Correlation ID Objects",
      "type": "object",
      "patternProperties": {
        "^[\\w\\d\\.\\-_]+$": {
          "if": {
            "required": [ "$ref" ],
