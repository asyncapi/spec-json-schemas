{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://asyncapi.pavelon.dev/schemas/v3/channels/channelAddressParameters.json",
  "title": "AsyncAPI v3 - Channel Address Parameters Map",
  "description": "A key-value map where key is parameter ID and value is parameter representation",
  "examples": [
    {
      "timezone": {
        "$ref": "#/parameters/time-zone"
      }
    },
    {
      "user-id": {
        "description": "Id of the user",
        "default": "0e822ca6-5311-4d4c-b409-993a1820e689",
        "enum": [
          "0e822ca6-5311-4d4c-b409-993a1820e689",
          "381f5ddc-75c6-4c21-9ec1-3919ed345be9",
          "70559d88-31a5-4ef2-8c34-7fbd04057ed5",
          "c6dc0047-a90d-4efa-95e3-a272282934e0"
        ],
        "location": "$message.payload#/user/id"
      }
    },
    {
      "accessToken": {
        "description": "User AccessToken",
        "examples": [ "Bearer eyJhbGciOiJIUzI1Ni..." ],
        "location": "$message.header#/authorization"
      }
    }
  ],
  "type": "object",
  "additionalProperties": {
    "if": {
      "required": [ "$ref" ],
      "properties": {
        "$ref": true
      }
    },
    "then": {
      "$ref": "https://asyncapi.pavelon.dev/schemas/reference.json"
    },
    "else": {
      "$ref": "https://asyncapi.pavelon.dev/schemas/v3/channels/channelAddressParameter.json"
    }
  }
}
