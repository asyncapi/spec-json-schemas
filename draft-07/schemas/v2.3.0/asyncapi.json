{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "http://localhost:8080/draft-07/schemas/v2.3.0/asyncapi.json",
  "title": "AsyncAPI v2.3.0",
  "description": "AsyncAPI 2.3.0 JSON Schema",
  "examples": [
    {
      "asyncapi": "2.3.0",
      "info": {
        "title": "MQTT 5.0 example",
        "version": "1.0.0"
      },
      "channels": []
    }
  ],
  "type": "object",
  "required": [ "asyncapi", "info", "channels" ],
  "properties": {
    "asyncapi": {
      "description": "The AsyncAPI specification version of this document.",
      "type": "string",
      "const": "2.3.0"
    },
    "id": {
      "description": "A unique id representing the application.",
      "type": "string",
      "format": "uri"
    },
    "info": {
      "$ref": "http://localhost:8080/draft-07/schemas/v2/info/info.json"
    },
    "servers": {
      "$ref": "http://localhost:8080/draft-07/schemas/v2.3.0/servers/servers.json"
    },
    "defaultContentType": {
      "type": "string"
    },
    "channels": {
      "$ref": "http://localhost:8080/draft-07/schemas/v2.3.0/channels/channels.json"
    },
    "components": {
      "$ref": "http://localhost:8080/draft-07/schemas/v2.3.0/components/components.json"
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "http://localhost:8080/draft-07/schemas/v2/tag.json"
      }
    },
    "externalDocs": {
      "$ref": "http://localhost:8080/draft-07/schemas/v2/externalDocs.json"
    }
  },
  "patternProperties": {
    "^x-[\\w\\d\\.\\x2d_]+$": true
  },
  "additionalProperties": false
}
