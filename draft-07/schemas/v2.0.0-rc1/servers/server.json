{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "http://localhost:8080/draft-07/schemas/v2.0.0-rc1/servers/server.json",
  "title": "AsyncAPI v2.0.0-rc1 - Server",
  "description": "Represents a message broker, a server or any other kind of computer program capable of sending and/or receiving data",
  "type": "object",
  "required": [ "url", "protocol" ],
  "properties": {
    "url": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "protocol": {
      "description": "The transfer protocol.",
      "type": "string"
    },
    "protocolVersion": {
      "type": "string"
    },
    "variables": {
      "$ref": "http://localhost:8080/draft-07/schemas/v2.0.0-rc1/servers/serverVariables.json"
    },
    "baseChannel": {
      "x-format": "uri-path",
      "type": "string"
    },
    "security": {
      "type": "array",
      "items": {
        "$ref": "http://localhost:8080/draft-07/schemas/v2/securityRequirements.json"
      }
    }
  },
  "patternProperties": {
    "^x-[\\w\\d\\.\\x2d_]+$": true
  },
  "additionalProperties": false
}
