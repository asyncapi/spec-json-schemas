{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "http://localhost:8000/draft-07/schemas/v2.0.0-rc1/xml.json",
  "title": "AsyncAPI v2 - XML Schema",
  "description": "The XML Schema Object allows the definition of input and output data types. These types can be objects, but also primitives and arrays",
  "examples": [
    {},
    {
      "name": "book",
      "namespace": "catalog"
    }
  ],
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "namespace": {
      "type": "string"
    },
    "prefix": {
      "type": "string"
    },
    "attribute": {
      "default": false,
      "type": "boolean"
    },
    "wrapped": {
      "default": false,
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
