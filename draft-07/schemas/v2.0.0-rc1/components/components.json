{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "http://localhost:8000/draft-07/schemas/v2.0.0-rc1/components/components.json",
  "description": "An object to hold a set of reusable objects for different aspects of the AsyncAPI Specification",
  "type": "object",
  "properties": {
    "schemas": {
      "$ref": "http://localhost:8000/draft-07/schemas/v2.0.0-rc1/schemas.json"
    },
    "messages": {
      "$ref": "http://localhost:8000/draft-07/schemas/v2.0.0-rc1/channels/messages/messages.json"
    },
    "securitySchemes": {
      "type": "object",
      "patternProperties": {
        "^[\\w\\d\\.\\-_]+$": {
          "oneOf": [
            {
              "$ref": "http://localhost:8000/draft-07/schemas/reference.json"
            },
            {
              "$ref": "http://localhost:8000/draft-07/schemas/v2.0.0-rc1/security/securitySchema.json"
            }
          ]
        }
      }
    },
    "parameters": {
      "$ref": "http://localhost:8000/draft-07/schemas/v2.0.0-rc1/channels/parameters.json"
    },
    "correlationIds": {
      "type": "object",
      "patternProperties": {
        "^[\\w\\d\\.\\-_]+$": {
          "oneOf": [
            {
              "$ref": "http://localhost:8000/draft-07/schemas/reference.json"
            },
            {
              "$ref": "http://localhost:8000/draft-07/schemas/v2.0.0-rc1/channels/messages/correlationId.json"
            }
          ]
        }
      }
    },
    "traits": {
      "$ref": "http://localhost:8000/draft-07/schemas/v2.0.0-rc1/traits.json"
    }
  },
  "additionalProperties": false
}
