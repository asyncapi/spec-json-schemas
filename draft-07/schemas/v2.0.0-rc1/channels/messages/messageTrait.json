{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "http://localhost:8000/draft-07/schemas/v2.0.0-rc1/channels/messages/messageTrait.json",
  "title": "AsyncAPI v2.0.0-rc1 - Channel Operation Message Trait",
  "description": "Describes a trait that MAY be applied to an Channel Operation Message",
  "type": "object",
  "examples": [
    {},
    {
      "name": "UserSignup Trait",
      "title": "User signup Trait",
      "summary": "Action to sign a user up",
      "contentType": "application/json"
    }
  ],
  "properties": {
    "schemaFormat": {
      "type": "string"
    },
    "contentType": {
      "type": "string"
    },
    "headers": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "$ref": "http://localhost:8000/draft-07/schemas/reference.json"
          },
          {
            "$ref": "http://localhost:8000/draft-07/schemas/v2.0.0-rc1/schema.json"
          }
        ]
      }
    },
    "correlationId": {
      "oneOf": [
        {
          "$ref": "http://localhost:8000/draft-07/schemas/reference.json"
        },
        {
          "$ref": "http://localhost:8000/draft-07/schemas/v2.0.0-rc1/channels/messages/correlationId.json"
        }
      ]
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "http://localhost:8000/draft-07/schemas/v2/tag.json"
      }
    },
    "summary": {
      "description": "A brief summary of the message",
      "type": "string"
    },
    "name": {
      "description": "Name of the message",
      "type": "string"
    },
    "title": {
      "description": "A human-friendly title for the message",
      "type": "string"
    },
    "description": {
      "description": "A longer description of the message. CommonMark is allowed",
      "type": "string"
    },
    "externalDocs": {
      "$ref": "http://localhost:8000/draft-07/schemas/v2/externalDocs.json"
    },
    "deprecated": {
      "default": false,
      "type": "boolean"
    },
    "examples": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "protocolInfo": {
      "type": "object",
      "additionalProperties": {
        "type": "object"
      }
    }
  },
  "patternProperties": {
    "^x-[\\w\\d\\.\\x2d_]+$": true
  },
  "additionalProperties": false
}
