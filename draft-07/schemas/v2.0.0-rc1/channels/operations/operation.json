{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "http://localhost:8000/draft-07/schemas/v2.0.0-rc1/channels/operations/operation.json",
  "title": "AsyncAPI v2.0.0-rc1 - Channel Operation",
  "description": "Describes a publish or a subscribe operation. This provides a place to document how and why messages are sent and received",
  "type": "object",
  "properties": {
    "traits": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "http://localhost:8000/draft-07/schemas/reference.json"
          },
          {
            "$ref": "http://localhost:8000/draft-07/schemas/v2.0.0-rc1/channels/operations/operationTrait.json"
          }
        ]
      }
    },
    "summary": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "http://localhost:8000/draft-07/schemas/v2/tag.json"
      }
    },
    "externalDocs": {
      "$ref": "http://localhost:8000/draft-07/schemas/v2/externalDocs.json"
    },
    "operationId": {
      "type": "string"
    },
    "protocolInfo": {
      "type": "object",
      "additionalProperties": {
        "type": "object"
      }
    },
    "message": {
      "oneOf": [
        {
          "$ref": "http://localhost:8000/draft-07/schemas/v2.0.0-rc1/channels/messages/message.json"
        },
        {
          "type": "object",
          "required": [ "oneOf" ],
          "properties": {
            "oneOf": {
              "type": "array",
              "minItems": 2,
              "items": {
                "$ref": "http://localhost:8000/draft-07/schemas/v2.0.0-rc1/channels/messages/message.json"
              }
            }
          },
          "patternProperties": {
            "^x-[\\w\\d\\.\\x2d_]+$": true
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "patternProperties": {
    "^x-[\\w\\d\\.\\x2d_]+$": true
  },
  "additionalProperties": false
}
