{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "http://localhost:8080/draft-07/schemas/v2.0.0-rc1/channels/operations/operationTrait.json",
  "title": "AsyncAPI v2.0.0-rc1 - Channel Operation Trait",
  "description": "Describes a trait that MAY be applied to an Channel Operation",
  "type": "object",
  "properties": {
    "summary": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "http://localhost:8080/draft-07/schemas/v2/tag.json"
      }
    },
    "externalDocs": {
      "$ref": "http://localhost:8080/draft-07/schemas/v2/externalDocs.json"
    },
    "operationId": {
      "type": "string"
    },
    "protocolInfo": {
      "type": "object",
      "additionalProperties": {
        "type": "object"
      }
    }
  },
  "patternProperties": {
    "^x-[\\w\\d\\.\\x2d_]+$": true
  },
