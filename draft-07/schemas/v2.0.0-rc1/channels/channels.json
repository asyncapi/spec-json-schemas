{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "http://localhost:8000/draft-07/schemas/v2.0.0-rc1/channels/channels.json",
  "title": "AsyncAPI v2.0.0-rc1 - Channels Map",
  "description": "A key-value map where key is channel ID and value is channel representation. Channel paths are relative to servers",
  "examples": [
    {
      "user/{userId}/sendMessage": {
        "subscribe": {
          "operationId": "sendMessage",
          "summary": "Send message",
          "description": "Send message to remote server"
        },
        "parameters": {
          "userId": {
            "description": "Id of the user",
            "schema": {
              "type": "string"
            }
          }
        }
      }
    }
  ],
  "type": "object",
  "propertyNames": {
    "format": "uri-template",
    "minLength": 1
  },
  "additionalProperties": {
    "$ref": "http://localhost:8000/draft-07/schemas/v2.0.0-rc1/channels/channelItem.json"
  }
}
