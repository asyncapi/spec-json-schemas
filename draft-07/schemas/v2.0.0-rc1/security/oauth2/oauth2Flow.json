{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "http://localhost:8000/draft-07/schemas/v2.0.0-rc1/security/oauth2/oauth2Flow.json",
  "title": "AsyncAPI v2.0.0-rc1 - OAuth2 Authorization flow",
  "description": "Contains information about OAuth2 Authorization flow",
  "type": "object",
  "examples": [
    {
      "authorizationUrl": "https://example.com/api/oauth/dialog",
      "tokenUrl": "https://example.com/api/oauth/token",
      "refreshUrl": "https://example.com/api/oauth/refresh",
      "scopes": {
        "write:pets": "modify pets in your account",
        "read:pets": "read your pets"
      }
    }
  ],
  "properties": {
    "authorizationUrl": {
      "type": "string",
      "format": "uri"
    },
    "tokenUrl": {
      "type": "string",
      "format": "uri"
    },
    "refreshUrl": {
      "type": "string",
      "format": "uri"
    },
    "scopes": {
      "$ref": "http://localhost:8000/draft-07/schemas/v2.0.0-rc1/security/oauth2/oauth2Scopes.json"
    }
  },
  "patternProperties": {
    "^x-[\\w\\d\\.\\x2d_]+$": true
  },
  "additionalProperties": false
}
