{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "http://localhost:8080/draft-07/schemas/v2.0.0-rc1/security/openIdConnect.json",
  "title": "AsyncAPI v2.0.0-rc1 - OpenID Connect Authentication",
  "description": "Contains information about OpenID Connect Authentication",
  "type": "object",
  "required": [ "type", "openIdConnectUrl" ],
  "properties": {
    "type": {
      "type": "string",
      "enum": [ "openIdConnect" ]
    },
    "description": {
      "type": "string"
    },
    "openIdConnectUrl": {
      "type": "string",
      "format": "uri"
    }
  },
  "patternProperties": {
    "^x-[\\w\\d\\.\\x2d_]+$": true
  },
  "additionalProperties": false
}
