{
  "$id": "https://example.com/regex-pattern.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema",
  "title": "Representation of regular expression pattern using JSON Schema dictionary",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "pattern": "^[A-Z]{3}-\\d{3}$"
    }
  }
}