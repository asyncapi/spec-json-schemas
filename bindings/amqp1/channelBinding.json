{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://asyncapi.pavelon.dev/bindings/amqp1/channelBinding.json",
  "title": "AMQP 1.0 - Channel Binding",
  "description": "Describes protocol-specific definitions for a channel",
  "examples": [
    {},
    {
      "bindingVersion": "latest"
    },
    {
      "bindingVersion": "0.1.0"
    }
  ],
  "type": "object",
  "allOf": [
    {
      "if": {
        "required": [ "bindingVersion" ],
        "properties": {
          "bindingVersion": {
            "const": "0.1.0"
          }
        }
      },
      "then": {
        "$ref": "https://asyncapi.pavelon.dev/bindings/amqp1/0.1.0/channel.json"
      }
    },
    {
      "description": "If bindingVersion is omitted, than use latest JSON Schema",
      "if": {
        "not": {
          "required": [ "bindingVersion" ],
          "properties": {
            "bindingVersion": {
              "const": "0.1.0"
            }
          }
        }
      },
      "then": {
        "$ref": "https://asyncapi.pavelon.dev/bindings/amqp1/0.1.0/channel.json"
      }
    }
  ]
}
