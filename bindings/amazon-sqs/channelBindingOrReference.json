{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://asyncapi.pavelon.dev/bindings/amazon-sqs/channelBindingOrReference.json",
  "title": "Amazon SQS - Channel Binding or Reference",
  "description": "Describes protocol-specific definitions for a channel or it's reference",
  "examples": [
    {
      "$ref": "#/bindings/amazon-sqs/my-sqs-queue"
    },
    {
      "queue": {
        "fifoQueue": true,
        "name": "my-sqs-queue"
      },
      "deadLetterQueue": {
        "fifoQueue": true,
        "deliveryDelay": 0,
        "messageRetentionPeriod": 604800,
        "name": "my-sqs-queue.dlq",
        "receiveMessageWaitTime": 0,
        "visibilityTimeout": 0
      },
      "bindingVersion": "0.3.0"
    }
  ],
  "type": "object",
  "if": {
    "required": [ "$ref" ],
    "properties": {
      "$ref": true
    }
  },
  "then": {
    "$ref": "https://asyncapi.pavelon.dev/schemas/reference.json"
  },
  "else": {
    "$ref": "https://asyncapi.pavelon.dev/bindings/amazon-sqs/channelBinding.json"
  }
}
