{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://asyncapi.pavelon.dev/bindings/mqtt/operationBindingOrReference.json",
  "title": "MQTT - Operation Binding or Reference",
  "description": "Describes protocol-specific definitions for a operation or it's reference",
  "examples": [
    {
      "$ref": "#/bindings/mqtt/my-mqtt-operation"
    },
    {
      "bindingVersion": "0.2.0",
      "messageExpiryInterval": 60,
      "qos": 2,
      "retain": true
    }
  ],
  "type": "object",
  "if": {
    "required": [ "$ref" ],
    "properties": {
      "$ref": true
    }
  },
  "then": {
    "$ref": "https://asyncapi.pavelon.dev/schemas/reference.json"
  },
  "else": {
    "$ref": "https://asyncapi.pavelon.dev/bindings/mqtt/operationBinding.json"
  }
}
