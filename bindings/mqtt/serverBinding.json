{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://asyncapi.pavelon.dev/bindings/mqtt/serverBinding.json",
  "title": "MQTT - Server Binding",
  "description": "Describes protocol-specific definitions for a server",
  "examples": [
    {
      "bindingVersion": "0.1.0",
      "cleanSession": true,
      "clientId": "guest",
      "keepAlive": 60,
      "lastWill": {
        "message": "Guest gone offline.",
        "qos": 2,
        "retain": false,
        "topic": "/last-wills"
      }
    },
    {
      "bindingVersion": "0.2.0",
      "cleanSession": true,
      "clientId": "guest",
      "keepAlive": 60,
      "lastWill": {
        "message": "Guest gone offline.",
        "qos": 2,
        "retain": false,
        "topic": "/last-wills"
      },
      "maximumPacketSize": {
        "type": "integer",
        "minimum": 1
      },
      "sessionExpiryInterval": {
        "type": "integer",
        "minimum": 0
      }
    }
  ],
  "type": "object",
  "allOf": [
    {
      "if": {
        "required": [ "bindingVersion" ],
        "properties": {
          "bindingVersion": {
            "const": "0.1.0"
          }
        }
      },
      "then": {
        "$ref": "https://asyncapi.pavelon.dev/bindings/mqtt/0.1.0/server.json"
      }
    },
    {
      "if": {
        "required": [ "bindingVersion" ],
        "properties": {
          "bindingVersion": {
            "const": "0.2.0"
          }
        }
      },
      "then": {
        "$ref": "https://asyncapi.pavelon.dev/bindings/mqtt/0.2.0/server.json"
      }
    },
    {
      "description": "If bindingVersion is omitted, than use latest JSON Schema",
      "if": {
        "not": {
          "required": [ "bindingVersion" ],
          "properties": {
            "bindingVersion": {
              "enum": [ "0.1.0", "0.2.0" ]
            }
          }
        }
      },
      "then": {
        "$ref": "https://asyncapi.pavelon.dev/bindings/mqtt/0.2.0/server.json"
      }
    }
  ]
}
