{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://asyncapi.pavelon.dev/bindings/amqp/channelBinding.json",
  "title": "AMQP 0-9-1 - Channel Binding",
  "description": "Describes protocol-specific definitions for a channel",
  "examples": [
    {
      "bindingVersion": "0.1.0",
      "exchange": {
        "type": "direct",
        "autoDelete": false,
        "durable": true,
        "name": "myExchange"
      },
      "is": "routingKey"
    },
    {
      "bindingVersion": "0.2.0",
      "is": "queue",
      "queue": {
        "autoDelete": false,
        "durable": true,
        "exclusive": true,
        "name": "my-queue-name",
        "vhost": "/"
      }
    },
    {
      "bindingVersion": "0.3.0",
      "exchange": {
        "type": "fanout",
        "autoDelete": false,
        "durable": true,
        "name": "myExchange",
        "vhost": "/"
      },
      "is": "routingKey"
    },
    {
      "exchange": {
        "type": "fanout",
        "autoDelete": false,
        "durable": true,
        "name": "myExchange",
        "vhost": "/"
      },
      "is": "routingKey"
    }
  ],
  "type": "object",
  "allOf": [
    {
      "if": {
        "required": [ "bindingVersion" ],
        "properties": {
          "bindingVersion": {
            "const": "0.1.0"
          }
        }
      },
      "then": {
        "$ref": "https://asyncapi.pavelon.dev/bindings/amqp/0.1.0/channel.json"
      }
    },
    {
      "if": {
        "required": [ "bindingVersion" ],
        "properties": {
          "bindingVersion": {
            "const": "0.2.0"
          }
        }
      },
      "then": {
        "$ref": "https://asyncapi.pavelon.dev/bindings/amqp/0.2.0/channel.json"
      }
    },
    {
      "if": {
        "required": [ "bindingVersion" ],
        "properties": {
          "bindingVersion": {
            "const": "0.3.0"
          }
        }
      },
      "then": {
        "$ref": "https://asyncapi.pavelon.dev/bindings/amqp/0.3.0/channel.json"
      }
    },
    {
      "description": "If bindingVersion is omitted, than use latest JSON Schema",
      "if": {
        "not": {
          "required": [ "bindingVersion" ],
          "properties": {
            "bindingVersion": {
              "enum": [ "0.1.0", "0.2.0", "0.3.0" ]
            }
          }
        }
      },
      "then": {
        "$ref": "https://asyncapi.pavelon.dev/bindings/amqp/0.3.0/channel.json"
      }
    }
  ]
}
