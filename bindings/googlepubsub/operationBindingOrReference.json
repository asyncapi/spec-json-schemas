{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://asyncapi.pavelon.dev/bindings/googlepubsub/operationBindingOrReference.json",
  "title": "Mercure - Operation Binding or Reference",
  "description": "Describes protocol-specific definitions for a operation or it's reference",
  "examples": [
    {
      "$ref": "#/bindings/googlepubsub/my-googlepubsub-operation"
    },
    {
      "bindingVersion": "0.2.0"
    }
  ],
  "type": "object",
  "if": {
    "required": [ "$ref" ],
    "properties": {
      "$ref": true
    }
  },
  "then": {
    "$ref": "https://asyncapi.pavelon.dev/schemas/reference.json"
  },
  "else": {
    "$ref": "https://asyncapi.pavelon.dev/bindings/googlepubsub/operationBinding.json"
  }
}
