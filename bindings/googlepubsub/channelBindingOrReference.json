{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://asyncapi.pavelon.dev/bindings/googlepubsub/channelBindingOrReference.json",
  "title": "Mercure - Channel Binding or Reference",
  "description": "Describes protocol-specific definitions for a channel or it's reference",
  "examples": [
    {
      "$ref": "#/bindings/googlepubsub/my-googlepubsub-queue"
    },
    {
      "labels": {
        "label1": "value1",
        "label2": "value2"
      },
      "messageRetentionDuration": "86400s",
      "messageStoragePolicy": {
        "allowedPersistenceRegions": [ "us-central1", "us-east1" ]
      },
      "schemaSettings": {
        "encoding": "json",
        "name": "projects/your-project-id/schemas/your-schema",
        "firstRevisionId": "1",
        "lastRevisionId": "2"
      },
      "bindingVersion": "0.2.0"
    }
  ],
  "type": "object",
  "if": {
    "required": [ "$ref" ],
    "properties": {
      "$ref": true
    }
  },
  "then": {
    "$ref": "https://asyncapi.pavelon.dev/schemas/reference.json"
  },
  "else": {
    "$ref": "https://asyncapi.pavelon.dev/bindings/googlepubsub/channelBinding.json"
  }
}
