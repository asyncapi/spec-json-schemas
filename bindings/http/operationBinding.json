{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://asyncapi.pavelon.dev/bindings/http/operationBinding.json",
  "title": "HTTP - Operation Binding",
  "description": "Describes protocol-specific definitions for a operation",
  "examples": [
    {
      "type": "response",
      "bindingVersion": "0.1.0",
      "query": {
        "type": "object",
        "required": [ "companyId" ],
        "properties": {
          "companyId": {
            "description": "The Id of the company.",
            "type": "number",
            "minimum": 1
          }
        },
        "additionalProperties": false
      }
    },
    {
      "bindingVersion": "0.2.0",
      "query": {
        "type": "object",
        "required": [ "companyId" ],
        "properties": {
          "companyId": {
            "description": "The Id of the company.",
            "type": "number",
            "minimum": 1
          }
        },
        "additionalProperties": false
      }
    },
    {
      "bindingVersion": "0.3.0",
      "method": "GET",
      "query": {
        "type": "object",
        "required": [ "companyId" ],
        "properties": {
          "companyId": {
            "description": "The Id of the company.",
            "type": "number",
            "minimum": 1
          }
        },
        "additionalProperties": false
      }
    }
  ],
  "type": "object",
  "allOf": [
    {
      "if": {
        "required": [ "bindingVersion" ],
        "properties": {
          "bindingVersion": {
            "const": "0.1.0"
          }
        }
      },
      "then": {
        "$ref": "https://asyncapi.pavelon.dev/bindings/http/0.1.0/operation.json"
      }
    },
    {
      "if": {
        "required": [ "bindingVersion" ],
        "properties": {
          "bindingVersion": {
            "const": "0.2.0"
          }
        }
      },
      "then": {
        "$ref": "https://asyncapi.pavelon.dev/bindings/http/0.2.0/operation.json"
      }
    },
    {
      "if": {
        "required": [ "bindingVersion" ],
        "properties": {
          "bindingVersion": {
            "const": "0.3.0"
          }
        }
      },
      "then": {
        "$ref": "https://asyncapi.pavelon.dev/bindings/http/0.3.0/operation.json"
      }
    },
    {
      "description": "If bindingVersion is omitted, than use latest JSON Schema",
      "if": {
        "not": {
          "required": [ "bindingVersion" ],
          "properties": {
            "bindingVersion": {
              "enum": [ "0.1.0", "0.2.0", "0.3.0" ]
            }
          }
        }
      },
      "then": {
        "$ref": "https://asyncapi.pavelon.dev/bindings/http/0.3.0/operation.json"
      }
    }
  ]
}
