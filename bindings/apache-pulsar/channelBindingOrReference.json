{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://asyncapi.pavelon.dev/bindings/apache-pulsar/channelBindingOrReference.json",
  "title": "Apache Pulsar - Channel Binding or Reference",
  "description": "Describes protocol-specific definitions for a channel or it's reference",
  "examples": [
    {
      "$ref": "#/bindings/apache-pulsar/my-apache-pulsar-queue"
    },
    {
      "bindingVersion": "0.1.0",
      "compaction": 1000,
      "deduplication": true,
      "geo-replication": [ "us-west", "us-east" ],
      "namespace": "ns1",
      "persistence": "persistent",
      "retention": {
        "size": 1000,
        "time": 15
      },
      "ttl": 360
    }
  ],
  "type": "object",
  "if": {
    "required": [ "$ref" ],
    "properties": {
      "$ref": true
    }
  },
  "then": {
    "$ref": "https://asyncapi.pavelon.dev/schemas/reference.json"
  },
  "else": {
    "$ref": "https://asyncapi.pavelon.dev/bindings/apache-pulsar/channelBinding.json"
  }
}
