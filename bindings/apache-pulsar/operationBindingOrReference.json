{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://asyncapi.pavelon.dev/bindings/apache-pulsar/operationBindingOrReference.json",
  "title": "Apache Pulsar - Operation Binding or Reference",
  "description": "Describes protocol-specific definitions for a operation or it's reference",
  "examples": [
    {
      "$ref": "#/bindings/apache-pulsar/my-apache-pulsar-operation"
    },
    {
      "bindingVersion": "0.1.0"
    }
  ],
  "type": "object",
  "if": {
    "required": [ "$ref" ],
    "properties": {
      "$ref": true
    }
  },
  "then": {
    "$ref": "https://asyncapi.pavelon.dev/schemas/reference.json"
  },
  "else": {
    "$ref": "https://asyncapi.pavelon.dev/bindings/apache-pulsar/operationBinding.json"
  }
}
