{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://asyncapi.pavelon.dev/bindings/apache-pulsar/channelBinding.json",
  "title": "Apache Pulsar - Channel Binding",
  "description": "Describes protocol-specific definitions for a channel",
  "examples": [
    {
      "bindingVersion": "0.1.0",
      "compaction": 1000,
      "deduplication": true,
      "geo-replication": [ "us-west", "us-east" ],
      "namespace": "ns1",
      "persistence": "persistent",
      "retention": {
        "size": 1000,
        "time": 15
      },
      "ttl": 360
    }
  ],
  "type": "object",
  "allOf": [
    {
      "if": {
        "required": [ "bindingVersion" ],
        "properties": {
          "bindingVersion": {
            "const": "0.1.0"
          }
        }
      },
      "then": {
        "$ref": "https://asyncapi.pavelon.dev/bindings/apache-pulsar/0.1.0/channel.json"
      }
    },
    {
      "description": "If bindingVersion is omitted, than use latest JSON Schema",
      "if": {
        "not": {
          "required": [ "bindingVersion" ],
          "properties": {
            "bindingVersion": {
              "const": "0.1.0"
            }
          }
        }
      },
      "then": {
        "$ref": "https://asyncapi.pavelon.dev/bindings/apache-pulsar/0.1.0/channel.json"
      }
    }
  ]
}
