{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://asyncapi.pavelon.dev/bindings/ibmmq/channelBindingOrReference.json",
  "title": "IBM MQ - Channel Binding or Reference",
  "description": "Describes protocol-specific definitions for a channel or it's reference",
  "examples": [
    {
      "$ref": "#/bindings/ibmmq/my-ibmmq-queue"
    },
    {
      "bindingVersion": "0.1.0",
      "destinationType": "topic",
      "topic": {
        "durablePermitted": true,
        "lastMsgRetained": false,
        "objectName": "myTopicName",
        "string": "key"
      }
    }
  ],
  "type": "object",
  "if": {
    "required": [ "$ref" ],
    "properties": {
      "$ref": true
    }
  },
  "then": {
    "$ref": "https://asyncapi.pavelon.dev/schemas/reference.json"
  },
  "else": {
    "$ref": "https://asyncapi.pavelon.dev/bindings/ibmmq/channelBinding.json"
  }
}
