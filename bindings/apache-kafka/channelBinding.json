{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://asyncapi.pavelon.dev/bindings/apache-kafka/channelBinding.json",
  "title": "Apache Kafka - Channel Binding",
  "description": "Describes protocol-specific definitions for a channel",
  "examples": [
    {
      "bindingVersion": "0.1.0"
    },
    {
      "bindingVersion": "0.3.0",
      "partitions": 20,
      "replicas": 3,
      "topic": "my-specific-topic"
    },
    {
      "bindingVersion": "0.4.0",
      "partitions": 20,
      "replicas": 3,
      "topic": "my-specific-topic",
      "topicConfiguration": {
        "cleanup.policy": [ "compact", "delete" ],
        "delete.retention.ms": 1000,
        "max.message.bytes": 2000,
        "retention.bytes": 10,
        "retention.ms": 2000
      }
    },
    {
      "bindingVersion": "0.5.0",
      "partitions": 20,
      "replicas": 3,
      "topic": "my-specific-topic",
      "topicConfiguration": {
        "cleanup.policy": [ "compact", "delete" ],
        "delete.retention.ms": 1000,
        "max.message.bytes": 2000,
        "retention.bytes": 10,
        "retention.ms": 2000,
        "confluent.key.schema.validation": true,
        "confluent.key.subject.name.strategy": "schema",
        "confluent.value.schema.validation": true,
        "confluent.value.subject.name.strategy": "schema"
      }
    }
  ],
  "type": "object",
  "allOf": [
    {
      "if": {
        "required": [ "bindingVersion" ],
        "properties": {
          "bindingVersion": {
            "const": "0.1.0"
          }
        }
      },
      "then": {
        "$ref": "https://asyncapi.pavelon.dev/bindings/apache-kafka/0.1.0/channel.json"
      }
    },
    {
      "if": {
        "required": [ "bindingVersion" ],
        "properties": {
          "bindingVersion": {
            "const": "0.3.0"
          }
        }
      },
      "then": {
        "$ref": "https://asyncapi.pavelon.dev/bindings/apache-kafka/0.3.0/channel.json"
      }
    },
    {
      "if": {
        "required": [ "bindingVersion" ],
        "properties": {
          "bindingVersion": {
            "const": "0.4.0"
          }
        }
      },
      "then": {
        "$ref": "https://asyncapi.pavelon.dev/bindings/apache-kafka/0.4.0/channel.json"
      }
    },
    {
      "if": {
        "required": [ "bindingVersion" ],
        "properties": {
          "bindingVersion": {
            "const": "0.5.0"
          }
        }
      },
      "then": {
        "$ref": "https://asyncapi.pavelon.dev/bindings/apache-kafka/0.5.0/channel.json"
      }
    },
    {
      "description": "If bindingVersion is omitted, than use latest JSON Schema",
      "if": {
        "not": {
          "required": [ "bindingVersion" ],
          "properties": {
            "bindingVersion": {
              "enum": [ "0.1.0", "0.3.0", "0.4.0", "0.5.0" ]
            }
          }
        }
      },
      "then": {
        "$ref": "https://asyncapi.pavelon.dev/bindings/apache-kafka/0.5.0/channel.json"
      }
    }
  ]
}
