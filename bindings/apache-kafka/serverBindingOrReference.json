{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://asyncapi.pavelon.dev/bindings/apache-kafka/serverBindingOrReference.json",
  "title": "Apache Kafka - Server Binding or Reference",
  "description": "Describes protocol-specific definitions for a server or it's reference",
  "examples": [
    {
      "$ref": "#/bindings/apache-kafka/my-apache-kafka-server"
    },
    {
      "bindingVersion": "0.5.0",
      "schemaRegistryUrl": "https://my-schema-registry.com",
      "schemaRegistryVendor": "confluent"
    }
  ],
  "type": "object",
  "if": {
    "required": [ "$ref" ],
    "properties": {
      "$ref": true
    }
  },
  "then": {
    "$ref": "https://asyncapi.pavelon.dev/schemas/reference.json"
  },
  "else": {
    "$ref": "https://asyncapi.pavelon.dev/bindings/apache-kafka/serverBinding.json"
  }
}
