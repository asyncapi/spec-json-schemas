{
  "$id": "https://example.com/conditional-validation-if-else.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema",
  "title": "Representation of conditional validation with if-else using AsyncAPI Schema dictionary",
  "type": "object",
  "properties": {
    "isMember": {
      "type": "boolean"
    },
    "membershipNumber": {
      "type": "string"
    }
  },
  "required": [
    "isMember"
  ],
  "if": {
    "properties": {
      "isMember": {
        "const": true
      }
    }
  },
  "then": {
    "properties": {
      "membershipNumber": {
        "type": "string",
        "minLength": 10,
        "maxLength": 10
      }
    }
  },
  "else": {
    "properties": {
      "membershipNumber": {
        "type": "string",
        "minLength": 15
      }
    }
  },
  "externalDocs": {
    "url": "https://external-documentation.com",
    "description": "External Documentation description"
  },
  "discriminator": "discriminator value",
  "deprecated": false
}
